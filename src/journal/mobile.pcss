/* ─── App frame: banner · app · mobile nav, inside the device safe area ──────────────────────────
   index.html opts into viewport-fit=cover so an installed PWA paints edge to edge; the frame then
   pads itself by the safe-area insets so nothing sits under the notch, the status bar or the home
   indicator. env() resolves to 0 on desktop, so this is a no-op there. */
.mj_App_wrapper {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    padding: env(safe-area-inset-top, 0) env(safe-area-inset-right, 0) env(safe-area-inset-bottom, 0)
        env(safe-area-inset-left, 0);
}

/* Phones: the bottom inset is NOT padded here. The surface that owns the bottom edge (the composer inside a chat) pads itself by it once, so its own
   background runs under the home indicator instead of a bare band of frame colour, and the inset
   is not stacked on top of that surface's own padding. A screen with neither keeps the frame pad. */
@media (max-width: 700px) {
    .mj_App_wrapper:has(.mj_Composer) {
        padding-bottom: 0;
    }
}

.mj_App_wrapper > .mj_App {
    flex: 1 1 0;
    height: auto;
    min-height: 0;
}

/* ─── Connection banner (only while the connection is down) ─────────────────────────────────── */
.mj_ConnectionBanner {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--mj-space-2x);
    min-height: 32px;
    padding: 2px var(--mj-space-3x);
    border-bottom: 1px solid var(--mj-color-border-subtle);
    background: var(--mj-color-bg-subtle-secondary);
    color: var(--mj-color-text-primary);
    font: var(--mj-font-body-sm-regular);
}

.mj_ConnectionBanner_dot,
.mj_AccountStatus_dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mj-color-text-tertiary);
}

.mj_ConnectionBanner_offline .mj_ConnectionBanner_dot,
.mj_AccountStatus_offline .mj_AccountStatus_dot {
    background: var(--mj-color-text-critical-primary);
}

.mj_ConnectionBanner_connecting .mj_ConnectionBanner_dot,
.mj_AccountStatus_connecting .mj_AccountStatus_dot {
    background: var(--mj-needsyou);
}

.mj_AccountStatus_online .mj_AccountStatus_dot {
    background: var(--mj-color-text-action-accent);
}

.mj_ConnectionBanner_text {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_ConnectionBanner_action {
    flex: none;
    min-height: var(--mj-control-h-sm);
    padding: 0 var(--mj-space-3x);
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-pill);
    background: transparent;
    color: var(--mj-color-text-primary);
    font: var(--mj-font-label);
    font-weight: 600;
}

/* ─── Settings-menu connection status ───────────────────────────────────────────────────────── */
.mj_AccountStatus {
    display: flex;
    align-items: center;
    gap: var(--mj-space-2x);
    padding: var(--mj-space-1x) 0;
}

.mj_HeaderMenu .mj_AccountStatus_label {
    flex: 1 1 auto;
    color: var(--mj-color-text-primary);
}

.mj_HeaderMenu .mj_AccountStatus_reconnect {
    flex: none;
    min-height: var(--mj-control-h-sm);
    padding: 0 var(--mj-space-3x);
}

.mj_IconButton_badged {
    position: relative;
}

@media (max-width: 700px) {
    /* Same rule for the chat: the composer owns the bottom edge. */
    .mj_Composer_wrapper {
        padding-bottom: max(12px, calc(env(safe-area-inset-bottom, 0px) - 12px));
    }

    /* The rail provides tracker navigation on phones. */
    .mj_HeaderNavButton {
        display: none;
    }

    /* ─── Tap targets: 44px on the icon controls a thumb actually hits. Segmented tabs get 36px:
       a 44px pill does not fit title + three tabs + close at 360px (design-pass item). ─── */
    .mj_IconButton,
    .mj_Composer_button,
    .mj_Composer_sendMessage,
    .mj_TrackerComposer_send,
    .mj_FilesAction {
        width: var(--mj-control-h-touch);
        height: var(--mj-control-h-touch);
    }

    .mj_BackButton {
        left: 0;
    }

    .mj_ChatHeader {
        padding-inline-start: 46px;
    }

    .mj_TrackerBack {
        min-width: var(--mj-control-h-touch);
        min-height: var(--mj-control-h-touch);
    }

    /* No shift+enter on a touch keyboard; the "Jump to latest" notice still shows. */
    .mj_ComposerHint_shortcuts {
        visibility: hidden;
    }

    /* Tracker header: four tabs + close must fit 360px. The "Tracker" title yields its width
       (kept for screen readers, like .mj_ScreenReaderOnly), and the tab track may shrink, its
       segments ellipsizing rather than pushing the last tab out of the clipped header. */
    .mj_TrackerPane_top {
        padding: 0 var(--mj-space-2x);
    }
    .mj_TrackerPane_title {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        white-space: nowrap;
    }
    .mj_TrackerViewSwitch {
        flex: 0 1 auto;
        min-width: 0;
    }
}

/* The full-screen media viewer is a fixed overlay outside the padded app frame, so under
   viewport-fit=cover it must keep its own controls out of the notch / home-indicator areas. */
@media (max-width: 700px) {
    .mj_MediaViewer {
        padding: env(safe-area-inset-top, 0) env(safe-area-inset-right, 0) env(safe-area-inset-bottom, 0)
            env(safe-area-inset-left, 0);
    }
}
