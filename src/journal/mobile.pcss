/* ─── App frame: banner · app · mobile nav, inside the device safe area ──────────────────────────
   index.html opts into viewport-fit=cover so an installed PWA paints edge to edge; the frame then
   pads itself by the safe-area insets so nothing sits under the notch, the status bar or the home
   indicator. env() resolves to 0 on desktop, so this is a no-op there. */
.mx_MatrixChat_wrapper {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    padding: env(safe-area-inset-top, 0) env(safe-area-inset-right, 0) env(safe-area-inset-bottom, 0)
        env(safe-area-inset-left, 0);
}

.mx_MatrixChat_wrapper > .mx_MatrixChat {
    flex: 1 1 0;
    height: auto;
    min-height: 0;
}

/* ─── Connection banner (only while the connection is down) ─────────────────────────────────── */
.mj_ConnectionBanner {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--cpd-space-2x);
    min-height: 32px;
    padding: 2px var(--cpd-space-3x);
    border-bottom: 1px solid var(--cpd-color-border-subtle);
    background: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-text-primary);
    font: var(--cpd-font-body-sm-regular);
}

.mj_ConnectionBanner_dot,
.mj_AccountStatus_dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cpd-color-text-tertiary);
}

.mj_ConnectionBanner_offline .mj_ConnectionBanner_dot,
.mj_AccountStatus_offline .mj_AccountStatus_dot {
    background: var(--cpd-color-text-critical-primary);
}

.mj_ConnectionBanner_connecting .mj_ConnectionBanner_dot,
.mj_AccountStatus_connecting .mj_AccountStatus_dot {
    background: var(--mj-needsyou);
}

.mj_AccountStatus_online .mj_AccountStatus_dot {
    background: var(--cpd-color-text-action-accent);
}

.mj_ConnectionBanner_text {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_ConnectionBanner_action {
    flex: none;
    min-height: var(--mj-control-h-sm);
    padding: 0 var(--cpd-space-3x);
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    border-radius: var(--cpd-radius-pill);
    background: transparent;
    color: var(--cpd-color-text-primary);
    font: var(--cpd-font-label);
    font-weight: 600;
}

/* ─── Settings-menu connection status ───────────────────────────────────────────────────────── */
.mj_AccountStatus {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    padding: var(--cpd-space-1x) 0;
}

.mj_HeaderMenu .mj_AccountStatus_label {
    flex: 1 1 auto;
    color: var(--cpd-color-text-primary);
}

.mj_HeaderMenu .mj_AccountStatus_reconnect {
    flex: none;
    min-height: var(--mj-control-h-sm);
    padding: 0 var(--cpd-space-3x);
}

/* ─── Needs-you badge (header tracker button + mobile nav tab) ──────────────────────────────── */
.mj_IconButton_badged,
.mj_MobileNav_icon {
    position: relative;
}

.mj_NavBadge {
    position: absolute;
    top: -2px;
    right: -4px;
    box-sizing: border-box;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: var(--cpd-radius-pill);
    background: var(--mj-needsyou);
    color: #fff;
    font:
        600 10px/16px Inter,
        sans-serif;
    font-variant-numeric: tabular-nums;
    text-align: center;
    pointer-events: none;
}

/* ─── Mobile bottom nav — phone widths only ─────────────────────────────────────────────────── */
.mj_MobileNav {
    display: none;
}

@media (max-width: 700px) {
    .mj_MobileNav {
        display: flex;
        flex: none;
        border-top: 1px solid var(--cpd-color-border-subtle);
        background: var(--cpd-color-bg-canvas-default);
    }

    /* The on-screen keyboard is up: give its space to the field being typed in. */
    .mx_MatrixChat_wrapper:has(textarea:focus, input:focus) .mj_MobileNav {
        display: none;
    }

    .mj_MobileNav_tab {
        display: flex;
        flex: 1 1 0;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
        min-height: 52px;
        border: 0;
        background: transparent;
        color: var(--cpd-color-text-secondary);
        font:
            500 11px/14px Inter,
            sans-serif;
        -webkit-tap-highlight-color: transparent;
    }

    .mj_MobileNav_tab_active {
        color: var(--cpd-color-text-action-accent);
    }

    .mj_MobileNav_icon {
        display: inline-flex;
    }

    .mj_MobileNav_icon svg {
        width: 22px;
        height: 22px;
    }

    .mj_MobileNav_tab:focus-visible {
        outline: var(--mj-focus-ring);
        outline-offset: -4px;
    }

    /* Tracker + Files move from the crowded header to the bottom nav. */
    .mj_HeaderNavButton {
        display: none;
    }

    /* ─── Tap targets: 44px on the icon controls a thumb actually hits. Segmented tabs get 36px:
       a 44px pill does not fit title + three tabs + close at 360px (design-pass item). ─── */
    .mj_IconButton,
    .mx_MessageComposer_button,
    .mx_MessageComposer_sendMessage,
    .mj_FilesRow_action,
    .mj_FilesAction {
        width: var(--mj-control-h-touch);
        height: var(--mj-control-h-touch);
    }

    .mj_BackButton {
        left: 0;
    }

    .mj_ChatHeader {
        padding-inline-start: 46px;
    }

    .mj_TrackerBack {
        min-width: var(--mj-control-h-touch);
        min-height: var(--mj-control-h-touch);
    }

    /* No shift+enter on a touch keyboard; the "Jump to latest" notice still shows. */
    .mj_ComposerHint_shortcuts {
        visibility: hidden;
    }

    /* Tracker header: title + three tabs + close must fit 360px. */
    .mj_TrackerPane_top {
        padding: 0 var(--cpd-space-2x);
    }
}

/* The full-screen media viewer is a fixed overlay outside the padded app frame, so under
   viewport-fit=cover it must keep its own controls out of the notch / home-indicator areas. */
@media (max-width: 700px) {
    .mj_MediaViewer {
        padding: env(safe-area-inset-top, 0) env(safe-area-inset-right, 0) env(safe-area-inset-bottom, 0)
            env(safe-area-inset-left, 0);
    }
}
