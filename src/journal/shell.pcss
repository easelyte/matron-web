:root {
    /* v5: every agent content block (prose, tool card, diff card, code block, prompt
       card) shares this width so the column reads uniform. Operator override of the mock's
       680px cap — content is fluid: it fills the chat pane (minus the wrapper's equal
       L/R gutters) at any window size. */
    --mj-content-width: 100%;
    /* --- surfaces: unify step 1, Mac values --- */
    --mj-color-bg-accent: #0b6e7d;
    --mj-color-bg-accent-emphasis: #0c7e8f;
    --mj-color-bg-accent-tint: rgb(11 110 125 / 0.18);
    /* Mac TerminalStyle: tool output and diff bodies sit on one fixed dark block in BOTH themes. */
    --mj-color-terminal-bg: #1f1f1f;
    --mj-color-terminal-fg: #dbdbdb;
    --mj-color-terminal-add: #73d173;
    --mj-color-terminal-del: #e65959;
    --mj-color-terminal-muted: #8c8c8c;
    --mj-color-bg-canvas-default: #fff;
    /* Mac sidebar material, measured: darker than the chat canvas (the audit's biggest 'feel' gap). */
    --mj-color-bg-sidebar: #e6e4de;
    --mj-color-bg-canvas-raised: #f7f5f0;
    /* Mac MatronTimelineBackground: a two-stop warm gradient. `background` shorthand only. */
    --mj-color-bg-chat-canvas: linear-gradient(180deg, #f2f0ea 0%, #e8e5dc 100%);
    --mj-color-bg-scrim-drag: rgb(255 255 255 / 90%);
    --mj-color-bg-self-bubble: #c4f5fb;
    --mj-color-bg-subtle-primary: #eae8e3;
    --mj-color-bg-subtle-secondary: #e6e4de;
    --mj-color-bg-usage-track: rgb(28, 24, 20, 0.12);
    --mj-color-border-accent: rgb(11 110 125 / 0.25);
    --mj-color-border-disabled: #ded8ce;
    --mj-color-border-interactive-primary: #b3aa9c;
    --mj-color-border-interactive-secondary: #d8d1c5;
    --mj-color-border-subtle: #e7e2d9;
    --mj-color-border-strong: #d8d1c5;
    --mj-color-icon-accent-primary: #0b6e7d;
    --mj-color-icon-secondary: #6b655c;
    --mj-color-icon-tertiary: #9a938a;
    --mj-color-text-action-accent: #0b6e7d;
    --mj-color-text-critical-primary: #bd2020;
    /* Success ink for small text and glyphs (status green #34c759 is 2.1:1 on white). */
    --mj-color-text-success: #1e7a34;
    --mj-color-text-link-external: #0b6e7d;
    --mj-color-text-on-accent: #fff;
    --mj-color-text-placeholder: #9a938a;
    --mj-color-text-primary: #1b1815;
    --mj-color-text-secondary: #6b655c;
    --mj-color-text-tertiary: #9a938a;
    --mj-color-usage-high: #ff3b30;
    --mj-color-usage-low: #34c759;
    --mj-color-usage-medium: #ff9500;

    /* --- v2 interaction state layer (Radix 3/4/5 + M3 opacities) --- */
    /* Mac row hover is gray @ 0.08 in both themes. */
    --mj-state-hover: rgb(128 128 128 / 0.08);
    --mj-state-active: rgb(128 128 128 / 0.14);
    --mj-state-selected: rgb(11 110 125 / 0.1);

    /* §10.4 native chrome: selection and scrollbar thumbs,
       authored as accent-tint / neutral-ink values (mirrors the design's
       --m-selection / --m-scrollbar). Overridden per theme in [data-theme="dark"]. */
    --mj-selection: rgb(11 110 125 / 0.2);
    --mj-scrollbar: rgb(28 24 20 / 0.22);
    --mj-scrollbar-hover: rgb(28 24 20 / 0.34);
    /* Surface A/B design additions (2026-08): priority accent (peer-priority left edge +
       jump chip) and the pinned-summary raised-surface alias. See design-tokens.json. */
    --mj-priority-accent: #0d9488;
    /* Modal scrim — a fixed dark veil over content; identical in both themes so the media
       viewer / upload modal read the same regardless of canvas colour. */
    --mj-scrim-modal: rgb(18 16 14 / 55%);
    /* Destructive surface (Files-pane delete / overwrite confirm). No --cpd token exists for a
       critical BACKGROUND — only critical ink — so author the tint + border here, per theme, the
       same way --mj-selection / --mj-scrollbar are authored. Deliberately a tinted+outlined
       treatment rather than a solid red fill: the solid would need its own on-critical ink to stay
       readable in dark, where the critical token is a light #ff6a6a. */
    --mj-critical-tint: rgb(189 32 32 / 10%);
    --mj-critical-tint-strong: rgb(189 32 32 / 16%);
    --mj-critical-border: rgb(189 32 32 / 45%);

    /* --- v6 (docs/design/redesign-v6): amber "went wrong along the way", accent hairline,
       two named type roles, live-line timing, chat-pane breakpoints, layering. --- */
    /* Amber TEXT that clears 4.5:1 on canvas + raised; --mj-color-usage-medium is a fill (2.2:1 as text). */
    --mj-warn-ink: #9a5700;
    --mj-warn-tint: rgb(255 149 0 / 10%);
    --mj-accent-border: rgb(13 148 136 / 25%);

    /* --- Control scale (2026-09-26 polish). Every interactive control's box height comes from
       here, so controls that share a row share a height. Default 32: fields, selects, segmented
       tracks, toolbar and dialog buttons. sm 28: compact chips, in-row actions, sheet close
       buttons. lg 40: the page's one big action (sign in) and the tracker reply composer. touch
       44: phones, where --mj-control-h and --mj-control-h-lg both become the touch target (the
       max-width block below). Primitives live in controls.pcss; the drift test fails on an
       off-scale literal height. --- */
    /* A pane's sub-header bar (Files: the list's breadcrumb and the preview's name bar). Side-by-
       side panes share it so their hairlines run as one line across the split. */
    /* A segmented track insets its segments by this on every side (segment = control - 2×inset). */
    /* The selected segment's surface: raised above its track in both themes (operator call T5). */
    --mj-seg-on: var(--mj-color-bg-canvas-default);
    /* Menu rows (session actions, Settings, message actions): every row is [icon · label] on one
       grid, so the icon column and the icon-to-label gap are shared, never restated per menu. */
    /* One focus treatment: a 2px accent outline. Standalone controls sit it 2px outside the box,
       bordered fields 1px outside their border, full-bleed rows/menu items 2px inside. */

    /* --- v2 motion + focus --- */
    --mj-dur-fast: 120ms;
    --mj-dur-med: 180ms;
    --mj-ease: cubic-bezier(0.2, 0, 0, 1);

    /* --- radii: the Mac is uniformly squarer (bubbles/tool/diff 8, composer 10, prompt cards 12) --- */
    --mj-radius-xs: 4px;
    --mj-radius-sm: 6px;
    --mj-radius-md: 8px;
    --mj-radius-lg: 12px;
    --mj-radius-xl: 16px;
    --mj-radius-pill: 999px;
    --mj-radius-bubble: 8px;
    --mj-radius-card: 8px;
    --mj-radius-card-content: 12px;
    --mj-radius-composer: 10px;
    --mj-radius-code: 6px;
    --mj-radius-field: 6px;
    --mj-radius-popover: 12px;

    /* --- elevation: Mac matronBubbleShadow rgb(18 16 14) @ 0.08; same in dark --- */
    --mj-shadow-bubble: 0 1px 1px rgb(18 16 14 / 0.08);
    --mj-shadow-sm: 0 1px 2px rgb(18 16 14 / 0.08);
    --mj-shadow-md: 0 3px 10px rgb(0 0 0 / 0.18);
    --mj-shadow-lg: 0 16px 48px rgb(18 16 14 / 0.16);
    --mj-shadow-float: 0 2px 4px rgb(0 0 0 / 0.15);

    /* --- v2 icon sizes --- */
    --mj-icon-sm: 14px;
    --mj-icon-md: 16px;
    --mj-icon-lg: 20px;

    /* System font first: SF Pro / SF Mono on Apple platforms (matches the Mac app), Inter / Fira Code elsewhere. */
    --mj-font-family-ui:
        -apple-system, BlinkMacSystemFont, "SF Pro Text", Inter, "Helvetica Neue", "Segoe UI", Roboto, sans-serif;
    --mj-font-family-mono: ui-monospace, "SF Mono", Menlo, "Fira Code", monospace;

    --mj-font-size-root: 16px;
    --mj-font-body-xs-regular: 400 12px/16px var(--mj-font-family-ui);
    --mj-font-body-xs-semibold: 600 12px/16px var(--mj-font-family-ui);
    --mj-font-body-sm-regular: 400 13px/17px var(--mj-font-family-ui);
    --mj-font-body-md-regular: 400 16px/24px var(--mj-font-family-ui);
    --mj-font-heading-sm-semibold: 600 18px/26px var(--mj-font-family-ui);

    /* --- role ramp, Mac sizes and leading (SF at ~1.2–1.3) --- */
    --mj-font-micro: 400 10px/14px var(--mj-font-family-ui);
    --mj-font-meta: 400 11px/15px var(--mj-font-family-ui);
    --mj-font-body: 400 14px/18px var(--mj-font-family-ui);
    --mj-font-body-strong: 500 14px/18px var(--mj-font-family-ui);
    --mj-font-label: 400 13px/16px var(--mj-font-family-ui);
    --mj-font-title: 600 13px/17px var(--mj-font-family-ui);
    --mj-font-heading: 600 17px/22px var(--mj-font-family-ui);
    --mj-font-body-sm-semibold: 600 14px/20px var(--mj-font-family-ui);

    --mj-font-size-2xs: 10px;
    --mj-font-size-xs: 12px;
    --mj-font-size-md: 16px;
    --mj-font-size-lg: 18px;

    /* --- v2 spacing: 4px base, non-linear ramp (Refactoring UI) --- */
    --mj-space-0-5x: 2px;
    --mj-space-1x: 4px;
    --mj-space-1-5x: 6px;
    --mj-space-2x: 8px;
    --mj-space-3x: 12px;
    --mj-space-4x: 16px;
    --mj-space-5x: 20px;
    --mj-space-6x: 24px;
    --mj-space-8x: 32px;
    --mj-space-10x: 40px;
    --mj-space-12x: 48px;

    /* Theme-independent focus ring tokens. */
    --mj-focus-ring: 2px solid var(--mj-color-text-action-accent);
    --mj-focus-offset: 2px;
    --mj-focus-offset-field: 1px;
    --mj-focus-offset-inset: -2px;
}

[data-theme="dark"] {
    /* Warm dark ladder from the Mac timeline/bubble colours: app < canvas < panel < raised < overlay. */
    --mj-color-bg-accent: #0b6e7d;
    --mj-color-bg-accent-emphasis: #0c7e8f;
    --mj-color-bg-accent-tint: rgb(110 205 220 / 0.18);
    /* Mac TerminalStyle: tool output and diff bodies sit on one fixed dark block in BOTH themes. */
    --mj-color-terminal-bg: #1f1f1f;
    --mj-color-terminal-fg: #dbdbdb;
    --mj-color-terminal-add: #73d173;
    --mj-color-terminal-del: #e65959;
    --mj-color-terminal-muted: #8c8c8c;
    --mj-color-bg-canvas-default: #262421;
    --mj-color-bg-sidebar: #2a2926;
    --mj-color-bg-canvas-raised: #2c2a26;
    --mj-color-bg-chat-canvas: linear-gradient(180deg, #1d1b18 0%, #171512 100%);
    --mj-color-bg-scrim-drag: rgb(23 21 18 / 0.9);
    --mj-color-bg-self-bubble: #123a41;
    --mj-color-bg-subtle-primary: #2c2a26;
    --mj-color-bg-subtle-secondary: #33302b;
    --mj-seg-on: #353a41;
    --mj-color-bg-usage-track: rgb(255, 255, 255, 0.12);
    --mj-color-border-accent: rgb(110 205 220 / 0.3);
    --mj-color-border-disabled: #33302b;
    --mj-color-border-interactive-primary: #5c574f;
    --mj-color-border-interactive-secondary: #433e37;
    --mj-color-border-subtle: #33302b;
    --mj-color-border-strong: #433e37;
    --mj-color-icon-accent-primary: #6ecddc;
    --mj-color-icon-secondary: #9a948b;
    --mj-color-icon-tertiary: #857e74;
    --mj-color-text-action-accent: #6ecddc;
    --mj-color-text-critical-primary: #ff6a6a;
    --mj-color-text-success: #30d158;
    --mj-color-text-link-external: #6ecddc;
    /* Accent bg (--mj-color-bg-accent #0b6e7d) is identical in both themes, so on-accent
       text stays white in dark too; the lighter #6ecddc is only for text, icon and link accents. */
    --mj-color-text-on-accent: #fff;
    --mj-color-text-placeholder: #857e74;
    --mj-color-text-primary: #e7e4df;
    --mj-color-text-secondary: #9a948b;
    /* Tertiary ink lifted for the lighter #262421 panel: 3.6:1 there, 3.2:1 on subtle-secondary. */
    --mj-color-text-tertiary: #857e74;
    --mj-color-usage-high: #ff453a;
    --mj-color-usage-low: #30d158;
    --mj-color-usage-medium: #ff9f0a;

    /* v2 interaction state layer (light-ink overlays on dark) */
    --mj-state-hover: rgb(128 128 128 / 0.08);
    --mj-state-active: rgb(128 128 128 / 0.14);
    --mj-state-selected: rgb(110 205 220 / 0.14);

    /* §10.4 native chrome (dark): accent-tint selection + light-ink scrollbar thumbs. */
    --mj-selection: rgb(110 205 220 / 0.26);
    --mj-scrollbar: rgb(255 255 255 / 0.2);
    --mj-scrollbar-hover: rgb(255 255 255 / 0.32);
    /* Surface A/B: priority accent brightens in dark (mirrors --mj-color-text-action-accent). */
    --mj-priority-accent: #2dd4bf;

    /* Destructive surface (dark): the critical token is light here, so the tint is built from it
       rather than from the light-theme red — same treatment, theme-correct contrast. */
    --mj-critical-tint: rgb(255 106 106 / 14%);
    --mj-critical-tint-strong: rgb(255 106 106 / 22%);
    --mj-critical-border: rgb(255 106 106 / 45%);

    /* v6 (dark): amber ink + tint and the accent hairline, built from the dark accent. */
    --mj-warn-ink: #ffb454;
    --mj-warn-tint: rgb(255 180 84 / 12%);
    --mj-accent-border: rgb(45 212 191 / 28%);
    /* Modal scrim is the same dark veil in both themes (declared here so the dark block is complete). */
    --mj-scrim-modal: rgb(18 16 14 / 55%);

    /* The Mac keeps the same shadows in dark; the warm ladder carries elevation. */
    --mj-shadow-bubble: 0 1px 1px rgb(18 16 14 / 0.08);
    --mj-shadow-sm: 0 1px 2px rgb(18 16 14 / 0.08);
    --mj-shadow-md: 0 3px 10px rgb(0 0 0 / 0.18);
    --mj-shadow-lg: 0 16px 48px rgb(18 16 14 / 0.16);
    --mj-shadow-float: 0 2px 4px rgb(0 0 0 / 0.15);
}

/* Phones (the same 700px line mobile.pcss uses): the default and large controls become the 44px
   touch target, so every control built on the scale grows together and a row stays one height. */
@media (max-width: 700px) {
    :root {
        --mj-control-h: var(--mj-control-h-touch);
        --mj-control-h-lg: var(--mj-control-h-touch);
    }
}

body {
    background: var(--mj-color-bg-canvas-default);
    color: var(--mj-color-text-primary);
    font-family: var(--mj-font-family-ui);
    font-weight: 400;
    line-height: 1.5;
}

button,
input,
textarea {
    color: inherit;
}

button {
    cursor: pointer;
}

.mj_App_wrapper,
.mj_App,
.mj_ChatView_wrapper,
.mj_ChatView,
.mj_ChatView_body {
    min-width: 0;
    min-height: 0;
}

.mj_App_wrapper,
.mj_App {
    width: 100%;
    height: 100%;
}

.mj_App {
    display: flex;
    overflow: hidden;
}

.mj_Sidebar_outerWrapper,
.mj_ConversationListPanel {
    display: flex;
    height: 100%;
}

.mj_Sidebar_outerWrapper {
    position: relative;
    overflow: visible;
    background: var(--mj-color-bg-sidebar);
}

.mj_ConversationListPanel {
    min-width: 0;
    flex: 1 1 auto;
}

.mj_ConversationListPanel {
    flex-direction: column;
    background: var(--mj-color-bg-sidebar);
}

.mj_ConversationListHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* 14px top; 12px bottom = the uniform sidebar gap so the logo has clear space above
       the New session button and every section is evenly spaced. */
    padding: 14px 16px 12px 14px;
}

/* Nav rail (Mac MacNavColumn): 72px column of 22px icons with 10px labels, 60×56 entries,
   4px apart, 8px top padding; the selected entry is a radius-8 accent tint; red count badges. */
.mj_NavRail {
    display: flex;
    width: 72px;
    flex: 0 0 72px;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding-top: 8px;
    box-sizing: border-box;
}

.mj_NavRail_entry {
    position: relative;
    display: flex;
    width: 70px;
    height: 56px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    border: 0;
    border-radius: var(--mj-radius-md);
    background: transparent;
    color: var(--mj-color-text-secondary);
    cursor: pointer;
}

.mj_NavRail_entry:hover {
    background: var(--mj-state-hover);
}

.mj_NavRail_entry[aria-current="page"] {
    background: var(--mj-state-selected);
    color: var(--mj-color-text-action-accent);
}

.mj_NavRail_icon {
    position: relative;
    display: flex;
    height: 28px;
    align-items: center;
}

.mj_NavRail_icon svg {
    width: 22px;
    height: 22px;
}

.mj_NavRail_label {
    overflow: hidden;
    max-width: 70px;
    font: 400 10px/12px var(--mj-font-family-ui);
    letter-spacing: -0.2px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_NavRail_badge {
    position: absolute;
    top: -4px;
    right: -10px;
    min-width: 16px;
    box-sizing: border-box;
    padding: 1px 5px;
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-usage-high);
    color: #fff;
    font: 600 10px/14px var(--mj-font-family-ui);
    text-align: center;
}

/* Pushes Search and the footer to the foot of the rail. */
.mj_NavRail_spacer {
    flex: 1 1 auto;
}

.mj_NavRail_footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-top: auto;
    padding-bottom: 8px;
}

.mj_NavRail_status {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 8px;
    height: 8px;
    border: 2px solid var(--mj-color-bg-sidebar);
    border-radius: 50%;
    background: var(--mj-color-text-tertiary);
}

.mj_NavRail_status_online {
    background: var(--mj-color-usage-low);
}

/* List header: "Conversations" title (Mac: 13pt semibold pane header) + mark-all-read + New session glyph. */
.mj_ConversationListTitle {
    overflow: hidden;
    margin: 0;
    font: 600 13px/17px var(--mj-font-family-ui);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_ConversationListHeaderActions {
    display: flex;
    align-items: center;
    gap: 4px;
}

.mj_IconButton {
    display: inline-flex;
    width: var(--mj-control-h);
    height: var(--mj-control-h);
    align-items: center;
    justify-content: center;
    padding: var(--mj-space-1x);
    border: 0;
    border-radius: var(--mj-radius-md);
    background: transparent;
    color: var(--mj-color-icon-secondary);
    transition:
        background var(--mj-dur-fast) var(--mj-ease),
        color var(--mj-dur-fast) var(--mj-ease);
}

.mj_IconButton:hover {
    background: var(--mj-state-hover);
    color: var(--mj-color-text-primary);
}

.mj_IconButton svg {
    width: var(--mj-icon-lg);
    height: var(--mj-icon-lg);
}

.mj_ConversationSearch {
    display: flex;
    align-items: center;
    /* Mac search field: outer h10, top 4, bottom 8; a white 30pt field with a hairline on the sidebar. */
    padding: 4px 10px 8px;
}

.mj_ConversationSearch_inputWrapper {
    display: flex;
    width: 100%;
    height: 30px;
    box-sizing: border-box;
    align-items: center;
    gap: var(--mj-space-2x);
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-field);
    background: var(--mj-color-bg-canvas-default);
    color: var(--mj-color-text-secondary);
    padding: 0 8px;
}

.mj_ConversationSearch_inputWrapper svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
}

.mj_ConversationSearch_input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--mj-color-text-primary);
    /* v4 body.xs (search): 13px / 400 / 16px. */
    font-size: 13px;
    line-height: 16px;
}
.mj_ConversationSearch_field .mj_SearchField_icon,
.mj_ConversationSearch_field .mj_SearchField_input::placeholder {
    color: var(--mj-color-text-secondary);
}

.mj_ConversationList {
    flex: 1 1 0;
    min-height: 0;
    overflow-y: auto;
    padding-top: 8px;
}

.mj_ConversationListItem {
    position: relative;
    display: flex;
    width: calc(100% - var(--mj-space-4x));
    box-sizing: border-box;
    /* Mac chat row: ~40pt, padding v4 h8, 8 between glyph and text, radius 6 hover/selection. */
    min-height: 40px;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin: 0 var(--mj-space-2x) 1px;
    padding: 4px 8px;
    border: 0;
    border-radius: var(--mj-radius-sm);
    background: transparent;
    color: var(--mj-color-text-primary);
    text-align: left;
    transition: background var(--mj-dur-fast) var(--mj-ease);
}

.mj_ConversationListItem:hover {
    background: var(--mj-state-hover);
}

.mj_ConversationListItem_selected {
    background: var(--mj-state-selected);
}

/* subagent child row: indented under its parent with a muted name. The rail, elbow and
   status glyph live in subagents.pcss. */
.mj_ConversationListItem_sub .mj_ConversationListName {
    color: var(--mj-color-text-secondary);
}

.mj_ConversationListSubArrow {
    color: var(--mj-color-text-tertiary);
}

.mj_ConversationListWorkerGlyphs {
    display: inline-flex;
    width: 28px;
    height: 12px;
    flex: 0 0 28px;
    align-items: center;
    gap: 4px;
}

.mj_ConversationListWorkerMark,
.mj_ConversationListOutcomeGlyph,
.mj_ConversationListSubSpinner {
    width: 12px;
    height: 12px;
    flex: 0 0 12px;
}

/* Leading 8px status column: running = pulsing teal dot, idle = strong-line dot. */
.mj_ConversationListStatus {
    flex: none;
    width: 8px;
    height: 8px;
    /* Centred in the 14px column the pin glyph uses, so pinned and unpinned titles start at the
       same x (they were 6px apart). */
    margin-inline: 3px;
    border-radius: 50%;
    background: var(--mj-color-border-strong);
}

.mj_ConversationListStatus_running {
    background: var(--mj-color-text-action-accent);
    animation: mj-pulse 1.6s ease-in-out infinite;
}

.mj_ConversationListText {
    display: flex;
    min-width: 0;
    flex: 1 1 0;
    flex-direction: column;
    gap: 2px;
}

.mj_ConversationListName,
.mj_ConversationListMeta {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_ConversationListName {
    /* Mac row title: 14pt regular; semibold only while unread. */
    color: var(--mj-color-text-primary);
    font: 400 14px/18px var(--mj-font-family-ui);
}

/* Mac: "snippet · 1m" on one secondary 12pt line; the snippet truncates, the time never does
   (MacChatListView gives the time layout priority). */
.mj_ConversationListMeta {
    display: flex;
    min-width: 0;
    align-items: baseline;
    color: var(--mj-color-text-secondary);
    font: 400 12px/16px var(--mj-font-family-ui);
}

.mj_ConversationListSnippet {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_ConversationListDot {
    flex: none;
    white-space: pre;
}

.mj_ConversationListText_unread .mj_ConversationListName {
    font-weight: 600;
}

/* Session tag ahead of the title (SessionTagText): box letter in the box's hue, semibold;
   ":" secondary; the two-character short in primary. The letter's colour is set per row as
   --mj-box-light / --mj-box-dark so the theme switch needs no re-render. */
.mj_SessionTag_letter {
    color: var(--mj-box-light);
    font-weight: 600;
}

[data-theme="dark"] .mj_SessionTag_letter {
    color: var(--mj-box-dark);
}

.mj_SessionTag_sep {
    color: var(--mj-color-text-secondary);
}

/* Day section headers (Mac sidebar list sections). */
.mj_ConversationListGroup_label {
    margin: 8px 16px 2px;
    color: var(--mj-color-text-secondary);
    font: 600 11px/14px var(--mj-font-family-ui);
}

.mj_ConversationListGroup:first-child .mj_ConversationListGroup_label {
    margin-top: 0;
}

.mj_UnreadBadge {
    display: inline-flex;
    min-width: 18px;
    height: 18px;
    align-items: center;
    justify-content: center;
    border-radius: var(--mj-radius-pill);
    /* v4: teal count badge, badge.count 600 10px/18px. */
    background: var(--mj-color-bg-accent);
    color: var(--mj-color-text-on-accent);
    padding: 0 6px;
    font-size: 10px;
    font-weight: 600;
    line-height: 18px;
}

/* Right-hand column: unread badge / collapsed-children chip. */
.mj_ConversationListTrailing {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--mj-space-0-5x);
}

/* The row's count badges side by side (Mac MacChatRow): New, needs you, unread. */
.mj_ConversationListBadges {
    display: inline-flex;
    align-items: center;
    gap: var(--mj-space-1x);
}

/* The needs-you badge on a row keeps the unread badge's metrics, so a row is the same height
   with or without it and only the orange (and the glyph) tells the two apart. */
.mj_ConversationListBadges .mj_TrackerNeedsYouBadge {
    height: 18px;
    padding: 0 6px;
    font-size: 10px;
    font-weight: 600;
    line-height: 18px;
}

/* "New" on a session that arrived without the user starting it here and is not opened yet:
   tinted rather than filled, so it reads quieter than the counts beside it. */
.mj_ConversationListNew {
    display: inline-flex;
    height: 18px;
    align-items: center;
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-bg-accent-tint);
    color: var(--mj-color-text-action-accent);
    padding: 0 6px;
    font-size: 10px;
    font-weight: 600;
    line-height: 18px;
}

/* Collapsed-subagents count on a parent row — a subtle tertiary chevron+count that signals
   hidden child rows and stays minimal (matches the meta column's muted styling). */
.mj_ConversationListCollapsedSubs {
    display: inline-flex;
    align-items: center;
    gap: 1px;
    color: var(--mj-color-text-tertiary);
    font-size: 10px;
    font-weight: 500;
    line-height: 14px;
}

.mj_ConversationListCollapsedSubs svg {
    width: 12px;
    height: 12px;
}

.mj_ConversationListTime {
    flex: none;
    white-space: nowrap;
}

.mj_ConversationListItem_wrapper:focus-within .mj_ConversationListTrailing {
    padding-right: var(--mj-space-5x);
}

.mj_ConversationListEmpty {
    color: var(--mj-color-text-secondary);
    padding: 12px;
    text-align: center;
}

/* Message-content search (Apple-parity "Messages" section). Sits below the chat list in the
   sidebar while the search box holds a query; the box already filters chat titles above it. */
.mj_SearchResults {
    margin-top: 4px;
    padding-top: 4px;
    border-top: 1px solid var(--mj-color-border-subtle);
}

.mj_SearchResults_heading {
    padding: 8px 12px 4px;
    color: var(--mj-color-text-tertiary);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.mj_SearchHitList {
    margin: 0;
    padding: 0;
    list-style: none;
}

.mj_SearchHit {
    display: flex;
    width: calc(100% - var(--mj-space-3x));
    box-sizing: border-box;
    flex-direction: column;
    gap: 2px;
    margin: 0 var(--mj-space-2x) 1px;
    padding: 8px 10px;
    border: 0;
    border-radius: var(--mj-radius-md);
    background: transparent;
    color: var(--mj-color-text-primary);
    text-align: left;
    cursor: pointer;
    transition: background var(--mj-dur-fast) var(--mj-ease);
}

.mj_SearchHit:hover {
    background: var(--mj-state-hover);
}

.mj_SearchHit_top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
}

.mj_SearchHit_title {
    overflow: hidden;
    color: var(--mj-color-text-primary);
    font-size: 13px;
    font-weight: 500;
    line-height: 17px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_SearchHit_time {
    flex: 0 0 auto;
    color: var(--mj-color-text-tertiary);
    font-size: 11px;
    font-weight: 400;
    line-height: 14px;
    white-space: nowrap;
}

.mj_SearchHit_snippet {
    display: -webkit-box;
    overflow: hidden;
    color: var(--mj-color-text-secondary);
    font-size: 12px;
    line-height: 16px;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}

.mj_SearchHit_mark {
    background: transparent;
    color: var(--mj-color-text-action-accent);
    font-weight: 600;
}

.mj_ResizeHandle {
    position: relative;
    z-index: 10;
    width: 0;
    flex: 0 0 0;
    cursor: col-resize;
}

.mj_ResizeHandle::after {
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    left: -3px;
    width: 6px;
    content: "";
}

.mj_ResizeHandle:hover::after {
    background: var(--mj-color-bg-accent-tint);
}

.mj_ChatView_wrapper,
.mj_ChatView,
.mj_ChatView_body {
    display: flex;
    flex: 1 1 0;
}

.mj_ChatView,
.mj_ChatView_body {
    width: 100%;
}

.mj_ChatView_body {
    flex-direction: column;
    overflow: hidden;
    background: var(--mj-color-bg-chat-canvas);
}

.mj_ChatHeader {
    width: 100%;
    /* Header band raised to 64px (operator: "a little higher"). At 64 the 36px title
       block (title+subtitle) and the 36px 2×2 bars block (row-gap 10) both centre to
       14–50, so title-top == bars-top AND subtitle-bottom == the 5h/wk row bottom. */
    min-height: 64px;
    box-sizing: border-box;
    padding: 0 12px 0 18px;
    background: var(--mj-color-bg-canvas-default);
}

.mj_ChatView_timeline {
    display: flex;
    min-height: 0;
    flex: 1 1 0;
    position: relative;
}

.mj_ChatView_messagePanel {
    /* The transcript's offsetParent, so row positions are measured within the scrolled content. */
    position: relative;
    width: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    /* The windowed transcript keeps the reader's place itself when rows above the viewport mount
       or change height; the browser's own scroll anchoring would correct the same shift twice. */
    overflow-anchor: none;
}

.mj_TimelineSpacer {
    flex: none;
    pointer-events: none;
}

.mj_ChatView_messageList {
    display: flex;
    /* Fluid: fills the chat pane with equal 20px gutters, no centred max-width cap. */
    width: 100%;
    box-sizing: border-box;
    flex-direction: column;
    justify-content: flex-end;
    margin: 0;
    padding: 0 20px;
    list-style: none;
}

.mj_EventTile[data-layout="bubble"] {
    --EventTile-bubble-max-width: min(76.75%, 800px);

    position: relative;
    min-height: 0;
    flex: 0 0 auto;
    margin: 5.5px 20px 0;
}

.mj_EventTile[data-layout="bubble"].mj_EventTile_continuation {
    margin-top: 1px;
}

.mj_EventTile[data-layout="bubble"].mj_EventTile_lastInSection {
    margin-bottom: 5.5px;
}

.mj_SenderName {
    display: flex;
    align-items: center;
    gap: var(--mj-space-1x);
    margin: 0 0 var(--mj-space-1x) var(--mj-space-0-5x);
    color: var(--mj-color-text-primary);
    font: var(--mj-font-meta);
    font-weight: 600;
}

.mj_SenderName > a {
    flex-shrink: 0;
    color: inherit;
    text-decoration: none;
}

.mj_SenderName_displayName {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_MsgAvatar {
    width: var(--mj-icon-md);
    height: var(--mj-icon-md);
    flex-shrink: 0;
    background-color: var(--mj-color-icon-secondary);
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
}

.mj_EventTile_avatar {
    display: none;
}

.mj_EventTile_line {
    display: flex;
    width: fit-content;
    max-width: var(--EventTile-bubble-max-width);
    min-height: 36px;
    box-sizing: border-box;
    position: relative;
    gap: var(--mj-space-1x);
    margin-left: -9px;
    padding: var(--mj-space-3x) 56px var(--mj-space-3x) var(--mj-space-3x);
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-bubble);
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-bubble);
    line-height: 1.5;
}

.mj_EventTile[data-self="false"] .mj_EventTile_line {
    /* v5: agent content is a block column capped at the shared content width, so every
       block (prose, tool/diff/code cards) fills the SAME width instead of each sizing to
       its own content. Wide code/diff scrolls inside its card, not by widening the card. */
    display: block;
    width: 100%;
    max-width: var(--mj-content-width);
    margin-left: 0;
    /* No horizontal padding so the agent content's right edge lines up exactly with the
       own-bubble right edge (both at the tile edge). */
    padding: var(--mj-space-1x) 0;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
}

/* Agent continuation blocks no longer render a per-block timestamp (the section's single
   timestamp lives on the profile row), so they fill to the same right edge as the first
   block — no 56px reserve, no first-block spill. */

.mj_EventTile[data-self="true"] .mj_EventTile_line {
    /* v5: right edge aligns with the agent content column (no -9px overhang), so own
       bubbles and agent messages share one clean right margin. */
    margin-right: 0;
    margin-left: auto;
    border-color: transparent;
    background: var(--mj-color-bg-self-bubble);
}

.mj_EventTile_line > a {
    position: absolute;
    right: 8px;
    bottom: 7px;
}

.mj_MessageTimestamp {
    white-space: nowrap;
    color: var(--mj-color-text-secondary);
    font-size: var(--mj-font-size-2xs);
    line-height: 14px !important;
}

.mj_EventTile_content {
    min-width: 0;
    overflow: hidden;
    padding: 1px;
}

.markdown-body {
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
}

.markdown-body p:first-child {
    margin-top: 0;
}

.markdown-body p:last-child {
    margin-bottom: 0;
}

.mj_TypingIndicator {
    list-style: none;
}

.mj_Composer {
    min-height: 56px;
    flex: 0 0 auto;
    /* v5 composer.footer: TRANSPARENT — the warm room-canvas (--m-paper) reading
       surface shows through. The bordered --m-panel shell is the input row alone. */
    background: transparent;
}

.mj_Composer_wrapper {
    position: relative;
    /* Mac composer bar: 16 all round, a divider above, on the timeline colour (no panel fill). */
    padding: 16px;
    border-top: 1px solid var(--mj-color-border-subtle);
    background: transparent;
}

.mj_SlashPalette {
    position: absolute;
    /* v4 layering: slash palette sits above the composer, below modals. */
    z-index: 20;
    right: var(--mj-space-4x);
    bottom: calc(100% + var(--mj-space-2x));
    left: var(--mj-space-4x);
    /* v4 caps the palette at 262px, but never taller than half the dynamic viewport —
       on short visual viewports (mobile landscape, on-screen keyboard) a fixed 262px
       would push the top rows off-screen above the absolutely-anchored composer. */
    max-height: min(262px, 50dvh);
    overflow-y: auto;
    box-sizing: border-box;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-md);
    color: var(--mj-color-text-primary);
}

.mj_SlashPalette_row {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: baseline;
    gap: 9px;
    padding: 7px 12px;
    cursor: pointer;
}

/* v4: mouse hover and keyboard highlight are one state (--m-hover). */
.mj_SlashPalette_row_highlighted {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_SlashPalette_trigger {
    font: 500 12.5px/18px var(--mj-font-family-mono);
    white-space: nowrap;
}

.mj_SlashPalette_argHint {
    font: 400 11px/16px var(--mj-font-family-mono);
    color: var(--mj-color-text-secondary);
    white-space: nowrap;
}

.mj_SlashPalette_summary {
    min-width: 0;
    overflow-wrap: anywhere;
    font: 400 12px/16px var(--mj-font-family-ui);
    color: var(--mj-color-text-secondary);
}

/* Mac attachment tray: one row of staged files above the field. Images are 56px square
   thumbnails, other files a named chip capped at 160px; the remove button hangs over the
   top-right corner, so each chip leaves room for it. */
.mj_AttachmentTray {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 0 0 8px 36px;
}

/* Read out by screen readers only: why a send stopped. */
.mj_AttachmentTray_status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
}

.mj_StagedAttachment {
    position: relative;
    display: flex;
    height: 56px;
    max-width: 160px;
    flex: 0 0 auto;
    box-sizing: border-box;
    align-items: center;
    gap: 8px;
    margin: 6px 6px 0 0;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: 8px;
    background: var(--mj-color-bg-subtle-secondary);
    padding: 0 10px;
}

.mj_StagedAttachment_image {
    width: 56px;
    padding: 0;
}

.mj_StagedAttachment_thumb {
    width: 100%;
    height: 100%;
    border-radius: 7px;
    object-fit: cover;
}

.mj_StagedAttachment_icon {
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
    color: var(--mj-color-text-action-accent);
}

.mj_StagedAttachment_meta {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
}

.mj_StagedAttachment_name,
.mj_StagedAttachment_detail {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.mj_StagedAttachment_name {
    font: 400 12px/16px var(--mj-font-family-ui);
    color: var(--mj-color-text-primary);
}

.mj_StagedAttachment_detail {
    font: 400 11px/14px var(--mj-font-family-ui);
    color: var(--mj-color-text-secondary);
}

/* Waiting its turn in a send: dimmed until its upload starts. */
.mj_StagedAttachment_queued {
    opacity: 0.6;
}

.mj_StagedAttachment_failed {
    border-color: var(--mj-color-text-critical-primary);
}

.mj_StagedAttachment_failed .mj_StagedAttachment_detail {
    color: var(--mj-color-text-critical-primary);
}

/* Upload progress: a thin determinate bar along the chip's bottom edge. */
.mj_StagedAttachment_progress {
    position: absolute;
    right: 6px;
    bottom: 5px;
    left: 6px;
    height: 3px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--mj-color-bg-usage-track);
}

.mj_StagedAttachment_progressFill {
    display: block;
    height: 100%;
    background: var(--mj-color-bg-accent);
    transition: width var(--mj-dur-fast) var(--mj-ease);
}

/* Two-tone so it stays legible over a photo of any colour. */
.mj_StagedAttachment_remove,
.mj_StagedAttachment_retry {
    position: absolute;
    top: -7px;
    right: -7px;
    display: inline-flex;
    width: 18px;
    height: 18px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 60%);
    color: #fff;
    cursor: pointer;
}

.mj_StagedAttachment_retry {
    right: 15px;
    background: var(--mj-color-bg-accent);
    color: var(--mj-color-text-on-accent);
}

.mj_StagedAttachment_remove svg,
.mj_StagedAttachment_retry svg {
    width: 10px;
    height: 10px;
}

.mj_StagedAttachment_remove:focus-visible,
.mj_StagedAttachment_retry:focus-visible {
    outline: 2px solid var(--mj-color-text-action-accent);
    outline-offset: 1px;
}

.mj_ComposerSend:disabled {
    opacity: 0.4;
    cursor: default;
}

.mj_ComposerSend:disabled:hover {
    background: transparent;
}

/* Mac composer row: plus.circle (17) outside left, a borderless white 32pt field with a 2/1
   shadow, mic (15) outside right, and the accent arrow.up.circle.fill (22) only with text. */
.mj_ComposerRow {
    display: flex;
    align-items: flex-end;
    gap: 4px;
}

.mj_ComposerField {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    min-height: 32px;
    box-sizing: border-box;
    align-items: center;
    border: 1px solid transparent;
    border-radius: var(--mj-radius-composer);
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-sm);
    padding: 0 8px;
    transition: border-color var(--mj-dur-fast) var(--mj-ease);
}

/* Focus is the border turning accent (the Mac field has no ring); the textarea draws none. */
.mj_ComposerField:focus-within {
    border-color: var(--mj-color-text-action-accent);
}

/* The tracker reply box is the same shell (operator call T3), with the same focus treatment. */
.mj_TrackerComposer_row:focus-within {
    border-color: var(--mj-color-text-action-accent);
}
.mj_ComposerInput {
    display: flex;
    align-items: center;
}

.mj_ComposerInput_input {
    /* Borderless and transparent inside the shadowed field; 13px like the Mac composer. */
    width: 100%;
    min-height: 30px;
    max-height: 144px;
    box-sizing: border-box;
    margin: 0;
    padding: 6px 0;
    border: 0;
    background: transparent;
    font: 400 13px/18px var(--mj-font-family-ui);
}

/* v5: focus is carried ENTIRELY by the shell border recolor
   (.mj_ComposerField:focus-within → accent). No ring on the textarea — text
   inputs match :focus-visible on every focus (click included), so a ring there shows
   a "rectangle" the moment you type. The neutral→accent border change is the visible,
   design-matching focus indicator. See reference_focus_visible_fires_on_every_text_input_focus. */
.mj_ComposerInput_input:focus,
.mj_ComposerInput_input:focus-visible {
    outline: none;
}

.mj_TrackerComposer_input:focus,
.mj_TrackerComposer_input:focus-visible {
    outline: none;
}

.mj_ComposerInput_input::placeholder,
.mj_TrackerComposer_input::placeholder {
    color: var(--mj-color-text-tertiary);
}

.mj_ComposerControl,
.mj_ComposerSend {
    display: inline-flex;
    width: 32px;
    height: 32px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: var(--mj-radius-md);
    background: transparent;
    color: var(--mj-color-icon-secondary);
    transition:
        background var(--mj-dur-fast) var(--mj-ease),
        color var(--mj-dur-fast) var(--mj-ease);
}

.mj_ComposerAttach svg {
    width: 17px;
    height: 17px;
}

.mj_ComposerMic svg {
    width: 15px;
    height: 15px;
}

.mj_ComposerControl:hover:not([aria-disabled="true"]):not(:disabled) {
    background: var(--mj-state-hover);
    color: var(--mj-color-text-primary);
}

.mj_ComposerSend {
    color: var(--mj-color-text-action-accent);
}

.mj_ComposerSend svg {
    width: 22px;
    height: 22px;
}

.mj_ComposerSend:hover {
    background: var(--mj-state-hover);
}

.mj_ComposerControl:focus-visible,
.mj_ComposerSend:focus-visible {
    outline: 2px solid var(--mj-color-text-action-accent);
    outline-offset: 2px;
}

.mj_ComposerControl[aria-disabled="true"] {
    color: var(--mj-color-icon-tertiary);
    opacity: 0.5;
}

.mj_HomePage {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    background: var(--mj-color-bg-chat-canvas);
}

.mj_HomePage_default_wrapper {
    text-align: center;
}

.mj_HomePage_default_wrapper img {
    width: 96px;
}

/* Sign-in: the Mac MacSignInView layout — one centred column on the window surface, no card.
   Logo 72, title 17/600, caption labels above 28px fields, 12px between fields, full-width
   submit disabled until the form is valid. (unify step 2) */
.mj_Login {
    display: flex;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    justify-content: center;
    /* Short viewports (landscape phone, keyboard open): the column overflows downward and
       scrolls instead of being clipped at the top by the overflow-hidden app host. */
    overflow: auto;
    padding: var(--mj-space-8x);
    background: var(--mj-color-bg-canvas-default);
}

.mj_Login_column {
    display: flex;
    width: min(390px, 100%);
    margin: auto;
    flex-direction: column;
    align-items: center;
    gap: var(--mj-space-4x);
}

.mj_Login_logo {
    width: 72px;
    height: 72px;
}

/* Same treatment as the sidebar wordmark: the dark line-art mark goes white in dark. */
[data-theme="dark"] .mj_Login_logo {
    filter: brightness(0) invert(1);
}

.mj_Login_title {
    margin: 0;
    color: var(--mj-color-text-primary);
    font: 600 17px/22px var(--mj-font-family-ui);
}

.mj_LoginServerNote {
    margin: calc(-1 * var(--mj-space-2x)) 0 0;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-meta);
}

.mj_LoginForm {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: var(--mj-space-3x);
}

.mj_LoginField {
    display: flex;
    flex-direction: column;
    gap: var(--mj-space-1x);
}

.mj_LoginField_label {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-micro);
}

.mj_LoginField input {
    width: 100%;
    height: 28px;
    box-sizing: border-box;
    padding: 0 var(--mj-space-2x);
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-field);
    outline: 0;
    background: var(--mj-color-bg-canvas-default);
    color: var(--mj-color-text-primary);
    font: var(--mj-font-body-sm-regular);
}

.mj_LoginField input::placeholder {
    color: var(--mj-color-text-placeholder);
}

.mj_LoginField input:focus-visible {
    border-color: var(--mj-color-text-action-accent);
    outline: 0;
}

.mj_Login_error {
    font: var(--mj-font-body-xs-regular);
}

.mj_LoginSubmit {
    width: 100%;
    height: 32px;
    margin-top: var(--mj-space-1x);
    border: 0;
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-accent);
    color: var(--mj-color-text-on-accent);
    font: 600 13px/17px var(--mj-font-family-ui);
}

.mj_LoginSubmit:hover:not(:disabled) {
    background: var(--mj-color-bg-accent-emphasis);
}

.mj_LoginSubmit:disabled {
    opacity: 0.5;
    cursor: default;
}

.mj_AutoHideScrollbar {
    scrollbar-color: transparent transparent;
}

.mj_AutoHideScrollbar:hover {
    scrollbar-color: rgb(101 109 119 / 40%) transparent;
}

/* Settings sheet (Mac Settings window as a sheet): grouped sections on the window surface. */
.mj_SettingsScrim {
    position: fixed;
    z-index: 50;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--mj-scrim-modal);
}

.mj_SettingsSheet {
    display: flex;
    width: min(420px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    box-sizing: border-box;
    flex-direction: column;
    gap: 16px;
    overflow: auto;
    border-radius: var(--mj-radius-popover);
    background: var(--mj-color-bg-canvas-raised);
    box-shadow: var(--mj-shadow-lg);
    color: var(--mj-color-text-primary);
    padding: 16px;
    outline: none;
}

.mj_SettingsSheet_head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.mj_SettingsSheet_head h2 {
    margin: 0;
    font: 600 13px/17px var(--mj-font-family-ui);
}

.mj_SettingsSheet_done {
    border: 0;
    background: transparent;
    color: var(--mj-color-text-action-accent);
    cursor: pointer;
    font: 600 13px/17px var(--mj-font-family-ui);
}

.mj_SettingsSheet_group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.mj_SettingsSheet_groupTitle {
    margin: 0 4px;
    color: var(--mj-color-text-secondary);
    font: 600 11px/14px var(--mj-font-family-ui);
}

.mj_SettingsSheet_rows {
    margin: 0;
    border-radius: var(--mj-radius-composer);
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-sm);
}

.mj_SettingsSheet_row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 12px;
    font: 400 13px/17px var(--mj-font-family-ui);
}

.mj_SettingsSheet_row + .mj_SettingsSheet_row {
    border-top: 1px solid var(--mj-color-border-subtle);
}

.mj_SettingsSheet_row dt {
    color: var(--mj-color-text-primary);
}

.mj_SettingsSheet_row dd {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    color: var(--mj-color-text-secondary);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_SettingsSheet_appearance {
    align-self: flex-start;
}

/* New chats: a select per row, right-aligned like the Account values. */
label.mj_SettingsSheet_row {
    align-items: center;
    padding-block: 6px;
}

.mj_SettingsSheet_select {
    min-width: 0;
    max-width: 60%;
    padding: 3px 6px;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-canvas-default);
    color: inherit;
    font: inherit;
}

.mj_SettingsSheet_select:focus-visible {
    outline: 2px solid var(--mj-color-text-action-accent);
    outline-offset: -1px;
}

/* Boxes: one card per agent box, its name heading the agent / model / effort rows. */
.mj_SettingsSheet_box + .mj_SettingsSheet_box {
    margin-top: 4px;
}

.mj_SettingsSheet_boxName {
    color: var(--mj-color-text-primary);
    font-weight: 600;
}

.mj_SettingsSheet_input {
    width: 60%;
}

.mj_SettingsSheet_input::placeholder {
    color: var(--mj-color-text-secondary);
}

.mj_SettingsSheet_help,
.mj_SettingsSheet_error {
    margin: 0 4px;
    font: 400 12px/16px var(--mj-font-family-ui);
}

.mj_SettingsSheet_switchRow {
    align-items: center;
}

.mj_SettingsSheet_switchText {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    color: var(--mj-color-text-primary);
}

.mj_SettingsSheet_help {
    color: var(--mj-color-text-secondary);
}

.mj_SettingsSheet_error {
    color: var(--mj-color-text-critical-primary);
}

/* The help line under a switch label sits in the label column, tighter than a group help line. */
.mj_SettingsSheet_switchText .mj_SettingsSheet_help {
    margin: 0;
    font: 400 11px/14px var(--mj-font-family-ui);
}

/* An on/off switch: a pill track with a sliding knob, accent when on. */
.mj_SettingsSheet_switch {
    position: relative;
    flex: none;
    width: 36px;
    height: 20px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    background: var(--mj-color-bg-subtle-primary);
    cursor: pointer;
    transition: background 0.15s;
}
.mj_SettingsSheet_switch::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-sm);
    transition: transform 0.15s;
}
.mj_SettingsSheet_switch[aria-checked="true"] {
    background: var(--mj-color-bg-accent);
}
.mj_SettingsSheet_switch[aria-checked="true"]::after {
    transform: translateX(16px);
}
.mj_SettingsSheet_switch:focus-visible {
    outline: 2px solid var(--mj-color-icon-accent-primary);
    outline-offset: 2px;
}
.mj_SettingsSheet_switch:disabled {
    cursor: default;
    opacity: 0.5;
}

/* Notifications: the mode as radio rows (title over subtitle), and an override's Clear. */
.mj_SettingsSheet_radioRow {
    justify-content: flex-start;
    align-items: center;
    cursor: pointer;
}

.mj_SettingsSheet_radioRow input {
    flex: none;
    margin: 0;
    accent-color: var(--mj-color-text-action-accent);
}

.mj_SettingsSheet_overrideTitle {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_SettingsSheet_clear {
    flex: none;
    border: 0;
    background: transparent;
    color: var(--mj-color-text-action-accent);
    cursor: pointer;
    font: 500 13px/17px var(--mj-font-family-ui);
}

.mj_SettingsSheet_signOut {
    height: 32px;
    border: 0;
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-sm);
    color: var(--mj-color-text-critical-primary);
    cursor: pointer;
    font: 500 13px/17px var(--mj-font-family-ui);
}

.mj_NavRail_settings {
    position: relative;
}

/* Fork-only rules. */
/* The sidebar bar is the shared search field (controls.pcss, subtle variant); only the v4
   body.xs search type is local. */
.mj_ConversationSearch_field .mj_SearchField_input {
    font-size: 13px;
    line-height: 16px;
}

.mj_Composer_row,
.mj_TrackerComposer_row {
    display: flex;
    align-items: flex-end;
    /* v5 composer.shell: the input row IS the bordered field — attach (left),
       textarea (borderless, flex), mic + send (right) all sit inside one shell.
       1px --m-line2, radius 12, --m-panel fill, --m-sh-sm; gap 6 between controls;
       padding 6/8/6/6 (textarea carries no vertical margin). */
    gap: 6px;
    border: 1px solid var(--mj-color-border-strong);
    border-radius: var(--mj-radius-lg);
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-sm);
    padding: 6px 8px 6px 6px;
    transition: border-color var(--mj-dur-fast) var(--mj-ease);
}

.mj_ComposerInput_input,
.mj_TrackerComposer_input {
    /* v5 composer.input: borderless + transparent — the bordered --m-panel shell
       (.mj_Composer_row) is the visible field; the textarea just sits inside it.
       body.md 400 14/22 (fixed, not inherited — root is 15px). The line box is one control tall
       with the 22px line centred in it, so the placeholder sits on the icon buttons' centre line
       at every breakpoint (32px desktop, 44px phone). */
    min-height: var(--mj-control-h);
    box-sizing: border-box;
    margin: 0;
    padding: calc((var(--mj-control-h) - 22px) / 2) 4px;
    border: 0;
    background: transparent;
    font: 400 14px/22px var(--mj-font-family-ui);
}

.mj_Composer_button,
.mj_Composer_sendMessage,
.mj_TrackerComposer_send {
    display: inline-flex;
    width: var(--mj-control-h);
    height: var(--mj-control-h);
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: var(--mj-radius-md);
    background: transparent;
    color: var(--mj-color-icon-tertiary);
    transition:
        background var(--mj-dur-fast) var(--mj-ease),
        color var(--mj-dur-fast) var(--mj-ease);
}

.mj_Composer_button svg,
.mj_Composer_sendMessage svg,
.mj_TrackerComposer_send svg {
    width: 19px;
    height: 19px;
}

/* v4 send button: 32×32, radius 9px, filled --m-accent-deep, always present.
   Disabled (empty composer) keeps its footprint at opacity .45; pointer-events kept. */
.mj_Composer_sendMessage,
.mj_TrackerComposer_send {
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-accent);
    color: var(--mj-color-text-on-accent);
}

.mj_Composer_sendMessage:hover:not(:disabled),
.mj_TrackerComposer_send:hover:not(:disabled) {
    filter: brightness(1.08);
}

.mj_Composer_sendMessage:disabled,
.mj_TrackerComposer_send:disabled {
    opacity: 0.45;
}

.mj_Composer_button:focus-visible,
.mj_Composer_sendMessage:focus-visible,
.mj_TrackerComposer_send:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

/* Shown under the composer while a historical window is open: sending waits for Jump to latest. */
.mj_ComposerHint {
    padding: 4px 12px 0;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-meta);
}

/* Theme-independent fork tokens (control scale, focus ring, motion, z-layers). */
:root {
    --mj-summary-raise: var(--mj-color-bg-canvas-raised);
    --mj-warn-dot: var(--mj-color-usage-medium);
    --mj-font-label-sm: 500 12px/16px var(--mj-font-family-ui);
    --mj-font-mono: 400 12px/18px var(--mj-font-family-mono);
    --mj-live-xfade: 240ms;
    --mj-live-min-interval: 1200ms;
    --mj-live-elapsed-after: 10s;
    --mj-slow-after: 300s;
    --mj-card-expand: var(--mj-dur-fast);
    --mj-group-expand: var(--mj-dur-fast);
    --mj-deep-open: var(--mj-dur-med);
    --mj-resolve: var(--mj-dur-med);
    --mj-bp-pane-narrow: 480px;
    --mj-bp-pane-medium: 760px;
    --mj-bp-sidebar-min: 224px;
    --mj-z-menu: 30;
    --mj-z-modal: 50;
    --mj-control-h-sm: 28px;
    --mj-control-h: 32px;
    --mj-control-h-lg: 40px;
    --mj-control-h-touch: 44px;
    --mj-control-pad-x: var(--mj-space-3x);
    --mj-subbar-h: 52px;
    --mj-seg-inset: 2px;
    --mj-menu-icon: 16px;
    --mj-menu-icon-gap: 10px;
}

/* Upstream rules the fork had moved or removed. */
.mj_ConversationSearch_input::placeholder {
    color: var(--mj-color-text-secondary);
}

.mj_ConversationSearch_input::-webkit-search-cancel-button {
    display: none;
}

.mj_ConversationListItem_sub {
    padding-left: 26px;
}

.mj_ConversationListCollapsedSubs_unread {
    color: var(--mj-color-text-action-accent);
    font-weight: 600;
}

.mj_ComposerInput_input::placeholder {
    color: var(--mj-color-text-tertiary);
}

/* The exact match for a number query sits at the top of the list, so it needs no divider above. */
.mj_NumberSearchResult {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
}

/* Go to number: what the typed number names sits between the field and the buttons. The space is
   held while it is empty so the sheet does not jump as the answer arrives. */
.mj_GoToSheet_result {
    display: flex;
    min-height: 52px;
    align-items: center;
}

.mj_GoToSheet_result .mj_SearchHit {
    width: 100%;
    margin: 0;
    background: var(--mj-state-hover);
}

.mj_GoToSheet_note {
    margin: 0;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
}

/* Settings → Devices: one row per device (name, "This device" badge, caption) with its actions,
   and a footer with Refresh, Link a Device… and Add Agent…. */
.mj_DevicesList {
    padding: 0;
    list-style: none;
}

.mj_DevicesList_row {
    align-items: center;
}

.mj_DevicesList_text {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
}

.mj_DevicesList_name {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow: hidden;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_DevicesList_self {
    flex: none;
    padding: 1px 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--mj-color-bg-accent) 15%, transparent);
    color: var(--mj-color-text-action-accent);
    font: 600 10px/14px var(--mj-font-family-ui);
}

.mj_DevicesList_caption {
    color: var(--mj-color-text-secondary);
    font: 400 11px/14px var(--mj-font-family-ui);
}

.mj_DevicesList_actions,
.mj_DevicesList_footer {
    display: flex;
    flex: none;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px;
}

.mj_DevicesList_actions button,
.mj_DevicesList_footer button {
    padding: 2px 8px;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-canvas-default);
    color: var(--mj-color-text-primary);
    cursor: pointer;
    font: 500 12px/16px var(--mj-font-family-ui);
}

.mj_DevicesList_actions button:hover,
.mj_DevicesList_footer button:hover {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_DevicesList_actions button:focus-visible,
.mj_DevicesList_footer button:focus-visible {
    outline: 2px solid var(--mj-color-text-action-accent);
    outline-offset: 1px;
}

.mj_DevicesList_actions .mj_DevicesList_revoke {
    color: var(--mj-color-text-critical-primary);
}

/* The device sheets (rename, tag, revoke, Add Agent, Link a Device) open over Settings. */
.mj_DeviceSheet_scrim {
    z-index: 60;
}

.mj_DeviceSheet {
    width: min(440px, 92vw);
    outline: none;
}

.mj_DeviceSheet p {
    margin: 0;
    font: 400 13px/18px var(--mj-font-family-ui);
}

.mj_DeviceSheet_box {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-md);
    padding: 10px 12px;
}

.mj_DeviceSheet .mj_DeviceSheet_muted {
    color: var(--mj-color-text-secondary);
    font-size: 12px;
}

.mj_DeviceSheet .mj_DeviceSheet_caution {
    color: var(--mj-color-text-critical-primary);
    font-size: 12px;
    white-space: pre-line;
}

.mj_DeviceSheet .mj_DeviceSheet_warning {
    border-radius: var(--mj-radius-md);
    background: color-mix(in srgb, var(--mj-color-text-critical-primary) 10%, transparent);
    color: var(--mj-color-text-critical-primary);
    padding: 8px 10px;
    font-weight: 500;
}

/* An error under a sheet's fields reads as one, not as the grey lead-in text of a sheet. */
.mj_DeviceSheet > .mj_UploadConfirm_error {
    color: var(--mj-color-text-critical-primary);
}

.mj_DeviceSheet .mj_DeviceSheet_success {
    color: var(--mj-color-text-success);
}

.mj_UploadConfirm_actions button.mj_DeviceSheet_destructive {
    background: var(--mj-color-text-critical-primary);
    color: var(--mj-color-text-on-accent);
    font-weight: 600;
}

.mj_UploadConfirm_actions button.mj_DeviceSheet_destructive:hover:not(:disabled) {
    filter: brightness(1.08);
    background: var(--mj-color-text-critical-primary);
    color: var(--mj-color-text-on-accent);
}

.mj_AddAgentSheet input.mj_AddAgentSheet_code {
    font: 500 17px/24px var(--mj-font-family-mono, monospace);
    letter-spacing: 0.06em;
}

.mj_LinkDeviceSheet_body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
}

.mj_QrCode {
    border-radius: var(--mj-radius-md);
}

.mj_QrCode_pending {
    display: block;
}

.mj_LinkDeviceSheet_body .mj_LinkDeviceSheet_code {
    font: 600 20px/26px var(--mj-font-family-mono, monospace);
    letter-spacing: 0.08em;
    user-select: all;
}

.mj_LinkDeviceSheet_decide {
    justify-content: center;
}

/* Two-factor sign-in (TwoFactor.tsx): the QR and key, the recovery codes, and the code step on the
   sign-in screen. */
.mj_TwoFactorSetup {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
}

.mj_TwoFactorSetup .mj_TwoFactorSetup_hint {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-meta);
}

.mj_TwoFactorSetup_secret {
    margin: 0;
    font: 600 15px/20px var(--mj-font-family-mono, monospace);
    letter-spacing: 0.06em;
    user-select: all;
    word-break: break-all;
}

.mj_TwoFactorSetup_actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    font: var(--mj-font-meta);
}

.mj_TwoFactorSetup_actions button {
    border: 0;
    background: none;
    color: var(--mj-color-text-action-accent);
    font: inherit;
    cursor: pointer;
}

.mj_TwoFactorSetup_actions a {
    color: var(--mj-color-text-action-accent);
}

.mj_RecoveryCodes {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.mj_RecoveryCodes > p {
    margin: 0;
    font: var(--mj-font-body-sm-regular);
}

.mj_RecoveryCodes_list {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    justify-content: space-evenly;
    gap: 6px 40px;
    margin: 0;
    padding: 10px 12px 10px 36px;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-md);
    font: 500 12.5px/18px var(--mj-font-family-mono, monospace);
    user-select: all;
}

.mj_RecoveryCodes_saved {
    display: flex;
    align-items: center;
    gap: 8px;
    font: var(--mj-font-body-sm-regular);
}

.mj_RecoveryCodes_done {
    align-self: flex-end;
    min-width: 96px;
    height: 28px;
    border: 0;
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-accent);
    color: var(--mj-color-text-on-accent);
    font: 600 13px/17px var(--mj-font-family-ui);
}

.mj_RecoveryCodes_done:disabled {
    opacity: 0.5;
}

.mj_TwoFactorStep .mj_TwoFactorStep_text {
    margin: 0;
    font: var(--mj-font-body-sm-regular);
}

.mj_TwoFactorStep .mj_TwoFactorStep_hint {
    margin: calc(-1 * var(--mj-space-2x)) 0 0;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-micro);
}

.mj_TwoFactorStep .mj_RecoveryCodes_done {
    width: 100%;
    height: 32px;
}

.mj_TwoFactorStep_back {
    border: 0;
    background: none;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-meta);
    cursor: pointer;
}

.mj_TwoFactorSheet .mj_RecoveryCodes_saved {
    display: flex;
    margin: 0;
    color: var(--mj-color-text-primary);
    font: 400 13px/18px var(--mj-font-family-ui);
}

/* Settings → Security → Change Password…: the sign-out checkbox with its note under the label. */
.mj_ChangePasswordSheet .mj_RecoveryCodes_saved {
    display: flex;
    margin: 0;
    color: var(--mj-color-text-primary);
    font: 400 13px/18px var(--mj-font-family-ui);
}

.mj_ChangePasswordSheet .mj_ChangePassword_hint {
    margin: 2px 0 0 21px;
    color: var(--mj-color-text-secondary);
    font: 400 12px/16px var(--mj-font-family-ui);
}

/* Settings → Security → Email address: the address itself, under the row's label. */
.mj_AccountEmail_value {
    color: var(--mj-color-text-secondary);
    overflow-wrap: anywhere;
}

.mj_UploadConfirm_actions button.mj_AccountEmail_remove {
    margin-right: auto;
    color: var(--mj-color-text-critical-primary);
}

/* Sign-in screen: "Forgot password?" under the password field. */
.mj_LoginForgot {
    align-self: flex-end;
    margin-top: calc(-1 * var(--mj-space-2x));
    padding: 0;
    border: 0;
    background: none;
    color: var(--mj-color-text-action-accent);
    font: var(--mj-font-meta);
    cursor: pointer;
}

.mj_LoginForgot:hover {
    text-decoration: underline;
}

.mj_SettingsSheet_help.mj_ChangePassword_done {
    color: var(--mj-color-text-success);
}

/* ⌘K slash-command palette: a sheet near the top of the window, the composer palette's rows under
   a filter field. */
.mj_CommandPalette_scrim {
    align-items: flex-start;
    padding-top: 12vh;
}

.mj_CommandPalette {
    display: flex;
    width: min(560px, 92vw);
    max-height: min(420px, 70dvh);
    flex-direction: column;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-popover);
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-lg);
    color: var(--mj-color-text-primary);
}

.mj_CommandPalette_input {
    box-sizing: border-box;
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--mj-color-border-subtle);
    background: transparent;
    color: var(--mj-color-text-primary);
    padding: 12px 14px;
    font: 400 14px/20px var(--mj-font-family-ui);
    outline: none;
}

.mj_CommandPalette_input::placeholder {
    color: var(--mj-color-text-tertiary);
}

.mj_CommandPalette_list {
    min-height: 0;
    overflow-y: auto;
    padding: 4px 0;
}

.mj_CommandPalette_empty {
    margin: 0;
    padding: 10px 14px;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
}
