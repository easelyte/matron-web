/* Journal-specific behaviour inside the Matron visual shell. */

html,
body,
#matron {
    width: 100%;
    height: 100%;
    overflow: hidden;
}

html {
    /* Match Matron's pre-Journal FontWatcher default (the browser default minus 1px). */
    font-size: calc(var(--mj-font-size-root) - 1px);
    /* Themed scrollbars: a subtle themed thumb over a transparent track. Inherited by all
       scrollable descendants; Matron's own .mj_AutoHideScrollbar (message panel etc.)
       overrides this to stay auto-hidden, so only the un-styled native scrollbars — the
       dark sidebar list, which otherwise reads grey-on-white — pick this up. */
    scrollbar-width: thin;
    scrollbar-color: var(--mj-color-border-strong) transparent;
}

body {
    margin: 0;
}

button,
input,
textarea {
    font: inherit;
}

/* §10.4 native-chrome parity — all authored in both themes via the --mj-* tokens.

   Text selection: an accent tint. */
::selection {
    background: var(--mj-selection);
}

/* Focus-ring FLOOR: a themed 2px accent ring, never browser-blue. This is the floor —
   components with their own :focus-visible (menus at offset −2px, etc.) are more specific
   and win, so no double ring; this only catches elements that had no explicit rule. */
:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

/* WebKit scrollbar boxes for legacy parity, SCOPED to the surfaces that intentionally show
   a themed thumb (Firefox already themes these via the inherited scrollbar-color at :root).
   Deliberately NOT global: a global ::-webkit-scrollbar rule force-shows Matron's
   .mj_AutoHideScrollbar panels (message panel etc.), the exact round-4 regression. */
.mj_ConversationList::-webkit-scrollbar,
.mj_SubagentStrip::-webkit-scrollbar,
.mj_EventSource_json::-webkit-scrollbar,
.mj_EventSource_body::-webkit-scrollbar {
    width: 10px;
    height: 10px;
}

.mj_ConversationList::-webkit-scrollbar-track,
.mj_SubagentStrip::-webkit-scrollbar-track,
.mj_EventSource_json::-webkit-scrollbar-track,
.mj_EventSource_body::-webkit-scrollbar-track,
.mj_ConversationList::-webkit-scrollbar-corner,
.mj_EventSource_json::-webkit-scrollbar-corner {
    background: transparent;
}

.mj_ConversationList::-webkit-scrollbar-thumb,
.mj_SubagentStrip::-webkit-scrollbar-thumb,
.mj_EventSource_json::-webkit-scrollbar-thumb,
.mj_EventSource_body::-webkit-scrollbar-thumb {
    border: 3px solid transparent;
    border-radius: var(--mj-radius-pill);
    background: var(--mj-scrollbar);
    background-clip: content-box;
}

.mj_ConversationList::-webkit-scrollbar-thumb:hover,
.mj_SubagentStrip::-webkit-scrollbar-thumb:hover,
.mj_EventSource_json::-webkit-scrollbar-thumb:hover,
.mj_EventSource_body::-webkit-scrollbar-thumb:hover {
    background: var(--mj-scrollbar-hover);
    background-clip: content-box;
}

.mj_Sidebar_outerWrapper {
    --mj-left-panel-width: 350px;

    /* The list width the resizer sets, plus the fixed 72px nav rail beside it. */
    flex: 0 0 calc(var(--mj-left-panel-width) + 72px);
    width: calc(var(--mj-left-panel-width) + 72px);
}

.mj_ConversationListPanel {
    width: 100%;
    min-height: 0;
}

.mj_ConversationListPanel {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.mj_ConversationListPanel [data-testid="conversation-list"] {
    flex: 1;
    min-height: 0;
}

.mj_ConversationListPanel [data-testid="virtuoso-scroller"] {
    overscroll-behavior: contain;
}

.mj_ChatHeader {
    position: relative;
    flex: 0 0 auto;
}

.mj_ChatView_body {
    container: mj-chat / inline-size;
}

.mj_ChatHeader:hover {
    background-color: var(--mj-color-bg-canvas-default);
}

.mj_ChatHeader {
    /* v3 mock: two zones — title flush-LEFT (over a muted model·context subtitle)
       and a right controls cluster (usage bars + Compact pill). Replaces the old
       3-column grid (model/context LEFT · title CENTER · usage RIGHT) the operator
       flagged as wrong vs. the design. */
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    border-bottom: 1px solid var(--mj-color-border-subtle);
    background: var(--mj-color-bg-canvas-default);
    gap: var(--mj-space-4x);
    padding-inline: var(--mj-space-4x);
}

.mj_HeaderCluster {
    /* v3 mock floats the header content on the banner background — no bordered,
       shadowed chip boxes. Unbox for fidelity + declutter. */
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    border: 0;
    background: transparent;
}

/* LEFT zone: title flush-left (bold) stacked over the model·context subtitle. */
.mj_HeaderTitleCluster {
    display: flex;
    min-width: 0;
    min-height: 64px;
    flex-direction: column;
    /* The title block (title + subtitle = 36px) and the 2×2 bars block (also 36px with
       row-gap 10) are equal height, so centring both in the 64px band aligns their tops
       (title-top == bars-top) AND their bottoms (subtitle-bottom == 5h/wk row bottom). */
    justify-content: center;
    align-items: flex-start;
    justify-self: start;
    gap: 2px;
}

.mj_HeaderTitleCluster .mj_ChatHeader_heading {
    display: block;
    max-width: 100%;
    overflow: hidden;
    /* v5 title.lg (header conversation title): 600 15px/20px (measured from the design). */
    color: var(--mj-color-text-primary);
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
    text-align: left;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* §10.11 child-view title row: ↳ glyph · truncating name · SUBAGENT badge (all baseline). */
.mj_SubChatHeader .mj_HeaderTitleCluster .mj_ChatHeader_heading {
    display: flex;
    align-items: baseline;
    gap: 6px;
}

.mj_SubChatHeader .mj_HeaderTitleCluster .mj_ChatHeader_heading .mj_ChatHeader_truncated {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_HeaderTitleGlyph {
    flex: 0 0 auto;
    color: var(--mj-color-text-tertiary);
    font-weight: 400;
}

.mj_HeaderSubagentBadge {
    flex: 0 0 auto;
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-bg-subtle-secondary);
    color: var(--mj-color-text-secondary);
    padding: 0 7px;
    font: 500 10px/16px var(--mj-font-family-ui);
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

/* Subtitle parent reference: "of <parent>" — the parent name reads as primary ink. */
.mj_HeaderParentName {
    color: var(--mj-color-text-primary);
}

/* model · context (· subagent-state) inline subtitle with middot separators.
   v3 mock subtitle: 11px / 400 / 14px, text-secondary. */
.mj_HeaderMeta {
    display: flex;
    min-width: 0;
    max-width: 100%;
    align-items: center;
    overflow: hidden;
    color: var(--mj-color-text-secondary);
    font-size: 11px;
    font-weight: 400;
    line-height: 14px;
}

.mj_HeaderMeta > * {
    min-width: 0;
    flex: 0 1 auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_HeaderMeta > :not(:first-child)::before {
    flex: none;
    margin-inline: var(--mj-space-1x);
    color: var(--mj-color-text-tertiary);
    content: "·";
}

.mj_HeaderModel,
.mj_HeaderContext,
.mj_HeaderLimitsReset {
    display: block;
    overflow: hidden;
    color: inherit;
    font: inherit;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* The subtitle's second segment is the usage-window reset countdown
   ("limits reset in 3h05"), replacing the old workdir path. Flexible so it is the
   first-to-truncate segment, keeping the short model + run-state legible when narrow. */
.mj_HeaderLimitsReset {
    flex: 1 1 auto;
}

.mj_HeaderModel,
.mj_HeaderWorkdir {
    display: block;
    overflow: hidden;
    color: inherit;
    font: inherit;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* v5 subtitle: workdir is the flexible, first-to-truncate segment so the short,
   meaningful model + run-state stay legible when the pane narrows. */
.mj_HeaderWorkdir {
    flex: 1 1 auto;
}

.mj_HeaderModel,
.mj_HeaderMeta .mj_HeaderState {
    flex: 0 1 auto;
}

/* Workdir and account email give way first on a narrow pane; the model (· effort) and
   run-state truncate only once those are gone. They take no room of their own (zero basis)
   and grow into whatever the model and run-state leave, up to their own width. A shrink
   factor would not do: shrinking is shared out by width, so the model always lost a
   fraction of a pixel, enough to clip its effort to an ellipsis. */
.mj_HeaderMeta .mj_HeaderWorkdir,
.mj_HeaderMeta .mj_HeaderEmail {
    max-width: max-content;
    flex: 1 1 0;
}

/* RIGHT zone: usage bars + Compact pill. */
.mj_HeaderControls {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-self: end;
    gap: var(--mj-space-3x);
}

/* v5 mock Compact pill: 28px, 1px --m-line2, transparent, secondary ink, 500 12/16. */
.mj_CompactButton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: var(--mj-control-h-sm);
    padding: 0 10px;
    border: 1px solid var(--mj-color-border-strong);
    border-radius: var(--mj-radius-pill);
    background: transparent;
    color: var(--mj-color-text-secondary);
    font: 500 12px/16px var(--mj-font-family-ui);
    white-space: nowrap;
    cursor: pointer;
}

.mj_CompactButton svg {
    width: 12px;
    height: 12px;
}

.mj_CompactButton:hover {
    background: var(--mj-state-hover);
    color: var(--mj-color-text-primary);
}

/* Indeterminate in-flight state. /compact emits no incremental progress, so
   the pill pulses (opacity oscillation) until the post-compact status frame lands — never
   a fake 0→100% fill. Disabled while compacting, so no hover affordance. */
.mj_CompactButton_compacting {
    color: var(--mj-color-text-primary);
    cursor: default;
    animation: mj-pulse 1.2s ease-in-out infinite;
}

/* 1px divider separating the usage grid from the Compact pill (mock). */
.mj_HeaderDivider {
    width: 1px;
    height: 26px;
    flex: 0 0 auto;
    background: var(--mj-color-border-subtle);
}

/* Header "⋯": the selected conversation's actions, reachable from the chat (next to
   Compact) — 3-dot trigger + click-menu. */
.mj_HeaderOverflow {
    position: relative;
    display: inline-flex;
    flex: 0 0 auto;
}

/* The title and the mission chip share the title row. The chip gives way first (flex-shrink
   1000): its name truncates, down to "#12 +2", before the title starts to. */
.mj_HeaderTitleRow {
    display: flex;
    min-width: 0;
    max-width: 100%;
    align-items: center;
    gap: var(--mj-space-2x);
}

/* The title never goes below a readable stub; past that the chip is hidden (useChipFit). */
.mj_HeaderTitleRow > .mj_HeaderCluster {
    flex: 0 1 auto;
    min-width: min(6rem, 100%);
}

.mj_MissionChip {
    position: relative;
    display: inline-flex;
    flex: 0 1000 auto;
    min-width: 0;
    max-width: 240px;
}

/* No room beside the title's stub even for "#12 +2" (see useChipFit): out of the flow and out of
   reach, but still laid out so it can be measured again when the header widens. */
.mj_MissionChip.mj_MissionChip_hidden {
    position: absolute;
    visibility: hidden;
    pointer-events: none;
}

/* A grid, so the chip's narrowest is its number and "+n": the name track alone can reach 0. */
.mj_MissionChip_trigger {
    display: grid;
    width: 100%;
    height: 26px;
    grid-template-columns: auto auto minmax(0, max-content) auto auto;
    align-items: center;
    box-sizing: border-box;
    border: 0;
    border-radius: 999px;
    background: var(--mj-color-bg-subtle-secondary);
    color: var(--mj-color-text-secondary);
    padding: 0 8px;
    font: 500 12px/16px var(--mj-font-family-ui);
    white-space: nowrap;
    overflow: hidden;
    cursor: pointer;
}

.mj_MissionChip_trigger_current {
    color: var(--mj-color-text-action-accent);
}

.mj_MissionChip_trigger:hover {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_MissionChip_flag {
    width: 12px;
    height: 12px;
    margin-right: 4px;
}

.mj_MissionChip_num {
    font-variant-numeric: tabular-nums;
}

.mj_MissionChip_name {
    overflow: hidden;
    text-overflow: ellipsis;
}

.mj_MissionChip_name:not(:empty) {
    padding-left: 4px;
}

/* No room for a readable name (see useChipNameFits): kept in the DOM, at no width, so its
   natural width can still be measured. */
.mj_MissionChip_name.mj_MissionChip_name_hidden {
    max-width: 0;
    padding-left: 0;
    visibility: hidden;
}

.mj_MissionChip_more {
    font-weight: 600;
}

.mj_MissionChip_more:not(:empty) {
    padding-left: 4px;
}

.mj_MissionChip_chevron {
    width: 10px;
    height: 10px;
    margin-left: 4px;
    color: var(--mj-color-icon-secondary);
}

.mj_MissionChip .mj_HeaderMenu {
    top: calc(100% + var(--mj-space-1x));
    left: 0;
    width: min(320px, calc(100vw - 32px));
    gap: var(--mj-space-3x);
}

.mj_MissionMenu_group {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.mj_MissionMenu .mj_MissionMenu_label {
    padding: 0 var(--mj-space-2x) 2px;
    color: var(--mj-color-text-tertiary);
    font: 600 11px/16px var(--mj-font-family-ui);
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.mj_MissionMenu .mj_MissionMenu_item {
    display: flex;
    min-height: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    background: transparent;
    padding: 6px var(--mj-space-2x);
    text-align: left;
}

.mj_MissionMenu .mj_MissionMenu_item:hover,
.mj_MissionMenu .mj_MissionMenu_item:focus-visible {
    background: var(--mj-color-bg-subtle-secondary);
}

.mj_MissionMenu .mj_MissionMenu_title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--mj-color-text-primary);
    font-weight: 600;
}

.mj_MissionMenu .mj_MissionMenu_item_earlier .mj_MissionMenu_title {
    font-weight: 400;
}

.mj_MissionMenu .mj_MissionMenu_num {
    color: var(--mj-color-text-secondary);
    font-variant-numeric: tabular-nums;
}

.mj_MissionMenu .mj_MissionMenu_line {
    color: var(--mj-color-text-secondary);
    font: 400 12px/16px var(--mj-font-family-ui);
}

.mj_HeaderOverflowTrigger svg {
    width: 18px;
    height: 18px;
}

.mj_HeaderOverflow .mj_HeaderMenu {
    top: calc(100% + var(--mj-space-1x));
    right: 0;
}

/* "Rooms · n" and the notifications bell, beside the "⋯" (ChatHeaderRooms.tsx). */
.mj_RoomsControl,
.mj_NotifyBell {
    position: relative;
    display: inline-flex;
    flex: 0 0 auto;
}

.mj_RoomsControl_trigger {
    height: 26px;
    border: 0;
    border-radius: 999px;
    background: var(--mj-color-bg-subtle-secondary);
    color: var(--mj-color-text-secondary);
    padding: 0 10px;
    font: 500 12px/16px var(--mj-font-family-ui);
    white-space: nowrap;
    cursor: pointer;
}

.mj_RoomsControl_trigger:hover {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_NotifyBell_trigger svg {
    width: 18px;
    height: 18px;
}

.mj_NotifyBell_trigger_silenced {
    color: var(--mj-color-text-secondary);
}

.mj_RoomsControl .mj_HeaderMenu,
.mj_NotifyBell .mj_HeaderMenu {
    top: calc(100% + var(--mj-space-1x));
    right: 0;
}

.mj_RoomsControl .mj_HeaderMenu {
    width: min(340px, calc(100vw - 32px));
    gap: 2px;
}

.mj_RoomsMenu .mj_RoomsMenu_item {
    display: flex;
    min-height: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 2px;
    background: transparent;
    padding: 6px var(--mj-space-2x);
    text-align: left;
}

.mj_RoomsMenu .mj_RoomsMenu_item:hover,
.mj_RoomsMenu .mj_RoomsMenu_item:focus-visible {
    background: var(--mj-color-bg-subtle-secondary);
}

.mj_RoomsMenu_head {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: var(--mj-space-2x);
}

.mj_RoomsMenu .mj_RoomsMenu_dot_running {
    background: var(--mj-color-text-action-accent);
}

.mj_RoomsMenu .mj_RoomsMenu_dot_waiting {
    background: var(--mj-color-usage-medium);
}

.mj_RoomsMenu .mj_RoomsMenu_title {
    flex: 1 1 auto;
    min-width: 0;
    color: var(--mj-color-text-primary);
    font-weight: 600;
    white-space: nowrap;
}

.mj_RoomsMenu_muted {
    flex: none;
    width: 14px;
    height: 14px;
    color: var(--mj-color-icon-secondary);
}

.mj_RoomsMenu .mj_RoomsMenu_time {
    flex: none;
    color: var(--mj-color-text-tertiary);
    font: 400 12px/16px var(--mj-font-family-ui);
}

.mj_RoomsMenu .mj_RoomsMenu_peers {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    padding-left: calc(8px + var(--mj-space-2x));
    color: var(--mj-color-text-secondary);
    font: 400 12px/16px var(--mj-font-family-ui);
}

.mj_RoomsMenu .mj_RoomsMenu_peer,
.mj_RoomsMenu .mj_RoomsMenu_peer span {
    overflow: visible;
}

.mj_NotifyBell .mj_HeaderMenu {
    width: min(260px, calc(100vw - 32px));
    gap: var(--mj-space-2x);
}

.mj_NotifyMenu_group {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.mj_NotifyMenu_group + .mj_NotifyMenu_group {
    border-top: 1px solid var(--mj-color-border-subtle);
    padding-top: var(--mj-space-2x);
}

.mj_NotifyMenu .mj_NotifyMenu_label {
    padding: 0 var(--mj-space-2x) 2px;
    color: var(--mj-color-text-tertiary);
    font: 600 11px/16px var(--mj-font-family-ui);
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.mj_NotifyMenu .mj_NotifyMenu_item {
    display: flex;
    align-items: center;
    gap: var(--mj-space-2x);
    background: transparent;
    padding: 0 var(--mj-space-2x);
    text-align: left;
}

.mj_NotifyMenu .mj_NotifyMenu_item:hover,
.mj_NotifyMenu .mj_NotifyMenu_item:focus-visible {
    background: var(--mj-color-bg-subtle-secondary);
}

.mj_NotifyMenu_check {
    display: inline-flex;
    width: 14px;
    flex: none;
    color: var(--mj-color-text-action-accent);
}

.mj_NotifyMenu_error {
    margin: 0;
    color: var(--mj-color-text-critical-primary);
    font: 400 12px/16px var(--mj-font-family-ui);
}

/* A narrow header folds Rooms and the bell into the "⋯" menu, above the actions. */
.mj_HeaderMenu.mj_ConversationMenu_withSections {
    width: min(320px, calc(100vw - var(--mj-space-4x)));
}

.mj_OverflowSection {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 4px 0;
}

.mj_OverflowSection .mj_OverflowSection_label {
    padding: 0 var(--mj-space-2x) 2px;
    color: var(--mj-color-text-tertiary);
    font: 600 11px/16px var(--mj-font-family-ui);
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.mj_OverflowSection_separator {
    flex: none;
    height: 1px;
    margin: 4px 0;
    background: var(--mj-color-border-subtle);
}

.mj_CompactButton.mj_CompactButton_iconOnly {
    width: 28px;
    padding: 0;
}

/* Session run-state in the subtitle — teal while running (v3 mock), muted otherwise. */
.mj_HeaderState {
    color: var(--mj-color-text-secondary);
}

.mj_HeaderState_running {
    color: var(--mj-color-text-action-accent);
}

.mj_SubagentSwitcherButton:focus-visible {
    border-radius: var(--mj-radius-xs);
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

.mj_SubagentSwitcherMenu button:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset-field);
}

.mj_UsageCluster {
    display: flex;
    /* Content-width: 4 bars → 2 columns (~350px), 6 bars (host cpu/ram) → 3 columns
       (~500px). The full grid only renders when the pane is wide enough to hold it — see
       useAdaptiveHeader's meter-count-aware collapse threshold — so it never gets squeezed
       into a horizontal scroll; below the threshold it collapses to the ctx+5h popover. */
    width: auto;
    max-width: 100%;
    min-width: 0;
    height: 64px;
    /* Centre the 2×2 grid vertically so its centre lands on the band centre — which is
       where the Compact pill centres too (operator: bars-centre == Compact-middle). */
    align-items: center;
    /* flush the bar cluster RIGHT against the divider so the gap left-of-divider
       (bars→divider = HeaderControls' 12px flex gap) matches the gap divider→Compact
       (also the 12px flex gap). Default flex-start left the reserved 300px cluster's
       bars floating far from the separator. */
    justify-content: flex-end;
    padding-block: var(--mj-space-1x);
}

.mj_UsageBars {
    /* Default single-column (used by the collapsed popover). */
    display: grid;
    gap: var(--mj-space-1x);
}

.mj_UsageCluster .mj_UsageBars {
    /* Column-first fill, 2 rows: cpu/ram | ctx/5h | fbl/wk (host-vitals-first). Columns size to their
       content (grid-auto-columns: max-content) so the cluster stays exactly as wide as the
       bars it holds — no reserved empty column. column-gap 16. row-gap 10 makes the two-row
       block 36px tall = the title+subtitle block, so tops/bottoms line up. */
    grid-template-rows: auto auto;
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    column-gap: 16px;
    row-gap: 10px;
    max-height: 100%;
    /* Scroll (not clip) any set that outgrows the pane — the >4-meter collapse threshold
       widens for host cpu/ram but the SAME threshold expands larger sets too, so a 12-limit
       frame must stay reachable via x-scroll rather than being clipped off-pane. The common
       6-bar case (~507px) fits the pane, so `auto` shows no scrollbar. y stays hidden so a
       horizontal bar never steals a vertical one. */
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior: contain;
}

.mj_UsageRow {
    /* v4 mock: label(24) / track / percent(32), gap 7, Fira Code. Fixed 68px track (columns
       are content-sized now, so a 1fr track would collapse to its 40px min). */
    display: grid;
    grid-template-columns: 24px 68px 32px;
    align-items: center;
    column-gap: 7px;
    font-family: var(--mj-font-family-mono);
    font-size: 10.5px;
    line-height: 13px;
}

.mj_UsageLabel,
.mj_UsagePercent {
    overflow: hidden;
    /* Non-ctx meters: 400 + secondary. */
    color: var(--mj-color-text-secondary);
    font-weight: 400;
    white-space: nowrap;
}

.mj_UsageLabel {
    text-align: right;
    text-overflow: ellipsis;
}

.mj_UsagePercent {
    text-align: right;
}

/* Reset time trailing a limit's bar ("3h20", "Thu 9am"), quieter than the percent. Rows
   without a reset (ctx, host vitals) simply end at the percent. */
.mj_UsageReset {
    color: var(--mj-color-text-tertiary);
    white-space: nowrap;
}

.mj_UsageRow:has(.mj_UsageReset) {
    grid-template-columns: 24px 68px 32px auto;
}

.mj_UsageTrack {
    display: block;
    width: 100%;
    height: 4px; /* v4 mock track height */
    overflow: hidden;
    border-radius: var(--mj-radius-pill);
    background-color: var(--mj-color-bg-usage-track);
}

.mj_UsageFill {
    display: block;
    height: 100%;
    border-radius: inherit;
}

.mj_UsageFill_low {
    background-color: var(--mj-color-usage-low);
}

.mj_UsageFill_medium {
    background-color: var(--mj-color-usage-medium);
}

.mj_UsageFill_unknown {
    background: repeating-linear-gradient(
        135deg,
        var(--mj-color-bg-usage-track) 0,
        var(--mj-color-bg-usage-track) var(--mj-space-1x),
        var(--mj-color-border-interactive-primary) var(--mj-space-1x),
        var(--mj-color-border-interactive-primary) var(--mj-space-2x)
    );
}

.mj_UsagePercent_unknown {
    color: var(--mj-color-text-secondary);
}

/* Stale host vitals (host_cpu/host_ram whose `sampled_at_ms` is past HOST_VITALS_STALE_MS):
   dim the whole row so the value reads as "not live" rather than misleadingly current. Only
   opacity — no layout shift, keeps the bar in place, and desaturates label + track + fill +
   percent together in one subtle move (0.45 matches the disabled-control opacity used
   elsewhere). The real age is exposed via the accessible name + hover title. */
.mj_UsageRow_stale {
    opacity: 0.45;
}

/* Header disclosures (collapsed usage <760, title <560): trigger + hover popover
   wrapped together so the mouse can travel into the panel without dismissing. */
.mj_HeaderUsageDisclosure {
    position: relative;
    display: flex;
    align-items: center;
}

/* Collapsed usage = a two-row ctx+5h stack, as a bare hover/click trigger. Single
   content-width column (not the 2×2's reserved 300px) so it sits tight against the
   divider + Compact — only padding between the two bars and the separator. */
.mj_UsageCluster_collapsed {
    width: auto;
    height: auto;
    padding: var(--mj-space-1x) var(--mj-space-2x);
    border: 0;
    border-radius: var(--mj-radius-card);
    background: transparent;
    color: inherit;
    cursor: pointer;
}

.mj_UsageCluster_collapsed .mj_UsageBars {
    grid-template-columns: auto;
}

.mj_UsageCluster_collapsed .mj_UsageRow {
    grid-template-columns: 24px 72px 32px;
}

/* The collapsed ctx+5h stack is what a narrow pane and a phone get: a reset time there
   would come out of the title's width. Its popover lists every reset. */
.mj_UsageCluster_collapsed .mj_UsageReset {
    display: none;
}

.mj_UsageCluster_collapsed:hover {
    background: var(--mj-color-bg-subtle-secondary);
}

.mj_UsageCluster_collapsed:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

.mj_UsagePopover {
    top: calc(100% + var(--mj-space-1x));
    right: 0;
    width: 300px;
}

.mj_UsagePopover .mj_UsageRow {
    grid-template-columns: 28px 1fr 40px 64px;
    font-size: 11px;
    line-height: 16px;
}

/* Compact title block (<560): title + status-dot/short-model, hover → popover. */
.mj_HeaderTitleCluster_compact {
    position: relative;
    gap: 2px;
    padding: 0;
}

/* <560 title disclosure: the h1 (before) sits on top; this focusable trigger
   (compact subtitle + chevron) below opens a popover with the full title +
   subtitle. Stacked, not side-by-side, so the title doesn't get squeezed. */
.mj_HeaderTitleDisclosure {
    display: inline-flex;
    min-width: 0;
    max-width: 100%;
    align-items: center;
    gap: var(--mj-space-1x);
    padding: 0;
    border: 0;
    border-radius: var(--mj-radius-md);
    background: transparent;
    color: var(--mj-color-text-tertiary);
    cursor: pointer;
}

.mj_HeaderTitleDisclosure:hover {
    background: var(--mj-color-bg-subtle-secondary);
}

.mj_HeaderTitleDisclosure:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

.mj_HeaderTitleDisclosure svg {
    width: 14px;
    height: 14px;
    flex: none;
}

.mj_TitlePopover {
    top: calc(100% + var(--mj-space-1x));
    left: 0;
    width: max-content;
    max-width: min(320px, calc(100vw - 32px));
}

/* The popover is where a narrow pane shows the whole subtitle: wrap the segments onto
   further lines rather than truncating them all. */
.mj_TitlePopover .mj_HeaderMeta {
    flex-wrap: wrap;
}

.mj_TitlePopover .mj_HeaderMeta > *,
.mj_TitlePopover .mj_HeaderMeta .mj_HeaderWorkdir,
.mj_TitlePopover .mj_HeaderMeta .mj_HeaderEmail {
    max-width: 100%;
    flex: 0 0 auto;
}

.mj_TitlePopoverTitle {
    font: var(--mj-font-heading-sm-semibold);
    font-size: 13px;
    font-weight: 600;
    line-height: 17px;
    color: var(--mj-color-text-primary);
}

/* Visually hidden but exposed to assistive tech (e.g. compact run-state). */
.mj_SrOnly {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
}

/* Compact subtitle: status dot + short model name. */
.mj_HeaderMetaCompact {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: var(--mj-space-1x);
    color: var(--mj-color-text-secondary);
    font-size: 11px;
    font-weight: 400;
    line-height: 14px;
}

.mj_HeaderModelShort {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_HeaderStatusDot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mj-color-border-strong);
}

.mj_HeaderStatusDot_running {
    background: var(--mj-color-text-action-accent);
    animation: mj-pulse 1.6s ease-in-out infinite;
}

@keyframes mj-pulse {
    0%,
    100% {
        opacity: 1;
    }
    50% {
        opacity: 0.35;
    }
}

/*
 * The resizable sidebar can make the room much narrower than the viewport.
 * Below 720px the right controls have collapsed usage (usageCollapsed at 700px),
 * so just tighten the header gap/padding — the title stays flush-left.
 */
@container mj-chat (max-width: 720px) {
    .mj_ChatHeader {
        gap: var(--mj-space-2x);
        padding-inline: var(--mj-space-3x);
    }
}

.mj_UsageFill_high {
    background-color: var(--mj-color-usage-high);
}

.mj_BackButton {
    display: none;
    width: var(--mj-control-h);
    height: var(--mj-control-h);
    align-items: center;
    justify-content: center;
    padding: 4px;
    border: 0;
    border-radius: var(--mj-radius-md);
    background: transparent;
    color: var(--mj-color-icon-secondary);
}

.mj_BackButton svg {
    width: 20px;
    height: 20px;
}

.mj_HeaderMenu {
    position: absolute;
    z-index: 1000;
    display: flex;
    width: min(280px, calc(100vw - 32px));
    max-height: min(60vh, 420px);
    overflow-y: auto;
    overscroll-behavior: contain;
    flex-direction: column;
    gap: var(--mj-space-2x);
    box-sizing: border-box;
    border: 1px solid var(--mj-color-border-disabled);
    border-radius: var(--mj-radius-popover);
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-md);
    color: var(--mj-color-text-primary);
    padding: var(--mj-space-3x);
    font: var(--mj-font-body-sm-regular);
}

.mj_HeaderMenu span {
    overflow: hidden;
    color: var(--mj-color-text-secondary);
    text-overflow: ellipsis;
}

.mj_HeaderMenu button {
    min-height: var(--mj-control-h);
    border: 0;
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-subtle-secondary);
    color: var(--mj-color-text-primary);
    cursor: pointer;
}

/* §10.11: non-scrolling row — [pinned back chip] · [hairline] · [scrolling pill run].
   Only .mj_SubagentStrip_run scrolls; the escape stays pinned. */
/* Large-conversation nudge under the header: an inset red card, as on the Mac (same
   attention vocabulary as the offline banner); the whole strip sends /compact. */
.mj_CompactNudge {
    display: flex;
    min-width: 0;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--mj-space-2x);
    margin: var(--mj-space-2x) 14px 0;
    padding: var(--mj-space-2x) var(--mj-space-3x);
    border: 0;
    border-radius: 8px;
    background: color-mix(in srgb, var(--mj-color-text-critical-primary) 92%, transparent);
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 13px;
    line-height: 18px;
    text-align: start;
}

[data-theme="dark"] .mj_CompactNudge {
    background: color-mix(in srgb, var(--mj-color-text-critical-primary) 62%, black);
}

.mj_CompactNudge:hover {
    filter: brightness(1.08);
}

.mj_CompactNudge:focus-visible {
    outline: 2px solid var(--mj-color-text-action-accent);
    outline-offset: 2px;
}

.mj_CompactNudge[aria-busy="true"] {
    cursor: progress;
    opacity: 0.8;
}

/* The title may truncate on a narrow pane; the trailing action never does. */
.mj_CompactNudge_title {
    min-width: 0;
    flex: 1 1 auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_CompactNudge_action {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--mj-space-1x);
}

.mj_CompactNudge_action svg {
    width: 12px;
    height: 12px;
}

/* §10.11: non-scrolling row — [pinned back chip] · [hairline] · [scrolling pill run].
   Only .mj_SubagentStrip_run scrolls; the escape stays pinned. */
.mj_SubagentStrip {
    display: flex;
    min-width: 0;
    flex: 0 0 auto;
    align-items: center;
    gap: 0;
    border-bottom: 1px solid var(--mj-color-border-disabled);
    background: var(--mj-color-bg-canvas-default);
    padding: 10px 14px 7px 14px;
}

/* The scrolling sibling run: pills flow horizontally and scroll; the label leads.
   reserve padding-bottom so the horizontal scrollbar (when the pills
   overflow) clears the pill row instead of sitting cramped against it. */
.mj_SubagentStrip_run {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    align-items: center;
    gap: var(--mj-space-2x);
    overflow-x: auto;
    padding-bottom: var(--mj-space-2x);
    scrollbar-width: thin;
    scrollbar-color: var(--mj-scrollbar) transparent;
}

/* Back chip: same pill geometry, DIFFERENT ink — accent on selected bg + left chevron.
   It names its destination (parent title, ellipsised, max 220px). §10.11. */
.mj_SubagentBack {
    display: inline-flex;
    max-width: 220px;
    height: var(--mj-control-h-sm);
    flex: 0 0 auto;
    align-items: center;
    gap: 6px;
    margin-right: 10px;
    border: 1px solid var(--mj-color-border-accent);
    border-radius: 999px;
    background: var(--mj-state-selected);
    color: var(--mj-color-text-action-accent);
    padding: 0 11px 0 8px;
    font: 500 12px/16px var(--mj-font-family-ui);
    white-space: nowrap;
    cursor: pointer;
}

.mj_SubagentBack_icon {
    width: 13px;
    height: 13px;
    flex: 0 0 auto;
}

.mj_SubagentBack_name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_SubagentBack:hover {
    filter: brightness(1.04);
}

.mj_SubagentBack:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

/* Hairline separating the escape from the pill run (§10.7 — a hairline, not a gap). */
.mj_SubagentStrip_hairline {
    width: 1px;
    height: 18px;
    flex: 0 0 auto;
    margin-right: 10px;
    background: var(--mj-color-border-subtle);
}

/* v4 label.caps: 10px / 500 / 14px, uppercase, +0.06em, tertiary ink. */
.mj_SubagentStripLabel {
    flex: none;
    color: var(--mj-color-text-tertiary);
    font-size: 10px;
    font-weight: 500;
    line-height: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.mj_SubagentPill_wrapper {
    display: inline-flex;
}

.mj_SubagentPill {
    display: inline-flex;
    min-height: var(--mj-control-h-sm);
    max-width: min(240px, 70vw);
    flex: 0 0 auto;
    align-items: center;
    gap: var(--mj-space-1x);
    overflow: hidden;
    box-sizing: border-box;
    border: 1px solid var(--mj-color-border-disabled);
    border-radius: var(--mj-radius-pill);
    background: var(--mj-state-selected);
    color: var(--mj-color-text-primary);
    cursor: pointer;
    padding: var(--mj-space-1x) var(--mj-space-3x);
    /* v4 meta.md: 12px / 400 / 16px. */
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_SubagentPill_icon {
    flex: none;
    width: 13px;
    height: 13px;
    color: var(--mj-color-bg-accent);
}

.mj_SubagentPill_name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_SubagentPill:hover {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_SubagentPill:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

.mj_SubagentPill_finished {
    border-color: var(--mj-color-border-subtle);
    background: var(--mj-color-bg-subtle-primary);
    color: var(--mj-color-text-secondary);
}

.mj_SubagentPill_finished .mj_SubagentPill_icon {
    color: var(--mj-color-text-secondary);
}

[data-theme="dark"] .mj_SubagentPill:not(.mj_SubagentPill_finished) .mj_SubagentPill_icon {
    color: var(--mj-color-text-action-accent);
}

/* §10.11: the current pill CONFIRMS which sibling you're in (header carries the primary
   "where am I") — accent border + a 2px selected-tint ring, non-interactive. */
.mj_SubagentPill_current {
    border-color: var(--mj-color-text-action-accent);
    box-shadow: 0 0 0 2px var(--mj-state-selected);
    cursor: default;
}

/* Spinner: a primary-ink track with an accent arc. With one brand teal for both the accent
   and the button fill, a teal-on-teal ring no longer reads as moving, and codex-pill-contrast
   needs every border at 3:1 on the pill tint, which rules out a pale track. Primary ink keeps
   the arc apart from the track by luminance (2.9:1 in light), not only by hue. */
.mj_Spinner {
    width: 12px;
    height: 12px;
    flex: 0 0 auto;
    box-sizing: border-box;
    border: 2px solid var(--mj-color-text-primary);
    border-top-color: var(--mj-color-text-action-accent);
    border-radius: 50%;
    animation: mj-spin 0.8s linear infinite;
}

/* ============================================================================
   Surface A — Pinned conversation summary (net-new, design 2026-08).
   A collapsible digest strip pinned between the SubagentStrip and the Timeline.
   The bar IS the expand control (aria-expanded/-controls); the body is
   aria-live=polite so a server refresh is announced without stealing focus.
   See GENERATIVE-SYSTEM.md · Surface A.
   ============================================================================ */
.mj_PinnedSummary {
    margin: 8px 20px 12px 20px;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-lg);
    background: var(--mj-summary-raise);
    box-shadow: var(--mj-shadow-sm);
    overflow: hidden;
}

.mj_PinnedSummary_bar {
    display: flex;
    align-items: center;
    gap: var(--mj-space-2x);
    width: 100%;
    border: 0;
    background: transparent;
    padding: 9px 12px;
    text-align: left;
    color: inherit;
    cursor: pointer;
    transition: background var(--mj-dur-fast) var(--mj-ease);
}

.mj_PinnedSummary_bar:hover {
    background: var(--mj-state-hover);
}

.mj_PinnedSummary_bar:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset-inset);
}

.mj_PinnedSummary_pin {
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    color: var(--mj-color-text-action-accent);
}

.mj_PinnedSummary_label {
    flex: 0 0 auto;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mj-color-text-tertiary);
}

.mj_PinnedSummary_lead {
    min-width: 0;
    flex: 1 1 auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--mj-color-text-secondary);
    font-size: 13px;
    line-height: 18px;
}

.mj_PinnedSummary_meta {
    flex: 0 0 auto;
    color: var(--mj-color-text-tertiary);
    font-size: 11px;
    white-space: nowrap;
}

.mj_PinnedSummary_chev {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    color: var(--mj-color-text-tertiary);
    transition: transform var(--mj-dur-med) var(--mj-ease);
}

.mj_PinnedSummary[data-collapsed="true"] .mj_PinnedSummary_chev {
    transform: rotate(-90deg);
}

.mj_PinnedSummary_body {
    padding: 2px 14px 12px 32px;
}

.mj_PinnedSummary_list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.mj_PinnedSummary_item {
    position: relative;
    padding-left: 16px;
    font-size: 14px;
    line-height: 21px;
    color: var(--mj-color-text-primary);
    text-wrap: pretty;
}

.mj_PinnedSummary_item::before {
    content: "•";
    position: absolute;
    left: 2px;
    top: 0;
    color: var(--mj-color-text-action-accent);
}

/* A single over-long bullet clamps to 2 lines with an in-place Expand control. */
.mj_PinnedSummary_item_clamp {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* The 20-bullet cap scrolls the body, not the strip — the timeline stays reachable. */
.mj_PinnedSummary_scroll {
    max-height: 214px;
    overflow-y: auto;
    padding-right: 6px;
    scrollbar-width: thin;
    scrollbar-color: var(--mj-scrollbar) transparent;
}

.mj_PinnedSummary_empty {
    padding: 10px 14px 12px 32px;
    color: var(--mj-color-text-tertiary);
    font-size: 13px;
    line-height: 19px;
}

.mj_PinnedSummary_updating .mj_PinnedSummary_item {
    opacity: 0.5;
}

.mj_PinnedSummary_shimmer {
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--mj-color-text-action-accent), transparent);
    background-size: 180px 100%;
    animation: mj-shimmer 1.1s linear infinite;
}

.mj_PinnedSummary_status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--mj-color-text-action-accent);
    font-size: 11px;
    font-weight: 500;
}

.mj_PinnedSummary_more {
    margin-top: 4px;
    border: 0;
    background: transparent;
    color: var(--mj-color-text-action-accent);
    font-size: 12px;
    font-weight: 500;
    padding: 2px 0;
    cursor: pointer;
}

.mj_PinnedSummary_more:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
}

.mj_ConversationListItem_wrapper {
    position: relative;
    /* Rows scrolled out of view skip style, layout and paint, so a sidebar of a thousand
       conversations costs about what the visible rows cost. `auto` keeps each row's real
       height once it has been laid out. */
    content-visibility: auto;
    contain-intrinsic-size: auto 52px;
    /* content-visibility clips painting at the row's edge; leave room for the focus ring. */
    overflow-clip-margin: 4px;
}

/* Row-menu trigger: invisible + non-interactive for pointer users (who open the menu via
   right-click / long-press), so the sidebar stays clean; it appears and becomes operable
   only on keyboard focus, preserving a discoverable route for keyboard/AT users. */
.mj_ConversationMenu_trigger {
    position: absolute;
    top: 50%;
    right: var(--mj-space-3x);
    display: inline-flex;
    width: 28px;
    height: var(--mj-control-h-sm);
    align-items: center;
    justify-content: center;
    padding: 0;
    transform: translateY(-50%);
    border: 0;
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-canvas-default);
    color: var(--mj-color-icon-secondary);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
}

.mj_ConversationMenu_trigger:focus-visible {
    opacity: 1;
    pointer-events: auto;
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset-inset);
}

.mj_ConversationMenu_trigger svg {
    width: 20px;
    height: 20px;
}
/* The trigger floats on an opaque chip over the row, so hover darkens the chip rather than
   swapping it for a translucent layer the row's selected tint would show through. */
.mj_ConversationMenu_trigger:hover {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_ConversationListTabs {
    /* No top margin (the New session row provides the gap); 12px below = uniform gap. */
    margin: 0 var(--mj-space-3x) 12px;
    /* v4: segmented control on a subtle track; the active tab is a raised chip. */
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-bg-subtle-secondary);
    padding: 2px;
}

.mj_ConversationListTab {
    display: inline-flex;
    flex: 1 1 0;
    min-width: 0;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 0;
    border-radius: var(--mj-radius-pill);
    background: transparent;
    color: var(--mj-color-text-secondary);
    cursor: pointer;
    overflow: hidden;
    /* v5 mock: 5px/8px so the pill row reads at the mock's height. */
    padding: 5px var(--mj-space-2x);
    /* v4 label.xs (tabs): 12px / 500 / 16px. */
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition:
        background var(--mj-dur-fast) var(--mj-ease),
        color var(--mj-dur-fast) var(--mj-ease);
}

.mj_ConversationListTab:hover {
    color: var(--mj-color-text-primary);
}

/* v4 selected tab: raised panel chip with a subtle shadow + primary ink. */
.mj_ConversationListTab_active,
.mj_ConversationListTab_active:hover {
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-sm);
    color: var(--mj-color-text-primary);
}

.mj_ConversationListTab:focus-visible {
    outline: 2px solid var(--mj-color-border-interactive-primary);
}

.mj_UnreadDot {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--mj-color-icon-accent-primary);
}

.mj_ConversationListPinGlyph,
.mj_ConversationListStarGlyph {
    flex: 0 0 auto;
    color: var(--mj-color-icon-secondary);
}

.mj_ConversationListPinGlyph svg,
.mj_ConversationListStarGlyph svg {
    width: 14px;
    height: 14px;
}

/* Journal pin rows: the pin's emoji (or its label's first letter) leads in a fixed 18px cell. */
.mj_PinGlyph {
    display: inline-flex;
    width: 18px;
    justify-content: center;
    color: var(--mj-color-text-secondary);
    font: 600 13px/18px var(--mj-font-family-ui);
}

/* A pin whose conversation is gone: greyed, with only Move pin… / Unpin. */
.mj_PinRow_missing .mj_ConversationListItem {
    cursor: default;
    opacity: 0.55;
}

.mj_PinRow_actions {
    display: flex;
    gap: var(--mj-space-1x);
    padding: 0 var(--mj-space-3x) var(--mj-space-1x) 38px;
}

.mj_PinRow_actions button {
    border: 0;
    border-radius: 6px;
    background: var(--mj-color-bg-subtle-secondary);
    color: var(--mj-color-text-primary);
    cursor: pointer;
    padding: 2px 8px;
    font: 500 12px/16px var(--mj-font-family-ui);
}

.mj_PinRow_actions button:hover {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_PinRow_actions button:focus-visible {
    outline: 2px solid var(--mj-color-text-action-accent);
    outline-offset: 1px;
}

/* "New session on <box> — move pin here?" under its pin row. */
.mj_PinSuccessor {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-bottom: var(--mj-space-1x);
}

.mj_PinSuccessor_text {
    padding: 0 var(--mj-space-3x) 0 38px;
    color: var(--mj-color-text-secondary);
    font: 400 12px/16px var(--mj-font-family-ui);
}

.mj_PinSuccessor .mj_PinRow_actions {
    padding-bottom: 0;
}

.mj_PinSheet_list {
    max-height: 40vh;
    overflow-y: auto;
}

/* The Move pin sheet's box filter: the conversation list's segmented control, without the
   sidebar's margins, and wrapping (each box at its natural width) when a fleet has many boxes. */
.mj_PinSheet_boxes {
    flex-wrap: wrap;
    margin: 0;
}

.mj_PinSheet_boxes .mj_ConversationListTab {
    flex: 1 0 auto;
    max-width: 100%;
}

/* §10.6 conversation-actions menu (one component, sidebar-row + header ⋯ anchors): a
   4px-padded shell, rows are grid 16px/1fr @10px gap, row radius (7) < shell radius (10)
   so the hover fill insets from the shell edge, and the destructive Archive is split off
   by a hairline (not a gap). Focus is the teal ring inset −2px, never browser-blue. */
.mj_ConversationMenu {
    width: min(224px, calc(100vw - var(--mj-space-4x)));
    max-height: calc(100vh - var(--mj-space-4x));
    gap: 0;
    border-radius: var(--mj-radius-popover);
    padding: 4px;
    overflow-y: auto;
}

.mj_EventRowMenu {
    width: min(224px, calc(100vw - var(--mj-space-4x)));
    gap: 0;
    border-radius: var(--mj-radius-popover);
    padding: 4px;
}

.mj_ConversationMenu_item {
    display: grid;
    width: 100%;
    grid-template-columns: var(--mj-menu-icon) 1fr;
    align-items: center;
    gap: var(--mj-menu-icon-gap);
    border-radius: var(--mj-radius-md);
    padding: 7px 8px;
    text-align: left;
    font: 500 12.5px/16px var(--mj-font-family-ui);
}

/* item buttons ride the panel surface directly. The generic
   `.mj_HeaderMenu button` rule (specificity 0,1,1) paints a subtle-secondary
   pill; suppress it here so the menu reads as ONE surface (panel) instead of a
   tinted pill layered on white/dark. Hover/focus below supply the only tint.
   This 0,2,0 override beats `.mj_HeaderMenu button` at rest, and is placed
   BEFORE :hover/:focus-visible (also 0,2,0) so those still win on interaction. */
.mj_HeaderMenu .mj_ConversationMenu_item {
    background: transparent;
}

.mj_ConversationMenu_item:hover {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_ConversationMenu_item:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset-inset);
    background: var(--mj-color-bg-subtle-primary);
}

.mj_ConversationMenu_item svg {
    width: var(--mj-menu-icon);
    height: var(--mj-menu-icon);
    flex: 0 0 auto;
    color: var(--mj-color-icon-secondary);
}

/* A group break (Archive, Sign out, View source): its own full-bleed 1px hairline with equal
   space above and below. It used to be a border-top on the last row, which drew the row's rounded
   corners as a curved edge and made that row taller than the rest. The negative inline margin
   runs it through the menu's own padding, edge to edge. */
.mj_MenuSeparator {
    flex: none;
    height: 1px;
    margin: 4px -4px;
    background: var(--mj-color-border-subtle);
}

/* Archive/Unarchive is the destructive group — a hairline above it, not a gap. */
.mj_ConversationMenu_item:last-child:not(:only-child) {
    margin-top: 4px;
    border-top: 1px solid var(--mj-color-border-subtle);
    padding-top: 8px;
}

.mj_MarkAllReadButton {
    color: var(--mj-color-text-action-accent);
}

/* Timeline day divider: a centred dated label flanked by hairline rules, once per calendar
   day (design *-upload-first). */
.mj_DateDivider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 4px 0 14px;
    padding: 0;
    list-style: none;
}

.mj_DateDivider_rule {
    flex: 1 1 0;
    height: 1px;
    background: var(--mj-color-border-subtle);
}

.mj_DateDivider_label {
    flex: 0 0 auto;
    color: var(--mj-color-text-tertiary);
    font: 500 11px/14px var(--mj-font-family-ui);
}

.mj_ChatView_messageList {
    min-height: 100%;
}

.mj_JumpToBottom {
    position: absolute;
    z-index: 2;
    right: var(--mj-space-4x);
    bottom: var(--mj-space-4x);
    display: inline-flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-float);
    color: var(--mj-color-text-action-accent);
    cursor: pointer;
    font-size: var(--mj-font-size-lg);
    line-height: 1;
}

.mj_JumpToBottom:hover {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_JumpToBottom:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

.mj_JumpToLatest {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: var(--mj-space-4x);
    transform: translateX(-50%);
    padding: var(--mj-space-2x) var(--mj-space-3x);
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-bg-canvas-default);
    box-shadow: 0 2px 8px rgb(15 23 42 / 18%);
    color: var(--mj-color-text-action-accent);
    cursor: pointer;
    font: var(--mj-font-body-xs-semibold);
}

.mj_JumpToLatest:hover {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_JumpToLatest:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

.mj_EventRow_searchHighlighted {
    background: var(--mj-color-bg-subtle-primary);
}

/* Find in chat: a strip over the timeline, under the header and subagent strip. */
.mj_FindInChat {
    display: flex;
    min-width: 0;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--mj-space-2x);
    border-bottom: 1px solid var(--mj-color-border-disabled);
    background: var(--mj-color-bg-canvas-default);
    padding: 6px 14px;
}

.mj_FindInChat_glyph {
    flex: 0 0 auto;
    color: var(--mj-color-icon-secondary);
}

.mj_FindInChat_input {
    min-width: 0;
    flex: 1 1 auto;
    border: 0;
    background: transparent;
    color: var(--mj-color-text-primary);
    font: inherit;
    /* The sidebar search field's size. */
    font-size: 13px;
    outline: none;
    padding: 4px 0;
}

.mj_FindInChat_input::placeholder {
    color: var(--mj-color-text-placeholder);
}

.mj_FindInChat_position {
    min-width: 72px;
    flex: 0 0 auto;
    color: var(--mj-color-text-secondary);
    font-size: var(--mj-font-size-xs);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
}

.mj_FindInChat_button {
    display: inline-flex;
    width: 28px;
    height: 28px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--mj-color-text-primary);
    cursor: pointer;
    font-size: var(--mj-font-size-md);
}

.mj_FindInChat_button:hover:not(:disabled) {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_FindInChat_button:disabled {
    color: var(--mj-color-icon-tertiary);
    cursor: default;
}

.mj_FindInChat_button:focus-visible {
    outline: 2px solid var(--mj-color-icon-accent-primary);
    outline-offset: 1px;
}

/* Floating Stop control: the Jump-to-bottom pill's shape and tint, on the opposite
   end of the same trailing edge. */
.mj_StopTurn {
    position: absolute;
    z-index: 2;
    top: var(--mj-space-2x);
    right: var(--mj-space-4x);
    display: inline-flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-float);
    color: var(--mj-color-text-primary);
    cursor: pointer;
}

.mj_StopTurn svg {
    width: 18px;
    height: 18px;
}

.mj_StopTurn:hover {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_StopTurn:focus-visible {
    outline: 2px solid var(--mj-color-icon-accent-primary);
    outline-offset: 2px;
}

/* "Jump to my last message": once the reader has scrolled away from the tail. It takes the Stop
   control's slot, or sits just below it while a turn is running, on the same trailing edge. */
.mj_JumpToLastOwn {
    position: absolute;
    z-index: 2;
    top: var(--mj-space-2x);
    right: var(--mj-space-4x);
    display: inline-flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-float);
    color: var(--mj-color-text-primary);
    cursor: pointer;
}

.mj_StopTurn ~ .mj_JumpToLastOwn {
    top: calc(var(--mj-space-2x) * 2 + 36px);
}

.mj_JumpToLastOwn svg {
    width: 18px;
    height: 18px;
}

.mj_JumpToLastOwn:hover {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_JumpToLastOwn:focus-visible {
    outline: 2px solid var(--mj-color-icon-accent-primary);
    outline-offset: 2px;
}

/* The row a jump landed on (a search hit, a milestone, my last message): a tint that fades out. */
.mj_EventTile.mj_EventTile_focused {
    border-radius: var(--mj-radius-bubble);
    animation: mj-focus-flash 2s ease-out forwards;
}

@keyframes mj-focus-flash {
    0%,
    40% {
        background: var(--mj-color-bg-accent-tint);
        box-shadow: 0 0 0 4px var(--mj-color-bg-accent-tint);
    }
    100% {
        background: transparent;
        box-shadow: 0 0 0 4px transparent;
    }
}

@media (prefers-reduced-motion: reduce) {
    .mj_PinnedSummary_shimmer {
        animation: none;
    }
    .mj_EventTile.mj_EventTile_focused {
        animation: none;
        background: var(--mj-color-bg-accent-tint);
        box-shadow: 0 0 0 4px var(--mj-color-bg-accent-tint);
    }
}

.mj_EventTile[data-layout="bubble"] .mj_EventTile_line > a {
    color: inherit;
    text-decoration: none;
}

.mj_EventTile[data-layout="bubble"] .mj_MessageTimestamp {
    color: var(--mj-color-text-secondary);
    font-size: var(--mj-font-size-2xs);
}

/* Self-bubble is a distinct surface: dark #123530 + secondary #9a948b = 4.43:1
   (just under AA 4.5 for the 10px timestamp). Use primary on the self bubble so
   it clears AA on both bubble themes (final-review r3 B3). */
.mj_EventTile[data-self="true"] .mj_MessageTimestamp {
    color: var(--mj-color-text-primary);
    opacity: 0.75;
}

.mj_MessageText {
    min-width: 0;
    /* Readability measure: ~75ch at the 15px root (Refactoring UI 45-75ch band). Fixed px, not
       ch/em — ch drifts with the resolved font, and on a wide monitor an uncapped bubble runs
       to ~140ch. Code/diff children carry their own wider max and let the bubble grow past this. */
    max-width: 640px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}

.mj_Markdown {
    min-width: 0;
    /* v5: prose shares the uniform agent content width. */
    max-width: var(--mj-content-width);
    white-space: normal;
    overflow-wrap: anywhere;
}

.mj_Markdown p {
    margin: var(--mj-space-3x) 0;
}

.mj_Markdown p:first-child {
    margin-top: 0;
}

.mj_Markdown p:last-child {
    margin-bottom: 0;
}

.mj_Markdown_streaming > p:nth-last-child(2),
.mj_Markdown_streaming > .mj_MarkdownRaw:nth-last-child(2) {
    display: inline;
    margin-bottom: 0;
}

.mj_Markdown ul,
.mj_Markdown ol {
    margin: var(--mj-space-3x) 0;
    padding-left: var(--mj-space-5x);
}

.mj_Markdown li {
    margin: var(--mj-space-1x) 0;
}

.mj_Markdown h1,
.mj_Markdown h2,
.mj_Markdown h3,
.mj_Markdown h4,
.mj_Markdown h5,
.mj_Markdown h6 {
    margin: var(--mj-space-5x) 0 var(--mj-space-2x);
    color: var(--mj-color-text-primary);
    font-weight: 600;
}

.mj_Markdown h1,
.mj_Markdown h2 {
    font: var(--mj-font-body-md-regular);
    font-weight: 600;
}

.mj_Markdown h3,
.mj_Markdown h4 {
    font: var(--mj-font-body-sm-regular);
    font-weight: 600;
}

.mj_Markdown h5,
.mj_Markdown h6 {
    font: var(--mj-font-body-xs-semibold);
}

.mj_Markdown blockquote {
    margin: var(--mj-space-3x) 0;
    border-left: var(--mj-space-1x) solid var(--mj-color-border-interactive-secondary);
    padding-left: var(--mj-space-3x);
    color: var(--mj-color-text-secondary);
}

.mj_Markdown table {
    width: 100%;
    margin: var(--mj-space-3x) 0;
    border-collapse: collapse;
}

.mj_Markdown th,
.mj_Markdown td {
    border: 1px solid var(--mj-color-border-disabled);
    padding: var(--mj-space-2x) var(--mj-space-3x);
    text-align: left;
}

.mj_Markdown th {
    background: var(--mj-color-bg-subtle-primary);
    color: var(--mj-color-text-primary);
    font: var(--mj-font-body-sm-regular);
    font-weight: 600;
}

.mj_Markdown hr {
    margin: var(--mj-space-4x) 0;
    border: 0;
    border-top: 1px solid var(--mj-color-border-disabled);
}

.mj_Markdown a {
    color: var(--mj-color-text-action-accent);
}

.mj_Markdown a:hover {
    text-decoration: underline;
}

.mj_Markdown .contains-task-list {
    padding-left: 0;
    list-style: none;
}

.mj_Markdown .task-list-item {
    list-style: none;
}

.mj_Markdown .task-list-item input[type="checkbox"] {
    margin: 0 var(--mj-space-2x) 0 0;
    accent-color: var(--mj-color-icon-accent-primary);
}

.mj_InlineCode {
    border-radius: var(--mj-radius-xs);
    background: var(--mj-color-bg-subtle-secondary);
    padding: 1px var(--mj-space-1x);
    font-family: var(--mj-font-family-mono);
    font-size: 0.9em;
}

.mj_MarkdownRaw {
    white-space: pre-wrap;
}

.mj_CodeBlock {
    position: relative;
    /* v5: fills the shared content width; long lines scroll inside. */
    max-width: 100%;
    max-height: 360px;
    overflow: auto;
    box-sizing: border-box;
    margin: var(--mj-space-3x) 0;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-code);
    background: var(--mj-color-bg-canvas-default);
    padding: 0;
    /* v5: 13px/20px — the 12px code read too small in the wide code window. */
    font: 400 12px/16px var(--mj-font-family-mono);
}

.mj_CodeBlock_header {
    position: sticky;
    z-index: 1;
    top: 0;
    left: 0;
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    border-bottom: 1px solid var(--mj-color-border-subtle);
    background: var(--mj-color-bg-canvas-raised);
    /* v5 mock code header: 6px/12px. */
    padding: 6px var(--mj-space-3x);
    opacity: 1;
}

.mj_CodeBlock_copy,
.mj_CodeBlock_lang {
    border: 0;
    background: transparent;
    /* Secondary (not tertiary) so the 11px label clears WCAG AA on the raised header. */
    color: var(--mj-color-text-secondary);
    padding: 0;
    opacity: 1;
}

/* v5: filename/lang label in mono; copy control in Inter. */
.mj_CodeBlock_lang {
    pointer-events: none;
    font: 400 11px/16px var(--mj-font-family-mono);
}

.mj_CodeBlock_copy {
    font: 400 11px/14px var(--mj-font-family-ui);
}

.mj_CodeBlock_copy {
    margin-left: auto;
    cursor: pointer;
}

.mj_CodeBlock > code {
    display: block;
    width: max-content;
    min-width: 100%;
    box-sizing: border-box;
    padding: var(--mj-space-3x);
}

.mj_CodeBlock_copy:hover {
    color: var(--mj-color-text-action-accent);
}

.mj_CodeBlock_copy:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset-field);
}

.hljs {
    background: transparent;
    color: var(--mj-color-text-primary);
}

.hljs-keyword,
.hljs-selector-tag,
.hljs-type,
.hljs-built_in {
    color: var(--mj-color-text-action-accent);
}

.hljs-string,
.hljs-attr,
.hljs-symbol,
.hljs-bullet {
    color: var(--mj-color-text-link-external);
}

.hljs-comment,
.hljs-quote,
.hljs-meta {
    color: var(--mj-color-text-secondary);
}

.hljs-number,
.hljs-literal,
.hljs-regexp {
    color: var(--mj-color-text-critical-primary);
}

.hljs-title,
.hljs-section,
.hljs-name {
    color: var(--mj-color-text-primary);
    font-weight: 600;
}

[data-theme="dark"] .hljs {
    background: transparent;
    color: var(--mj-color-text-primary);
}

[data-theme="dark"] .hljs-keyword,
[data-theme="dark"] .hljs-selector-tag,
[data-theme="dark"] .hljs-type,
[data-theme="dark"] .hljs-built_in {
    color: var(--mj-color-text-action-accent);
}

[data-theme="dark"] .hljs-string,
[data-theme="dark"] .hljs-attr,
[data-theme="dark"] .hljs-symbol,
[data-theme="dark"] .hljs-bullet {
    color: var(--mj-color-text-link-external);
}

[data-theme="dark"] .hljs-comment,
[data-theme="dark"] .hljs-quote,
[data-theme="dark"] .hljs-meta {
    color: var(--mj-color-text-secondary);
}

[data-theme="dark"] .hljs-number,
[data-theme="dark"] .hljs-literal,
[data-theme="dark"] .hljs-regexp {
    color: var(--mj-color-text-critical-primary);
}

[data-theme="dark"] .hljs-title,
[data-theme="dark"] .hljs-section,
[data-theme="dark"] .hljs-name {
    color: var(--mj-color-text-primary);
    font-weight: 600;
}

.mj_SendingLabel {
    float: right;
    margin: 2px 0 0;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-xs-regular);
}

.mj_ChatView_dragActive {
    position: relative;
}

.mj_DragOverlay {
    position: absolute;
    z-index: 10;
    display: flex;
    inset: var(--mj-space-3x);
    align-items: center;
    justify-content: center;
    border: 2px dashed var(--mj-color-icon-accent-primary);
    border-radius: var(--mj-radius-popover);
    background: var(--mj-color-bg-scrim-drag);
    box-shadow: var(--mj-shadow-md);
    color: var(--mj-color-text-action-accent);
    font: var(--mj-font-body-sm-regular);
    font-weight: 600;
    pointer-events: none;
}

.mj_EventSource_scrim {
    position: fixed;
    z-index: 100;
    display: flex;
    inset: 0;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    background: rgb(18 16 14 / 55%);
    padding: 16px;
}

/* §10.8 read-only viewer: header (icon · title · type chip · close) / meta grid + JSON
   well body / footer stating the payload size. Three-part flex; body scrolls, footer stays. */
.mj_EventSource {
    display: flex;
    width: min(720px, 94vw);
    max-height: 88vh;
    flex-direction: column;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-popover);
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-lg);
    color: var(--mj-color-text-primary);
}

.mj_EventSource_header {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid var(--mj-color-border-subtle);
    padding: 13px 14px 13px 16px;
}

.mj_EventSource_headerIcon {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    color: var(--mj-color-icon-secondary);
}

.mj_EventSource_header h2 {
    margin: 0;
    font: 600 14px/19px var(--mj-font-family-ui);
}

.mj_EventSource_typeChip {
    flex: 0 0 auto;
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-bg-subtle-secondary);
    color: var(--mj-color-text-secondary);
    padding: 1px 8px;
    font: 500 11px/16px var(--mj-font-family-mono);
}

.mj_EventSource_headerSpacer {
    flex: 1 1 auto;
}

.mj_EventSource_close {
    display: inline-flex;
    width: 28px;
    height: var(--mj-control-h-sm);
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--mj-radius-sm);
    background: transparent;
    color: var(--mj-color-text-tertiary);
    cursor: pointer;
}

.mj_EventSource_close svg {
    width: 15px;
    height: 15px;
}

.mj_EventSource_close:hover {
    background: var(--mj-state-hover);
    color: var(--mj-color-text-primary);
}

.mj_EventSource_body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 14px;
    min-height: 0;
    overflow-y: auto;
    padding: 14px 16px;
}

/* Meta grid: scalar fields lifted out of the blob (§10.8). */
.mj_EventSource_meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 8px 16px;
}

.mj_EventSource_metaCell {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
}

.mj_EventSource_metaLabel {
    color: var(--mj-color-text-tertiary);
    font: 500 10px/14px var(--mj-font-family-ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.mj_EventSource_metaValue {
    color: var(--mj-color-text-primary);
    font: 400 12px/16px var(--mj-font-family-mono);
}

.mj_EventSource_metaValue_trunc {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* JSON well: one surface rung up (raised), bordered, both-axis themed scroll, height-capped
   so the footer never leaves the viewport (§10.8). */
.mj_EventSource_json {
    max-height: 46vh;
    margin: 0;
    overflow: auto;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-card);
    background: var(--mj-color-bg-canvas-raised);
    padding: 12px;
    color: var(--mj-color-text-primary);
    font: 400 12px/16px var(--mj-font-family-mono);
    user-select: text;
    white-space: pre;
    scrollbar-width: thin;
    scrollbar-color: var(--mj-scrollbar) transparent;
}

.mj_EventSource_footer {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 8px;
    border-top: 1px solid var(--mj-color-border-subtle);
    background: var(--mj-color-bg-canvas-raised);
    padding: 11px 14px;
}

.mj_EventSource_note {
    flex: 1 1 auto;
    color: var(--mj-color-text-tertiary);
    font: 400 11px/14px var(--mj-font-family-ui);
}

.mj_EventSource_secondary {
    height: 32px;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: 8px;
    background: transparent;
    color: var(--mj-color-text-primary);
    padding: 0 14px;
    font: 500 12.5px/16px var(--mj-font-family-ui);
    cursor: pointer;
}

.mj_EventSource_secondary:hover {
    background: var(--mj-state-hover);
}

.mj_EventSource_copy {
    display: inline-flex;
    height: 32px;
    align-items: center;
    gap: 7px;
    border: 0;
    border-radius: 8px;
    background: var(--mj-color-bg-accent);
    color: var(--mj-color-text-on-accent);
    padding: 0 15px;
    font: 600 12.5px/16px var(--mj-font-family-ui);
    cursor: pointer;
}

.mj_EventSource_copy svg {
    width: 13px;
    height: 13px;
}

.mj_EventSource_copy:hover {
    filter: brightness(1.08);
}

.mj_EventSource_secondary:focus-visible,
.mj_EventSource_copy:focus-visible,
.mj_EventSource_close:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

.mj_UploadConfirm_scrim {
    position: fixed;
    /* v4 layering: modal scrim + card sit at 50 (above header popovers at 30). */
    z-index: 50;
    display: flex;
    inset: 0;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    background: rgb(18 16 14 / 55%);
    padding: var(--mj-space-4x);
}

.mj_UploadConfirm {
    display: flex;
    width: min(520px, 92vw);
    max-height: 86vh;
    flex-direction: column;
    gap: var(--mj-space-3x);
    box-sizing: border-box;
    overflow: auto;
    border: 1px solid rgb(28 24 20 / 10%);
    border-radius: var(--mj-radius-popover);
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-lg);
    color: var(--mj-color-text-primary);
    padding: var(--mj-space-5x);
}

/* v4 upload-queue modal: min(440,94vw) · max-h 88vh · radius 14 · shadow-lg,
   three-part flex — fixed header / scrolling body / fixed footer.
   Scoped to the queue variant so the shared new-session + error cards keep their padding. */
.mj_UploadConfirm_queue {
    width: min(440px, 94vw);
    max-height: 88vh;
    gap: 0;
    overflow: hidden;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-popover);
    box-shadow: var(--mj-shadow-lg);
    padding: 0;
}

.mj_UploadConfirm_header {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 10px;
    padding: 13px 14px 13px 16px;
}

/* Tray glyph immediately left of the "Send file" title (design *-upload-* statics). */
.mj_UploadConfirm_uploadIcon {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    color: var(--mj-color-icon-secondary);
}

/* Title sits at natural width so the "n of N" chip hugs it on the left; the spacer below
   pushes the ✕ close to the right edge. */
.mj_UploadConfirm_header .mj_UploadConfirm_title {
    flex: 0 1 auto;
    min-width: 0;
}

.mj_UploadConfirm_headerSpacer {
    flex: 1;
}

/* ✕ close — a 28px ghost button on the header's right edge; dismisses the whole upload. */
.mj_UploadConfirm_close {
    display: inline-flex;
    width: 28px;
    height: var(--mj-control-h-sm);
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--mj-radius-sm);
    background: transparent;
    color: var(--mj-color-icon-tertiary);
    font-size: 15px;
    cursor: pointer;
}

.mj_UploadConfirm_close:hover:not(:disabled) {
    background: var(--mj-color-bg-subtle-primary);
    color: var(--mj-color-text-primary);
}

.mj_UploadConfirm_close:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

.mj_UploadConfirm_close:disabled {
    cursor: default;
    opacity: 0.5;
}

.mj_UploadConfirm_body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: var(--mj-space-3x);
    overflow-y: auto;
    padding: 14px 16px;
}

.mj_UploadConfirm_footer {
    flex: 0 0 auto;
    padding: 11px 14px;
}

.mj_UploadConfirm_title {
    margin: 0;
    overflow-wrap: anywhere;
    /* v4 modal title: 600 14px/19px Inter. */
    font: 600 14px/19px var(--mj-font-family-ui);
}

/* "n of N" chip (multi-file). Borderless to match the design chip. */
.mj_UploadConfirm_count {
    flex: 0 0 auto;
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-bg-subtle-secondary);
    color: var(--mj-color-text-secondary);
    padding: 1px 9px;
    font: 500 11px/16px var(--mj-font-family-mono);
}

/* File-info row under the preview: name (ellipsised) + size on the right. */
.mj_UploadConfirm_fileName {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    color: var(--mj-color-text-primary);
    font: 500 12.5px/16px var(--mj-font-family-ui);
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Preview + file-info are one bordered card (design *-upload-* statics): the preview/
   placeholder fills the top, a hairline divides it from the file-info row below. */
.mj_UploadConfirm_previewCard {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-card);
    background: var(--mj-color-bg-canvas-raised);
}

/* Non-image preview placeholder: diagonal hatch + centered mono "image preview" label. */
.mj_UploadConfirm_previewPlaceholder {
    display: flex;
    height: 150px;
    align-items: center;
    justify-content: center;
    background-color: var(--mj-color-bg-canvas-raised);
    background-image: repeating-linear-gradient(
        45deg,
        var(--mj-color-bg-canvas-raised) 0,
        var(--mj-color-bg-canvas-raised) 4px,
        var(--mj-color-bg-subtle-secondary) 4px,
        var(--mj-color-bg-subtle-secondary) 8px
    );
}

.mj_UploadConfirm_previewPlaceholder span {
    color: var(--mj-color-text-tertiary);
    font: 400 11px/16px var(--mj-font-family-mono);
}

/* 34px thumbnail strip (multi-file): active = 2px teal ring, inactive = 1px line on raised.
   §10.1 — strips SCROLL, they don't wrap: overflow-x on a single nowrap row. */
.mj_UploadConfirm_strip {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--mj-scrollbar) transparent;
}

.mj_UploadThumb {
    display: inline-flex;
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-sm);
    background: var(--mj-color-bg-canvas-raised);
    color: var(--mj-color-icon-secondary);
}

.mj_UploadThumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.mj_UploadThumb svg {
    width: 16px;
    height: 16px;
}

.mj_UploadThumb_active {
    border: 2px solid var(--mj-color-text-action-accent);
}

.mj_UploadConfirm_more {
    color: var(--mj-color-text-secondary);
    font: 400 11px/16px var(--mj-font-family-ui);
}

/* Real image fills the top of the preview card; object-fit keeps aspect, letterboxed on
   the raised card background (no own border/radius — the card clips it). */
.mj_UploadConfirm_preview {
    display: block;
    width: 100%;
    max-height: 50vh;
    background: var(--mj-color-bg-canvas-raised);
    object-fit: contain;
}

/* File-info row: a LIGHT bar under the preview (hairline top, panel bg) — doc icon +
   ellipsised name + right-aligned mono size. NOT a heavy filled card. */
.mj_UploadConfirm_fileMeta {
    display: flex;
    align-items: center;
    gap: 9px;
    border-top: 1px solid var(--mj-color-border-subtle);
    background: var(--mj-color-bg-canvas-default);
    padding: 9px 11px;
}

.mj_UploadConfirm_fileIcon {
    width: 14px;
    height: 14px;
    flex: 0 0 auto;
    color: var(--mj-color-text-action-accent);
}

.mj_UploadConfirm_fileMeta .mj_FileSize {
    flex: 0 0 auto;
    margin-left: 0;
    color: var(--mj-color-text-tertiary);
    font: 400 11px/16px var(--mj-font-family-mono);
}

.mj_UploadConfirm_caption {
    min-height: 60px;
    box-sizing: border-box;
    border: 1px solid var(--mj-color-border-strong);
    border-radius: var(--mj-radius-field);
    background: var(--mj-color-bg-canvas-default);
    padding: var(--mj-space-3x);
    /* v4 modal caption input: body.sm 400 13.5/20. */
    font: 400 13.5px/20px var(--mj-font-family-ui);
    resize: vertical;
}

.mj_UploadConfirm_caption::placeholder {
    color: var(--mj-color-text-tertiary);
}

/* v4 mock (upload-modal-mock.png): the upload caption stays NEUTRAL on focus — no teal.
   It does not accent-tint or ring like the composer input. Because the dialog auto-focuses
   this field on open AND text inputs match :focus-visible on every focus, a teal ring/border
   would make every upload read "active/teal" against the mock's calm neutral. Instead focus
   darkens the border (border-strong → interactive-primary): a visible, neutral focus
   indicator for both pointer and keyboard (the text caret backs it up), no accent. */
.mj_UploadConfirm_caption:focus,
.mj_UploadConfirm_caption:focus-visible {
    border-color: var(--mj-color-border-interactive-primary);
    outline: none;
}

.mj_UploadConfirm_actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--mj-space-2x);
}

.mj_UploadConfirm_actions button {
    border: 1px solid transparent;
    border-radius: var(--mj-radius-md);
    background: transparent;
    /* v4 secondary/ghost button: 500 12.5/16. */
    color: var(--mj-color-text-secondary);
    padding: var(--mj-space-2x) var(--mj-space-4x);
    font: 500 12.5px/16px var(--mj-font-family-ui);
}

/* Skip = outlined secondary (design light-upload-first): a hairline border + primary ink,
   distinct from the ghost "Cancel all". */
.mj_UploadConfirm_actions button.mj_UploadConfirm_skip {
    border-color: var(--mj-color-border-interactive-secondary);
    color: var(--mj-color-text-primary);
}

/* Ghost hover applies only to the secondary buttons — the filled primary (Send) keeps
   its accent background, or the generic rule (more specific than the primary's base
   background) would flip it to near-white and leave white-on-white text on hover. */
.mj_UploadConfirm_actions button:not(.mj_UploadConfirm_send):hover:not(:disabled) {
    background: var(--mj-color-bg-subtle-primary);
    color: var(--mj-color-text-primary);
}

.mj_UploadConfirm_actions button:focus-visible {
    outline: 2px solid var(--mj-color-text-action-accent);
    outline-offset: 2px;
}

.mj_UploadConfirm_actions button:disabled {
    cursor: default;
    opacity: 0.5;
}

/* v4 primary button: filled --m-accent-deep, weight 600, hover brightens (no colour swap).
   Paper-plane glyph + label (design *-upload-* statics). */
.mj_UploadConfirm_actions button.mj_UploadConfirm_send {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding-right: 15px;
    padding-left: 15px;
    background: var(--mj-color-bg-accent);
    color: var(--mj-color-text-on-accent);
    font-weight: 600;
}

.mj_UploadConfirm_actions button.mj_UploadConfirm_send svg {
    width: 13px;
    height: 13px;
    flex: 0 0 auto;
}

.mj_UploadConfirm_actions button.mj_UploadConfirm_send:hover:not(:disabled) {
    filter: brightness(1.08);
    color: var(--mj-color-text-on-accent);
}

.mj_UploadConfirm_error {
    margin: 0;
    color: var(--mj-color-text-critical-primary);
    font: var(--mj-font-body-sm-regular);
}

/* A sheet or pane whose code could not be fetched (deferred-ui.tsx). */
.mj_DeferredFailed {
    margin: 0;
    padding: var(--mj-space-3x);
    color: var(--mj-color-text-critical-primary);
    font: var(--mj-font-body-sm-regular);
}

/* v5 new-session sheet: the upload-dialog shell + a fully themed form. The load-bearing
   fix is §10.4 — the native inputs were unstyled, so they inherited the UA white and
   vanished on dark ("Agent default" white-on-dark). Every input/checkbox/label now sets
   its own themed colours, and each label binds to the field BELOW it at the 6px field
   rhythm (§10.3). */
.mj_NewSessionSheet {
    gap: 14px;
}

.mj_NewSessionSheet_head {
    display: flex;
    align-items: center;
    gap: 10px;
}

.mj_NewSessionSheet_head .mj_UploadConfirm_title {
    flex: 1;
    min-width: 0;
}

.mj_NewSessionSheet_close {
    display: inline-flex;
    width: 28px;
    height: 28px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--mj-color-icon-secondary);
    cursor: pointer;
}

.mj_NewSessionSheet_close:hover {
    background: var(--mj-color-bg-subtle-primary);
    color: var(--mj-color-text-primary);
}

.mj_NewSessionSheet_close:focus-visible {
    outline: 2px solid var(--mj-color-text-action-accent);
    outline-offset: 2px;
}

.mj_NewSessionSheet > p,
.mj_NewSessionSheet [role="status"] {
    margin: 0;
    color: var(--mj-color-text-secondary);
    font: 400 13px/18px var(--mj-font-family-ui);
}

/* A field label binds to the field BELOW it (§10.3 6px). */
.mj_NewSessionSheet label {
    display: block;
    margin-bottom: 6px;
    color: var(--mj-color-text-secondary);
    font: 500 12px/16px var(--mj-font-family-ui);
}

/* §10.4 native text input: explicit background/colour/border in BOTH themes. */
.mj_NewSessionSheet input[type="text"],
.mj_NewSessionSheet input[type="email"],
.mj_NewSessionSheet input[type="password"] {
    display: block;
    width: 100%;
    min-height: 34px;
    box-sizing: border-box;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-field);
    background: var(--mj-color-bg-canvas-default);
    color: var(--mj-color-text-primary);
    padding: 0 12px;
    font: 400 13.5px/20px var(--mj-font-family-ui);
}

.mj_NewSessionSheet input[type="text"]::placeholder,
.mj_NewSessionSheet input[type="email"]::placeholder {
    color: var(--mj-color-text-tertiary);
}

.mj_NewSessionSheet input[type="text"]:focus,
.mj_NewSessionSheet input[type="text"]:focus-visible,
.mj_NewSessionSheet input[type="email"]:focus,
.mj_NewSessionSheet input[type="email"]:focus-visible,
.mj_NewSessionSheet input[type="password"]:focus,
.mj_NewSessionSheet input[type="password"]:focus-visible {
    border-color: var(--mj-color-border-interactive-primary);
    outline: none;
}

.mj_NewSessionSheet input[type="text"]:disabled {
    background: var(--mj-color-bg-subtle-secondary);
    color: var(--mj-color-text-secondary);
    cursor: default;
}

/* Checkbox row: the label wraps the checkbox, so reset the block-label rule to inline. */
.mj_NewSessionSheet label:has(input[type="checkbox"]) {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 0;
    color: var(--mj-color-text-primary);
    font: 400 13.5px/20px var(--mj-font-family-ui);
    cursor: pointer;
}

.mj_NewSessionSheet input[type="checkbox"] {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--mj-color-bg-accent);
    cursor: pointer;
}

.mj_NewSessionSheet input[type="checkbox"]:focus-visible {
    outline: 2px solid var(--mj-color-text-action-accent);
    outline-offset: 2px;
}

/* Agent / recent-folder pick lists. */
.mj_NewSessionSheet [role="list"] {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.mj_NewSessionSheet [role="listitem"] {
    display: flex;
    width: 100%;
    box-sizing: border-box;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: 8px;
    background: transparent;
    color: var(--mj-color-text-primary);
    padding: 8px 12px;
    font: 400 13px/18px var(--mj-font-family-ui);
    text-align: left;
    cursor: pointer;
}

.mj_NewSessionSheet [role="listitem"]:hover:not(:disabled) {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_NewSessionSheet [role="listitem"]:disabled {
    cursor: default;
    opacity: 0.5;
}

.mj_NewSessionSheet [role="listitem"]:focus-visible {
    outline: 2px solid var(--mj-color-text-action-accent);
    outline-offset: 2px;
}

/* An agent row is a card holding two controls side by side: the box itself, and for an
   offline box a Wake button. The card keeps the list item's border; the box button fills it. */
.mj_NewSessionSheet [role="listitem"].mj_NewSessionSheet_agentRow {
    flex-direction: row;
    align-items: center;
    gap: 0;
    padding: 0;
    cursor: default;
}

.mj_NewSessionSheet [role="listitem"].mj_NewSessionSheet_agentRow:hover {
    background: transparent;
}

.mj_NewSessionSheet_agent {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: inherit;
    padding: 8px 12px;
    font: inherit;
    text-align: left;
    cursor: pointer;
}

.mj_NewSessionSheet_agent:hover:not(:disabled) {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_NewSessionSheet_agent:disabled {
    cursor: default;
    opacity: 0.5;
}

/* Outlined secondary, like the upload dialog's Skip. Full strength beside its dimmed row. */
.mj_NewSessionSheet_wake {
    flex: 0 0 auto;
    margin-right: 8px;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-md);
    background: transparent;
    color: var(--mj-color-text-primary);
    padding: var(--mj-space-1x) var(--mj-space-3x);
    font: 500 12.5px/16px var(--mj-font-family-ui);
    cursor: pointer;
}

.mj_NewSessionSheet_wake:hover {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_NewSessionSheet_agent:focus-visible,
.mj_NewSessionSheet_wake:focus-visible {
    outline: 2px solid var(--mj-color-text-action-accent);
    outline-offset: 2px;
}

.mj_NewSessionSheet_waking {
    flex: 0 0 auto;
    margin-right: 12px;
}

/* A recent folder: its path, then how long since a session last started there. */
.mj_NewSessionSheet [role="listitem"].mj_NewSessionSheet_folder {
    flex-direction: row;
    align-items: baseline;
    gap: 12px;
}

.mj_NewSessionSheet_folderPath {
    min-width: 0;
    flex: 1 1 auto;
    overflow: hidden;
    font-family: var(--mj-font-family-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_NewSessionSheet_folderUsed {
    flex: 0 0 auto;
    color: var(--mj-color-text-secondary);
    font-size: 12px;
}

/* Agent switch (Claude / Codex): the segmented control at its own width. */
.mj_NewSessionSheet_agentSwitch {
    align-self: flex-start;
}

/* Model and effort pickers side by side, each label above its select. */
.mj_NewSessionSheet_picks {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.mj_NewSessionSheet_pick {
    min-width: 0;
    flex: 1 1 160px;
}

.mj_NewSessionSheet select {
    display: block;
    width: 100%;
    min-height: 34px;
    box-sizing: border-box;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-field);
    background: var(--mj-color-bg-canvas-default);
    color: var(--mj-color-text-primary);
    padding: 0 8px;
    font: 400 13.5px/20px var(--mj-font-family-ui);
}

.mj_NewSessionSheet select:focus-visible {
    border-color: var(--mj-color-border-interactive-primary);
    outline: none;
}

/* Box usage under an agent (and above the folder list once one is chosen): the box's last
   capacity report — limits with reset times, live sessions, disk — and an "as of" caption
   saying how old the numbers are. Spans, not divs: it sits inside the agent's <button>. */
.mj_NewSessionSheet_usage {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 4px;
    color: var(--mj-color-text-secondary);
    font: 400 12px/16px var(--mj-font-family-ui);
}

.mj_NewSessionSheet_usageLine {
    display: block;
}

.mj_NewSessionSheet_usageAsOf {
    display: block;
    color: var(--mj-color-text-tertiary);
}

.mj_AttachmentChip {
    display: grid;
    width: fit-content;
    max-width: min(76.75%, 520px);
    align-self: flex-end;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--mj-space-3x);
    box-sizing: border-box;
    margin-left: auto !important;
    border: 1px solid var(--mj-color-border-accent);
    border-radius: var(--mj-radius-bubble);
    background: var(--mj-color-bg-self-bubble);
    box-shadow: var(--mj-shadow-bubble);
    color: var(--mj-color-text-primary);
    padding: var(--mj-space-2x) var(--mj-space-3x);
    font: var(--mj-font-body-sm-regular);
    list-style: none;
}

.mj_AttachmentChip_content {
    display: flex;
    min-width: 0;
    flex-direction: column;
}

.mj_AttachmentChip_caption {
    display: block;
    opacity: 0.8;
    font-size: inherit;
}

.mj_AttachmentChip_name {
    overflow: hidden;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_AttachmentChip_size,
.mj_AttachmentChip_status {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-xs-regular);
}

.mj_AttachmentChip_status {
    display: inline-flex;
    align-items: center;
    gap: var(--mj-space-2x);
    white-space: nowrap;
}

.mj_AttachmentChip_spinner {
    width: 12px;
    height: 12px;
    box-sizing: border-box;
    border: 2px solid var(--mj-color-border-accent);
    border-top-color: var(--mj-color-text-action-accent);
    border-radius: 50%;
    animation: mj-spin 0.8s linear infinite;
}

.mj_AttachmentChip_sending {
    border-color: var(--mj-color-border-interactive-secondary);
}

.mj_AttachmentChip > .mj_AttachmentChip_error {
    display: flex;
    align-items: center;
    gap: var(--mj-space-2x);
    color: var(--mj-color-text-critical-primary);
    font: var(--mj-font-body-xs-regular);
}

.mj_AttachmentChip_actions {
    display: flex;
    gap: var(--mj-space-1x);
}

.mj_AttachmentChip_actions button {
    min-height: var(--mj-control-h-sm);
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-canvas-default);
    color: var(--mj-color-text-primary);
    padding: var(--mj-space-1x) var(--mj-space-2x);
    font: var(--mj-font-body-xs-semibold);
}

.mj_AttachmentChip_actions button:hover {
    background: var(--mj-color-bg-subtle-secondary);
}

.mj_AttachmentChip_actions button:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

li.mj_AttachmentChip_error {
    border-color: rgb(189 32 32 / 24%);
    background: var(--mj-color-bg-canvas-default);
}

.mj_HistoryRow {
    display: flex;
    justify-content: center;
    padding: var(--mj-space-3x);
}

.mj_LoadHistory,
.mj_TextButton {
    border: 0;
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-subtle-secondary);
    color: var(--mj-color-text-primary);
    cursor: pointer;
    padding: var(--mj-space-2x) var(--mj-space-3x);
}

.mj_LoadHistory:disabled,
.mj_TextButton:disabled {
    cursor: default;
    opacity: 0.6;
}

/* v5 event.prompt (Question) + event.permission_request are one card family: chrome
   (border / r10 / panel / pad 12·14), a label+time header row, a 24px-gutter icon+body
   grid (§10.2 inner edge — SVG in the gutter, never inline emoji, which make the text's
   left edge a function of glyph width), and an actions row with exactly one filled
   primary (§10.5). Both states keep the same rows in the same order so answering doesn't
   reflow the card (§10.3). Permission only differs by the teal border + accent label. */
.mj_PromptCard {
    display: flex;
    min-width: 0;
    max-width: var(--mj-content-width);
    flex-direction: column;
    gap: 10px;
    box-sizing: border-box;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-card-content);
    background: var(--mj-color-bg-canvas-default);
    padding: 12px 14px;
}

.mj_PromptCard_permission {
    border-color: var(--mj-color-border-accent);
}

/* agent_spawn consent card — same .mj_PromptCard chrome, violet accent distinguishes a
   spawn ask from a tool permission. Adds a truncated headline, From/Target/Folder detail
   rows, and a verbatim monospace task block (the text shown is the text that runs). */
.mj_PromptCard_spawn {
    border-color: rgb(124 58 237 / 25%);
}

.mj_PromptCard_spawn .mj_PromptLabel {
    color: var(--mj-color-text-action-accent);
}

.mj_SpawnHeadline {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
    font: 600 13.5px/20px var(--mj-font-family-ui);
}

.mj_SpawnDetails {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.mj_SpawnDetail {
    display: flex;
    gap: 8px;
    font: var(--mj-font-body-sm-regular);
}

.mj_SpawnDetail_label {
    flex: 0 0 52px;
    color: var(--mj-color-text-secondary);
    font-weight: 600;
}

.mj_SpawnDetail_value {
    min-width: 0;
    overflow-wrap: break-word;
    color: var(--mj-color-text-primary);
}

.mj_SpawnTask {
    margin: 0;
    max-height: 220px;
    overflow: auto;
    white-space: pre-wrap;
    word-break: break-word;
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-subtle-secondary);
    padding: 10px 12px;
    font:
        400 12px/18px ui-monospace,
        SFMono-Regular,
        Menlo,
        monospace;
}

/* The resolved row grows a trailing Open button for the started outcome, so it drops the
   base family's fixed 2-column glyph grid in favour of a flex row that can accommodate it. */
.mj_PromptCard_spawn .mj_PromptResolved {
    display: flex;
    align-items: center;
    gap: 10px;
}

.mj_PromptCard_spawn .mj_PromptResolved .mj_Answered {
    flex: 1;
    min-width: 0;
}

/* The base family's fixed 24px glyph column comes from CSS grid (.mj_PromptBody /
   .mj_PromptResolved), which this flex override drops. An empty .mj_PromptGlyph span (no
   icon glyph is drawn on this row) then collapses to its intrinsic ~0 width in a flex row,
   pulling the "Started"/"Denied"/etc. text left of the base family's grid alignment. Pin it
   back to the same 24px the grid would have given it. */
.mj_PromptCard_spawn .mj_PromptResolved .mj_PromptGlyph {
    flex: 0 0 24px;
}

.mj_SpawnOpenButton {
    flex: 0 0 auto;
    min-height: 30px;
    box-sizing: border-box;
    border: 0;
    border-radius: 8px;
    background: var(--mj-color-bg-accent);
    color: var(--mj-color-text-on-accent);
    cursor: pointer;
    padding: 0 14px;
    font: 600 12.5px/16px var(--mj-font-family-ui);
}

.mj_SpawnOpenButton:hover {
    filter: brightness(1.08);
}

/* "Approved by the Coordinator — <reason>" on a spawn card the Coordinator answered, and its
   Stop session button once the session it let start is running. */
.mj_CoordinatorBadge {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    color: var(--mj-color-text-secondary);
    font: 400 13px/18px var(--mj-font-family-ui);
}

.mj_CoordinatorBadge_line {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    min-width: 0;
}

.mj_CoordinatorBadge_glyph {
    flex: none;
    margin-top: 2px;
    font-size: 14px;
}

.mj_CoordinatorBadge_stop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
}

.mj_CoordinatorBadge_stopButton {
    min-height: 30px;
    box-sizing: border-box;
    border: 1px solid var(--mj-color-text-critical-primary);
    border-radius: 8px;
    background: transparent;
    color: var(--mj-color-text-critical-primary);
    cursor: pointer;
    padding: 0 14px;
    font: 600 12.5px/16px var(--mj-font-family-ui);
}

.mj_CoordinatorBadge_stopButton:hover {
    background: color-mix(in srgb, var(--mj-color-text-critical-primary) 10%, transparent);
}

.mj_CoordinatorBadge_error {
    color: var(--mj-color-text-critical-primary);
    font: 400 12px/16px var(--mj-font-family-ui);
}

/* agent_chat consent card — same .mj_PromptCard chrome and detail rows as the spawn card;
   the accent border + label mark it as a consent ask rather than a question. */
.mj_PromptCard_chat {
    border-color: var(--mj-color-border-accent);
}

.mj_PromptCard_chat .mj_PromptLabel {
    color: var(--mj-color-text-action-accent);
}

/* Person-to-person consent card (contact, mission share, session share, room, talk). It is
   answered on its tracker item, so it carries no Allow/Deny: only a link to that item, or a
   muted line saying where to answer when the item can't be found. */
.mj_PeopleCard {
    border-color: var(--mj-color-border-accent);
}

.mj_PeopleCard .mj_PromptLabel {
    color: var(--mj-color-text-action-accent);
}

.mj_PeopleCard_footer {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-height: 30px;
}

.mj_PeopleCard_hint {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
}

/* A hand-over card: the brief (scrolls past a few paragraphs), what will be copied, the files
   with a tick box each on the owner's side, and its own Approve/Accept and Decline. */
.mj_HandoverBrief {
    display: grid;
    gap: 4px;
    font: var(--mj-font-body-sm-regular);
}

.mj_HandoverBrief_body {
    max-height: 220px;
    overflow: auto;
    border-radius: 8px;
    background: var(--mj-color-bg-subtle-secondary);
    padding: 8px 12px;
    font: var(--mj-font-body-sm-regular);
}

.mj_HandoverBrief_body > :first-child {
    margin-top: 0;
}

.mj_HandoverBrief_body > :last-child {
    margin-bottom: 0;
}

.mj_HandoverFiles {
    display: grid;
    gap: 4px;
    font: var(--mj-font-body-sm-regular);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
}

.mj_HandoverFiles legend {
    padding: 0;
    margin-bottom: 4px;
}

.mj_HandoverFile {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    font: var(--mj-font-body-sm-regular);
    cursor: pointer;
}

.mj_HandoverFiles:disabled .mj_HandoverFile {
    cursor: default;
    opacity: 0.7;
}

.mj_HandoverFile_name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_HandoverFile_meta,
.mj_HandoverHint {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
}

.mj_HandoverHint {
    margin: 0;
}

.mj_HandoverKeep {
    display: grid;
    gap: 2px;
}

.mj_HandoverKeep_toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    font: var(--mj-font-body-sm-regular);
    font-weight: 600;
    cursor: pointer;
}

.mj_HandoverKeep_toggle:has(input:disabled) {
    cursor: default;
    opacity: 0.7;
}

.mj_HandoverKeep_hint {
    margin: 0;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
}

/* "by bob" / "bob's agent": another person's write in one of the user's missions. */
.mj_TrackerContributor {
    color: var(--mj-color-text-secondary);
    font-style: italic;
}

/* An agent request the client can't answer (malformed payload): one inert muted line. */
.mj_AgentRequestNotice {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
}

/* Standalone timeline row for the durable spawn_outcome event once the card has scrolled
   away — a single status line, no card chrome. */
/* Surface C restyle (design 2026-08): the durable spawn-outcome row reads as a STRUCTURAL
   event, not a normal message — a coloured kind-rail (teal started / critical failed) +
   an uppercase "Subagent · {kind}" eyebrow. Kept accessible text = spawnOutcomeSnippet. */
.mj_SpawnOutcomeRow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 6px 0;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-canvas-raised);
    color: var(--mj-color-text-secondary);
    padding: 8px 12px;
    font-size: 13px;
    line-height: 19px;
}

.mj_SpawnOutcomeRow_rail {
    width: 3px;
    align-self: stretch;
    flex: 0 0 auto;
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-icon-secondary);
}

.mj_SpawnOutcomeRow_started .mj_SpawnOutcomeRow_rail {
    background: var(--mj-color-text-action-accent);
}

.mj_SpawnOutcomeRow_failed .mj_SpawnOutcomeRow_rail {
    background: var(--mj-color-text-critical-primary);
}

.mj_SpawnOutcomeRow_kindMark {
    width: 14px;
    height: 14px;
    flex: 0 0 auto;
}

.mj_SpawnOutcomeRow_glyph {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
}

.mj_SpawnOutcomeRow_text {
    flex: 1 1 auto;
    min-width: 0;
}

.mj_SpawnOutcomeRow_text b {
    color: var(--mj-color-text-primary);
    font-weight: 600;
}

.mj_SpawnOutcomeRow_eyebrow {
    display: block;
    margin-bottom: 1px;
    color: var(--mj-color-text-tertiary);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

/* ============================================================================
   Surface B — Peer message (design 2026-08): migrated OFF inline styles to a
   durable block, so continuation grouping, the priority variant, and both themes
   are expressible. A left-aligned raised card with a coloured left edge, worker
   mark, session name + muted `peer` tag — reads as "another AI is speaking into
   your thread" without masquerading as your own (right, teal) or the primary
   agent (left, no card). See GENERATIVE-SYSTEM.md · Surface B.
   ============================================================================ */
.mj_PeerMessage {
    position: relative;
    display: block;
    box-sizing: border-box;
    width: 100%;
    max-width: 640px;
    margin: 6px 0;
    border: 1px solid var(--mj-color-border-subtle);
    border-left: 2px solid var(--mj-color-icon-secondary);
    border-radius: var(--mj-radius-lg);
    background: var(--mj-color-bg-canvas-raised);
    box-shadow: var(--mj-shadow-sm);
    padding: 10px 12px 10px 13px;
}

.mj_PeerMessage_head {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 5px;
}

.mj_PeerMessage_mark {
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    color: var(--mj-color-text-primary);
}

.mj_PeerMessage_mark_neutral {
    color: var(--mj-color-text-tertiary);
}

.mj_PeerMessage_name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--mj-color-text-primary);
    font-size: 13px;
    font-weight: 600;
}

.mj_PeerMessage_tag {
    flex: 0 0 auto;
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-bg-subtle-secondary);
    color: var(--mj-color-text-tertiary);
    padding: 1px 7px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

.mj_PeerMessage_time {
    flex: 0 0 auto;
    margin-left: auto;
    color: var(--mj-color-text-tertiary);
    font-size: 10px;
}

.mj_PeerMessage_body {
    color: var(--mj-color-text-primary);
    font-size: 14px;
    line-height: 21px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}

/* PEER_BODY_CAP is enforced in JS (ellipsis at the tail); this is the visual guard. */
.mj_PeerMessage_body_clamp {
    display: -webkit-box;
    -webkit-line-clamp: 12;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* NOTE: peer-message continuation grouping is intentionally NOT implemented here. The
   timeline's .mj_EventTile_continuation wrapper keys on event.sender only, which for a
   peer message is the sending DEVICE (agent:<device>), not the source session
   (payload.from_convo). Hiding the header off that predicate would drop a different peer
   session's name and Priority badge (false attribution / muted priority). Correct
   from_convo-aware peer grouping is deferred to the priority-producer follow-up.
*/

.mj_PeerMessage:hover {
    border-left-color: var(--mj-color-border-interactive-primary);
}

.mj_PeerMessage:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

/* Priority variant (net-new): medium loudness at rest — a 3px accent edge +
   selected-tint surface + a PRIORITY badge. The interaction rule (never a focus steal /
   modal / composer injection) lives in the component, not the CSS. */
.mj_PeerMessage_priority {
    border-left: 3px solid var(--mj-priority-accent);
    border-color: var(--mj-accent-border);
    background: var(--mj-state-selected);
}

[data-theme="dark"] .mj_PeerMessage_priority {
    border-color: rgb(45 212 191 / 30%);
}

.mj_PeerMessage_priority:hover {
    filter: brightness(1.02);
}

.mj_PeerMessage_priorityBadge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: 0 0 auto;
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-bg-accent-emphasis);
    color: var(--mj-color-text-on-accent);
    padding: 1px 7px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

[data-theme="dark"] .mj_PeerMessage_priority .mj_PeerMessage_priorityBadge {
    color: #06231f;
}

.mj_PromptHeader {
    display: flex;
    align-items: baseline;
    gap: 10px;
}

.mj_PromptLabel {
    flex: 1;
    min-width: 0;
    color: var(--mj-color-text-secondary);
    font: 600 10px/14px var(--mj-font-family-ui);
    letter-spacing: 0.07em;
    text-transform: uppercase;
}

.mj_PromptCard_permission .mj_PromptLabel {
    color: var(--mj-color-text-action-accent);
}

.mj_PromptTime {
    flex: 0 0 auto;
    color: var(--mj-color-text-secondary);
    font: 400 11px/14px var(--mj-font-family-ui);
    white-space: nowrap;
}

.mj_PromptBody,
.mj_PromptResolved {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    align-items: start;
    row-gap: 6px;
}

.mj_PromptGlyph {
    display: inline-flex;
    margin-top: 3px;
    color: var(--mj-color-icon-secondary);
}

/* Answered check = the design's green (#34c759 == --mj-color-usage-low). */
.mj_PromptGlyph_ok {
    margin-top: 2px;
    color: var(--mj-color-usage-low);
}

.mj_PromptQuestion {
    font: 400 13.5px/20px var(--mj-font-family-ui);
}

.mj_PromptOptions,
.mj_PromptText {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mj-space-2x);
}

.mj_PromptOptions button,
.mj_PromptText button,
.mj_PromptText input {
    min-height: var(--mj-control-h);
    box-sizing: border-box;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-field);
    background: transparent;
    color: var(--mj-color-text-primary);
    padding: 0 14px;
    font: 500 12.5px/16px var(--mj-font-family-ui);
}

.mj_PromptText input {
    flex: 1;
    min-width: 180px;
    padding: 0 12px;
}

/* §10.5 the one filled primary: permission Allow, an affirmative question option, or the
   free-text Send. Everything else is outlined/ghost. */
.mj_PromptOptions button.mj_PromptOption_affirmative,
.mj_PromptText button.mj_PromptOption_affirmative {
    border: 0;
    background: var(--mj-color-bg-accent);
    color: var(--mj-color-text-on-accent);
    font-weight: 600;
}

.mj_PromptOptions button.mj_PromptOption_affirmative:hover:not(:disabled),
.mj_PromptText button.mj_PromptOption_affirmative:hover:not(:disabled) {
    filter: brightness(1.08);
}

.mj_PromptOptions button:not(.mj_PromptOption_affirmative):hover,
.mj_PromptText button:not(.mj_PromptOption_affirmative):hover:not(:disabled) {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_PromptOptions button:focus-visible,
.mj_PromptText button:focus-visible,
.mj_PromptText input:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

/* pick_many: options are toggles (a leading check box, ticked = accent), and the separate
   Send below them is the card's one filled primary. */
.mj_PromptOptions button.mj_PromptOption_toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-left: 10px;
}

.mj_PromptOption_check {
    display: inline-flex;
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--mj-color-border-interactive-primary);
    border-radius: 4px;
}

.mj_PromptOption_check svg {
    width: 11px;
    height: 11px;
}

.mj_PromptOptions button.mj_PromptOption_toggle[aria-pressed="true"] {
    border-color: var(--mj-color-border-accent);
    color: var(--mj-color-text-action-accent);
}

.mj_PromptOptions button.mj_PromptOption_toggle[aria-pressed="true"] .mj_PromptOption_check {
    border-color: var(--mj-color-bg-accent);
    background: var(--mj-color-bg-accent);
    color: var(--mj-color-text-on-accent);
}

.mj_PromptOptions_send button:disabled,
.mj_PromptText button:disabled {
    cursor: default;
    opacity: 0.5;
}

.mj_PromptResolved .mj_Answered {
    color: var(--mj-color-text-secondary);
    font: 500 13px/17px var(--mj-font-family-ui);
}

.mj_Answered,
.mj_Muted,
.mj_Expired,
.mj_FileSize {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
}

.mj_ToolCard {
    /* v5: fills the shared agent content width (no bespoke min). Mac card chrome (unify step 4):
       shadow, no border, radius 8, 8px padding. */
    min-width: 0;
    overflow: hidden;
    border-radius: var(--mj-radius-card);
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-sm);
}

/* Tool card summary (Mac ToolCallCard): chevron, status glyph, bold command, grey args. */
.mj_ToolCard summary {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    padding: 8px;
    list-style: none;
}

.mj_ToolCard summary::-webkit-details-marker {
    display: none;
}

.mj_ToolCard_chevron {
    width: 13px;
    height: 13px;
    flex: 0 0 auto;
    color: var(--mj-color-text-tertiary);
    transform: rotate(-90deg);
    transition: transform var(--mj-dur-fast) var(--mj-ease);
}

.mj_ToolCard[open] summary .mj_ToolCard_chevron {
    transform: rotate(0deg);
}

/* `$ command` — bare mono, single line with ellipsis (no chip box). */
.mj_ToolCard_command {
    min-width: 0;
    overflow: hidden;
    border: 0;
    background: transparent;
    padding: 0;
    font: 700 12px/16px var(--mj-font-family-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_ToolCard_args {
    color: var(--mj-color-text-secondary);
    font: 400 10px/16px var(--mj-font-family-mono);
}

.mj_ToolCard_status {
    display: inline-flex;
    flex: 0 0 auto;
}

.mj_ToolCard_status svg {
    width: 14px;
    height: 14px;
}

.mj_ToolCard_status_ok {
    color: var(--mj-color-text-success);
}

.mj_ToolCard_status_failed {
    color: var(--mj-color-text-critical-primary);
}

.mj_ToolCard_meta {
    color: var(--mj-color-text-secondary);
    padding: 0 8px 4px 30px;
    font: var(--mj-font-micro);
}

/* v5 event.unknown: dashed --m-line2 border on --m-raised so an unrecognised event
   reads as diagnostic (collapsed, JSON on expand), never as content. */
.mj_Unknown {
    /* v5: fills the shared agent content width. */
    max-width: 100%;
    border: 1px dashed var(--mj-color-border-strong);
    border-radius: var(--mj-radius-card);
    background: var(--mj-color-bg-canvas-raised);
    padding: 10px 12px;
}

.mj_ToolCommand,
.mj_ToolCard pre,
.mj_LiveTool pre,
.mj_Unknown pre {
    /* v5: fill the card (which is capped at the shared content width); scroll inside. */
    max-width: 100%;
    max-height: 360px;
    overflow: auto;
    box-sizing: border-box;
    border-radius: var(--mj-radius-sm);
    background: var(--mj-color-bg-subtle-secondary);
    padding: var(--mj-space-3x);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-family: var(--mj-font-family-mono);
    font-size: var(--mj-font-size-xs);
}

/* Tool output on the Mac's terminal block, in both themes; the ANSI palette is tuned for it. */
.mj_LiveTool pre,
.mj_ToolCard pre,
.mj_Unknown pre {
    margin: 0 8px 8px;
    border-radius: var(--mj-radius-code);
    background: var(--mj-color-terminal-bg);
    color: var(--mj-color-terminal-fg);
    padding: 8px;
    font: 400 12px/16px var(--mj-font-family-mono);
}

/* Running tool stream (Mac ToolStreamCard): a chevron in the header; the pane shows about three
   lines collapsed (Mac: 76pt) and a bounded scrolling pane expanded. */
.mj_LiveTool_header {
    display: flex;
    align-items: center;
    gap: 8px;
}

.mj_LiveTool_header > span:first-child {
    min-width: 0;
    flex: 1 1 auto;
}

.mj_LiveTool_toggle {
    display: inline-flex;
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--mj-color-text-tertiary);
    cursor: pointer;
}

.mj_LiveTool_toggle svg {
    width: 13px;
    height: 13px;
}

.mj_LiveTool_toggle:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--mj-color-text-action-accent);
    outline-offset: 1px;
}

.mj_LiveTool pre.mj_LiveTool_collapsed {
    max-height: 76px;
}

.mj_LiveTool pre.mj_LiveTool_expanded {
    max-height: 600px;
}

.mj_DiffCard {
    min-width: 0;
    overflow: hidden;
    border-radius: var(--mj-radius-card);
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-sm);
}

.mj_DiffCard_header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--mj-space-2x);
    padding: 8px;
}

/* v5: the expand toggle is a bare chevron, not a native button box. */
.mj_DiffCard_header > button {
    display: inline-flex;
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--mj-color-text-tertiary);
    cursor: pointer;
}

.mj_DiffCard_header > button svg {
    width: 13px;
    height: 13px;
}

.mj_DiffCard_header > button:focus-visible {
    border-radius: var(--mj-radius-xs);
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset-field);
}

.mj_DiffCard_filename {
    min-width: 0;
    overflow-wrap: anywhere;
    /* v5 mock: mono.filename 600 12.5/18. */
    font: 600 12.5px/18px var(--mj-font-family-mono);
}

.mj_DiffCard_link {
    color: var(--mj-color-text-action-accent);
}

.mj_DiffCard_expiredNote {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-xs-regular);
}

.mj_DiffCard_link:hover {
    text-decoration: underline;
}

.mj_DiffCard_link:focus-visible {
    border-radius: var(--mj-radius-xs);
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

.mj_DiffCard_label {
    color: var(--mj-color-text-secondary);
}

.mj_DiffCard_more,
.mj_DiffCard_truncated {
    /* On the terminal surface in both themes, so terminal ink rather than page ink. */
    color: var(--mj-color-terminal-muted);
}

.mj_DiffCard_truncated {
    padding: 2px var(--mj-space-3x);
}

.mj_DiffCard_badge {
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-bg-subtle-primary);
    padding: 1px var(--mj-space-2x);
    font: var(--mj-font-body-xs-semibold);
}

/* +n / −n header counts: Fira Code 600 11/16 (design event.diff filename-row counts),
   coloured glyphs. Scoped to the header counts — NOT .mj_DiffLine_del (body line). */
.mj_DiffCard_added,
.mj_DiffCard_removed {
    font: 600 11px/16px var(--mj-font-family-mono);
}

.mj_DiffCard_added {
    color: var(--mj-color-text-success);
}

.mj_DiffCard_removed {
    color: var(--mj-color-text-critical-primary);
}

/* Diff lines on the terminal block: coloured text, no row tints (Mac DiffCard). */
.mj_DiffLine_del {
    color: var(--mj-color-terminal-del);
}

/* v5 event.diff.addRow: an added line is signalled by a full-bleed row-background
   tint with DEFAULT ink — not green text. Removed lines keep bg tint + critical ink. */
.mj_DiffLine_add {
    color: var(--mj-color-terminal-add);
}

/* Rows carry the 2px/12px padding (the body's horizontal padding is dropped) so each
   row's background tint bleeds edge-to-edge while the code text stays inset. */
.mj_DiffLine_add,
.mj_DiffLine_del,
.mj_DiffLine_ctx,
.mj_DiffLine_hunk {
    display: block;
    padding: 2px var(--mj-space-3x);
}

.mj_DiffCard_track {
    display: flex;
    flex-direction: column;
    width: max-content;
    min-width: 100%;
}

.mj_DiffCard_body {
    /* v5: fills the diff card (shared content width); wide rows scroll inside. */
    max-width: 100%;
    overflow-x: auto;
    box-sizing: border-box;
    /* No horizontal padding — the rows carry it so their bg tint reaches the edges. */
    margin: 0 8px 8px;
    border-radius: var(--mj-radius-code);
    background: var(--mj-color-terminal-bg);
    color: var(--mj-color-terminal-fg);
    padding: 4px 0;
    white-space: pre;
    font-family: var(--mj-font-family-mono);
    font-size: 12px;
    line-height: 16px;
}

.mj_DiffLine_hunk {
    color: var(--mj-color-terminal-muted);
    /* the hunk header (`@@ -a,b +c,d @@`) is diff metadata, not source.
       Fira Code draws `@` as a ring-enclosed `a` (its base glyph — NOT a
       ligature, so font-feature-settings can't undo it), which made `@@`
       unreadable. Render the header row in a plain monospace whose at-sign is
       conventional; the diff body keeps Fira Code. */
    font-family: ui-monospace, "SF Mono", "SFMono-Regular", Menlo, Consolas, "Liberation Mono", monospace;
}

.mj_DiffLine_ctx {
    color: var(--mj-color-terminal-fg);
}

.mj_DiffCard_more {
    border: 0;
    background: transparent;
    cursor: pointer;
    /* Inset to match the row text now that the body carries no horizontal padding. */
    padding: 2px var(--mj-space-3x);
}

/* De-chrome the collapse chevron (Dan 1ffe0d2): same reset as _more, inline-flex to center the icon. */
.mj_DiffCard_chevron {
    display: inline-flex;
    align-items: center;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 0;
}

.mj_ToolCommand {
    margin: 0 8px 8px;
}

.mj_File {
    display: inline-flex;
    align-items: center;
    gap: var(--mj-space-1-5x);
    color: var(--mj-color-text-link-external);
    text-align: left;
}

.mj_FileIcon {
    flex: 0 0 auto;
    /* Icon sits on the secondary ink so the MIME bucket reads independent of the link colour. */
    color: var(--mj-color-icon-secondary);
    font-size: 18px;
}

.mj_FileName {
    min-width: 0;
    overflow-wrap: anywhere;
}

button.mj_File {
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 0;
    font: inherit;
}

.mj_FileSize {
    margin-left: var(--mj-space-2x);
}

/* Inside the icon · name · size rows the row's own gap spaces the size. */
.mj_File > .mj_FileSize,
.mj_Audio_head > .mj_FileSize {
    margin-left: 0;
}

.mj_FileCaption {
    margin-top: 4px;
}

/* Reaped attachment (server media reaper): the name stays readable but muted, "Expired" takes
   the size's place, and nothing is clickable. */
.mj_File_expired {
    color: var(--mj-color-text-secondary);
    cursor: default;
}

.mj_MediaExpired {
    display: inline-flex;
    align-items: center;
    gap: var(--mj-space-1-5x);
    border: 1px dashed var(--mj-color-border-subtle);
    border-radius: 6px;
    padding: var(--mj-space-3x) var(--mj-space-4x);
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
}

/* Inline audio player: the file row on top, the browser's own controls below. */
.mj_Audio {
    display: inline-flex;
    flex-direction: column;
    gap: var(--mj-space-1x);
    max-width: min(420px, 100%);
}

.mj_Audio_head {
    display: flex;
    align-items: center;
    gap: var(--mj-space-1-5x);
    min-width: 0;
}

.mj_Audio_player {
    width: min(360px, 60vw);
    height: 36px;
}

.mj_Audio_retry {
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-canvas-raised);
    color: var(--mj-color-text-primary);
    font: var(--mj-font-body-sm-regular);
    padding: 2px var(--mj-space-2x);
    margin-left: var(--mj-space-1x);
    cursor: pointer;
}

.mj_Audio_retry:focus-visible {
    outline: 2px solid var(--mj-color-text-action-accent);
    outline-offset: 2px;
}

/* Reflow fix: when the bridge sent dims, the frame carries an inline aspect-ratio + width so
   its box is reserved before the blob decodes. The sized modifier caps it to the image
   max-width and holds height via the aspect ratio; the img fills the frame exactly. Without
   dims the frame is layout-neutral (contents own their size, fluid fallback). */
.mj_ImageFrame {
    display: block;
}

.mj_ImageFrame_sized {
    max-width: 100%;
    max-height: 520px;
    overflow: hidden;
    border-radius: var(--mj-radius-sm);
}

.mj_ImageFrame_sized img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.mj_ImageFrame_sized .mj_MediaLoading {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.mj_Image {
    max-width: min(560px, 60vw);
    margin: 0;
}

.mj_Image img {
    display: block;
    max-width: 100%;
    max-height: 520px;
    border-radius: var(--mj-radius-sm);
}

.mj_Image figcaption {
    margin-top: var(--mj-space-1x);
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
}

.mj_LiveDot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mj-color-icon-accent-primary);
    animation: mj-pulse 1.2s ease-in-out infinite;
}

.mj_Cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 2px;
    background: currentColor;
    vertical-align: -2px;
    animation: mj-blink 0.9s step-end infinite;
}

.mj_Activity {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: var(--mj-space-3x) var(--mj-space-5x);
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
}

.mj_Activity > span {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    animation: mj-pulse 1.2s ease-in-out infinite;
}

.mj_Activity > span:nth-child(2) {
    animation-delay: 0.15s;
}

.mj_Activity > span:nth-child(3) {
    margin-right: 4px;
    animation-delay: 0.3s;
}

.mj_ComposerInput {
    width: 100%;
}

.mj_ChatView_body[data-layout="bubble"] .mj_ComposerInput textarea.mj_ComposerInput_input {
    display: block;
    width: 100%;
    max-height: 144px;
    outline: none;
    resize: none;
    color: var(--mj-color-text-primary);
    overflow-y: auto;
}

/* No composer focus ring by design — the shell border recolor
   (.mj_ComposerField:focus-within) is the focus indicator. A :focus-visible ring on
   this textarea would show on click-to-type (text inputs always match :focus-visible),
   which the mock rejects. See reference_focus_visible_fires_on_every_text_input_focus. */

.mj_ComposerControl[aria-disabled="true"] {
    cursor: default;
}

.mj_VoiceRecording {
    display: flex;
    width: 100%;
    min-height: 44px;
    align-items: center;
    gap: var(--mj-space-3x);
    box-sizing: border-box;
    /* v4: recording bar replaces the input row — 1px teal-tint border, composer radius. */
    border: 1px solid var(--mj-color-border-accent);
    border-radius: var(--mj-radius-composer);
    background: var(--mj-color-bg-subtle-secondary);
    color: var(--mj-color-text-primary);
    padding: var(--mj-space-2x) var(--mj-space-3x);
}

.mj_VoiceRecording_dot {
    width: 9px;
    height: 9px;
    flex: 0 0 auto;
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-text-critical-primary);
    /* v4: recording dot pulses at 1.1s (distinct from the 1.2s typing/live-session dot). */
    animation: mj-pulse 1.1s ease-in-out infinite;
}

.mj_VoiceRecording_waveform,
.mj_VoiceRecording_waveformFallback {
    width: min(240px, 40vw);
    height: 32px;
    min-width: 48px;
    flex: 1 1 auto;
}

.mj_VoiceRecording_waveform {
    color: var(--mj-color-icon-accent-primary);
}

.mj_VoiceRecording_waveformFallback {
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-icon-accent-primary);
    opacity: 0.35;
    animation: mj-pulse 1.2s ease-in-out infinite;
}

.mj_VoiceRecording_time {
    min-width: 3rem;
    color: var(--mj-color-text-secondary);
    /* v4: mono m:ss timer. */
    font: 500 12.5px/18px var(--mj-font-family-mono);
    font-variant-numeric: tabular-nums;
    text-align: center;
}

.mj_VoiceRecording_action {
    display: inline-flex;
    width: var(--mj-control-h);
    height: var(--mj-control-h);
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: var(--mj-radius-pill);
    background: transparent;
    color: var(--mj-color-icon-secondary);
    cursor: pointer;
}

/* Ghost hover (background + danger colour) applies only to the discard control — the
   filled Stop button keeps its accent background on hover, or the generic rule (more
   specific than Stop's base background) flips it to near-white and hides the white icon. */
.mj_VoiceRecording_action:not(.mj_VoiceRecording_stop):hover:not(:disabled) {
    background: var(--mj-color-bg-subtle-primary);
    color: var(--mj-color-text-critical-primary);
}

.mj_VoiceRecording_action:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

.mj_VoiceRecording_action:disabled {
    color: var(--mj-color-icon-tertiary);
    cursor: default;
    opacity: 0.5;
}

.mj_VoiceRecording_action svg {
    width: 19px;
    height: 19px;
}

.mj_VoiceRecording_stop {
    /* v4 primary button: filled --m-accent-deep, hover brightens (no colour swap). */
    background: var(--mj-color-bg-accent);
    color: var(--mj-color-text-on-accent);
}

.mj_VoiceRecording_stop:hover:not(:disabled) {
    filter: brightness(1.08);
    color: var(--mj-color-text-on-accent);
}

.mj_VoiceError {
    margin-inline: var(--mj-space-1x);
}

/* The main column makes room under the page for the app-wide voice-note bar (Mac: the detail
   column's bottom inset), rather than floating it over the composer. */
.mj_ChatView_wrapper_voiceNote {
    flex-direction: column;
}

.mj_ChatView_wrapper_voiceNote > :not(.mj_VoiceNoteBar) {
    width: 100%;
    min-height: 0;
    flex: 1 1 0;
}

.mj_VoiceNoteBar {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: var(--mj-space-2x) var(--mj-space-4x);
    background: var(--mj-color-bg-chat-canvas);
}

/* Mac VoiceNoteIndicator: a capsule up to 480pt wide — where the note goes, the running time,
   Cancel and Send; the rest of it opens the conversation. */
.mj_VoiceNoteIndicator {
    display: flex;
    width: 100%;
    max-width: 480px;
    box-sizing: border-box;
    align-items: center;
    gap: var(--mj-space-2x);
    padding: 6px var(--mj-space-2x) 6px 14px;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-bg-canvas-raised);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.12);
    color: var(--mj-color-text-primary);
}

.mj_VoiceNoteIndicator_open {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    align-items: center;
    gap: 10px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: start;
}

.mj_VoiceNoteIndicator_text {
    display: flex;
    min-width: 0;
    flex-direction: column;
}

.mj_VoiceNoteIndicator_headline {
    font-size: 13px;
    font-weight: 600;
    line-height: 18px;
}

.mj_VoiceNoteIndicator_time {
    margin-inline-start: 4px;
    font-family: var(--mj-font-family-mono);
    font-variant-numeric: tabular-nums;
}

.mj_VoiceNoteIndicator_subtitle {
    overflow: hidden;
    color: var(--mj-color-text-secondary);
    font-size: 12px;
    line-height: 16px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_VoiceNoteIndicator_warning {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    color: var(--mj-color-usage-medium);
}

.mj_VoiceNoteIndicator_action {
    display: inline-flex;
    width: 32px;
    height: 32px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: var(--mj-radius-pill);
    background: transparent;
    color: var(--mj-color-icon-secondary);
}

.mj_VoiceNoteIndicator_action svg {
    width: 22px;
    height: 22px;
}

.mj_VoiceNoteIndicator_send {
    color: var(--mj-color-icon-accent-primary);
}

.mj_VoiceNoteIndicator_send svg {
    width: 28px;
    height: 28px;
}

.mj_VoiceNoteIndicator_action:hover:not(:disabled) {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_VoiceNoteIndicator_action:disabled {
    cursor: default;
    opacity: 0.5;
}

.mj_VoiceNoteIndicator_textAction {
    flex: 0 0 auto;
    padding: 4px 6px;
    border: 0;
    background: transparent;
    color: var(--mj-color-text-secondary);
    font-size: 13px;
}

.mj_VoiceNoteIndicator_retry {
    color: var(--mj-color-text-action-accent);
    font-weight: 600;
}

.mj_VoiceNoteIndicator_open:focus-visible,
.mj_VoiceNoteIndicator_action:focus-visible,
.mj_VoiceNoteIndicator_textAction:focus-visible {
    border-radius: var(--mj-radius-sm);
    outline: 2px solid var(--mj-color-icon-accent-primary);
    outline-offset: 2px;
}

.mj_ScreenReaderOnly {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
}

.mj_ReadOnlyHint {
    display: flex;
    min-height: 56px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border-top: 1px solid var(--mj-color-border-disabled);
    background: var(--mj-color-bg-canvas-default);
    color: var(--mj-color-text-secondary);
    padding: var(--mj-space-3x) var(--mj-space-4x);
    font: var(--mj-font-body-sm-regular);
    text-align: center;
}

.mj_ConnectionError {
    display: flex;
    align-items: center;
    gap: var(--mj-space-2x);
    margin: var(--mj-space-2x) 0;
    color: var(--mj-color-text-critical-primary);
    font: var(--mj-font-body-sm-regular);
}

.mj_ConnectionError span[role="status"] {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
}

.mj_DraftNonDurable {
    margin: var(--mj-space-2x) 0;
    color: var(--mj-color-text-critical-primary);
    font: var(--mj-font-body-sm-regular);
    overflow-wrap: anywhere;
}

.mj_ConnectionError_dismiss {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    min-width: var(--mj-control-h);
    min-height: var(--mj-control-h);
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    font-size: var(--mj-font-size-md);
    line-height: 1;
    cursor: pointer;
}

.mj_ConnectionError_dismiss svg {
    width: 16px;
    height: 16px;
}

.mj_Error {
    color: var(--mj-color-text-critical-primary);
}

.mj_PrivacyLink {
    display: block;
    text-align: center;
    font: var(--mj-font-meta);
}

.mj_Loading {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--mj-color-bg-canvas-raised);
}

.mj_Loading img {
    width: 96px;
}

@keyframes mj-pulse {
    0%,
    100% {
        opacity: 0.35;
    }

    50% {
        opacity: 1;
    }
}

@keyframes mj-blink {
    50% {
        opacity: 0;
    }
}

@keyframes mj-spin {
    to {
        transform: rotate(360deg);
    }
}

/* Surface A pinned-summary refresh shimmer (a 2px accent sweep under the bar). */
@keyframes mj-shimmer {
    0% {
        background-position: -180px 0;
    }

    100% {
        background-position: 180px 0;
    }
}

@media (prefers-reduced-motion: reduce) {
    .mj_AttachmentChip_spinner,
    .mj_Spinner,
    .mj_VoiceRecording_dot,
    .mj_VoiceRecording_waveformFallback,
    .mj_HeaderStatusDot_running,
    .mj_ConversationListStatus_running,
    .mj_CompactButton_compacting {
        animation: none;
    }
    .mj_AttachmentChip_spinner,
    .mj_Spinner,
    .mj_VoiceRecording_dot,
    .mj_VoiceRecording_waveformFallback,
    .mj_HeaderStatusDot_running,
    .mj_ConversationListStatus_running {
        animation: none;
    }
}

@media (max-width: 700px) {
    .mj_UsageCluster_collapsed .mj_UsageRow {
        grid-template-columns: 24px 40px 32px;
    }

    /* Back on the conversation list the main column is hidden, but a live voice note's bar stays:
       pinned along the bottom of the screen, the rest of the column still out of the way. */
    .mj_Chat_mobileHidden.mj_ChatView_wrapper_voiceNote {
        display: flex;
        position: fixed;
        z-index: 10;
        right: 0;
        bottom: 0;
        left: 0;
    }

    .mj_Chat_mobileHidden.mj_ChatView_wrapper_voiceNote > :not(.mj_VoiceNoteBar) {
        display: none;
    }

    .mj_Chat_mobileHidden.mj_ChatView_wrapper_voiceNote > .mj_VoiceNoteBar {
        padding-bottom: calc(var(--mj-space-2x) + env(safe-area-inset-bottom, 0px));
    }

    /* The list scrolls clear of the pinned bar: its last rows can still be reached. */
    .mj_App:has(> .mj_Chat_mobileHidden.mj_ChatView_wrapper_voiceNote) > .mj_Sidebar_outerWrapper {
        box-sizing: border-box;
        padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px));
    }
}

/* =====================================================================================
   Media viewer / lightbox. Modal scrim + dialog card + per-type body +
   bottom ThumbStrip. Radii: dialog 14, images/wells 6, thumbs/buttons 8. Accent teal for
   active/selected; active thumb = 2px accent border (not a fill). Focus = 2px accent
   outline at +2px offset. Motion: 120ms colour/bg, 180ms surface, --mj-ease; all off
   under prefers-reduced-motion. No entrance animation.
   ===================================================================================== */

/* Inline image becomes a zoom-in affordance once the viewer context is available. */
.mj_Image_zoomable {
    cursor: zoom-in;
}

.mj_Image_zoomable:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

/* Renderable file chip that opens the viewer instead of downloading — same look as .mj_File
   (which is styled elsewhere) but a button, so reset button chrome. */
.mj_File_preview {
    cursor: pointer;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    background: var(--mj-color-bg-canvas-raised);
    font: inherit;
    color: inherit;
}

.mj_MediaViewer_scrim {
    position: fixed;
    z-index: 60; /* above the upload/source modals at 50 — the viewer is the topmost layer */
    display: flex;
    inset: 0;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    background: var(--mj-scrim-modal);
    padding: var(--mj-space-4x);
}

.mj_MediaViewer {
    display: flex;
    width: min(1100px, 96vw);
    height: min(90vh, 900px);
    flex-direction: column;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-popover);
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-lg);
    color: var(--mj-color-text-primary);
}

.mj_MediaViewer_header {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--mj-space-2x);
    box-sizing: border-box;
    border-bottom: 1px solid var(--mj-color-border-subtle);
    padding: var(--mj-space-2x) var(--mj-space-3x);
}

/* "4 / 8" index — machine string, Fira Code, tertiary ink. */
.mj_MediaViewer_count {
    flex: 0 0 auto;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
    font-family: var(--mj-font-family-mono);
    font-variant-numeric: tabular-nums;
}

/* Filename — machine string, Fira Code, truncates. */
.mj_MediaViewer_name {
    min-width: 0;
    overflow: hidden;
    color: var(--mj-color-text-primary);
    font: var(--mj-font-body-sm-regular);
    font-family: var(--mj-font-family-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_MediaViewer_meta {
    flex: 0 0 auto;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-xs-regular);
    font-family: var(--mj-font-family-mono);
    white-space: nowrap;
}

.mj_MediaViewer_headerSpacer {
    flex: 1 1 auto;
}

.mj_MediaViewer_download {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--mj-space-1x);
    box-sizing: border-box;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-canvas-raised);
    color: var(--mj-color-text-primary);
    font: var(--mj-font-body-sm-regular);
    padding: var(--mj-space-1x) var(--mj-space-3x);
    text-decoration: none;
    cursor: pointer;
    transition:
        background var(--mj-dur-fast) var(--mj-ease),
        border-color var(--mj-dur-fast) var(--mj-ease);
}

.mj_MediaViewer_download svg {
    width: 15px;
    height: 15px;
}

.mj_MediaViewer_download:hover:not(:disabled) {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_MediaViewer_download:disabled {
    cursor: default;
    opacity: 0.6;
}

@media (prefers-reduced-motion: reduce) {
    .mj_AttachmentChip_spinner,
    .mj_Spinner,
    .mj_VoiceRecording_dot,
    .mj_VoiceRecording_waveformFallback,
    .mj_HeaderStatusDot_running,
    .mj_ConversationListStatus_running {
        animation: none;
    }
}

.mj_MediaViewer_download:focus-visible,
.mj_MediaViewer_close:focus-visible,
.mj_MediaViewer_nav:focus-visible,
.mj_MediaViewer_zoomBtn:focus-visible,
.mj_MediaViewer_thumb:focus-visible,
.mj_MediaViewer_pageThumb:focus-visible,
.mj_MediaViewer_retry:focus-visible,
.mj_MediaViewer_downloadBtn:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

.mj_MediaViewer_close {
    display: inline-flex;
    width: var(--mj-control-h);
    height: var(--mj-control-h);
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--mj-radius-md);
    background: transparent;
    color: var(--mj-color-icon-secondary);
    cursor: pointer;
    transition: background var(--mj-dur-fast) var(--mj-ease);
}

.mj_MediaViewer_close:hover {
    background: var(--mj-color-bg-subtle-primary);
    color: var(--mj-color-text-primary);
}

.mj_MediaViewer_close svg {
    width: 16px;
    height: 16px;
}

/* Stage row: prev chevron · body · next chevron. */
.mj_MediaViewer_main {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    align-items: stretch;
    min-height: 0;
}

.mj_MediaViewer_nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: inline-flex;
    width: var(--mj-control-h-lg);
    height: var(--mj-control-h-lg);
    align-items: center;
    justify-content: center;
    transform: translateY(-50%);
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-bg-canvas-raised);
    color: var(--mj-color-text-primary);
    cursor: pointer;
    transition:
        background var(--mj-dur-fast) var(--mj-ease),
        opacity var(--mj-dur-fast) var(--mj-ease);
}

.mj_MediaViewer_nav:hover:not(:disabled) {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_MediaViewer_nav:disabled {
    cursor: default;
    opacity: 0.35;
}

.mj_MediaViewer_nav svg {
    width: 18px;
    height: 18px;
}

.mj_MediaViewer_nav_prev {
    left: var(--mj-space-3x);
}

.mj_MediaViewer_nav_next {
    right: var(--mj-space-3x);
}

.mj_MediaViewer_body {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
}

.mj_MediaViewer_center {
    align-items: center;
    justify-content: center;
}

/* Zoom/pan stage — clips the transformed content, centres it. */
.mj_MediaViewer_stage {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: var(--mj-color-bg-canvas-raised);
    touch-action: none;
}

.mj_MediaViewer_stage[data-zoomed="true"] {
    cursor: grab;
}

.mj_MediaViewer_img,
.mj_MediaViewer_canvas {
    max-width: 100%;
    max-height: 100%;
    border-radius: var(--mj-radius-sm);
    object-fit: contain;
    transform-origin: center center;
    user-select: none;
    /* No transform transition — zoom/pan is driven directly by pointer + wheel, so an
       animated transform would make dragging feel laggy. Discrete surface motion lives on
       the chrome (buttons, chevrons), not the panned content. */
}

.mj_MediaViewer_video {
    max-width: 100%;
    max-height: 100%;
    border-radius: var(--mj-radius-sm);
    background: #000;
}

.mj_MediaViewer_note {
    color: var(--mj-color-text-tertiary);
    font: var(--mj-font-body-sm-regular);
}

/* Errors: bare critical ink, no box, no icon. */
.mj_MediaViewer_error {
    color: var(--mj-color-text-critical-primary);
    font: var(--mj-font-body-sm-regular);
}

.mj_MediaViewer_errorGroup {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--mj-space-2x);
}

.mj_MediaViewer_retry {
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-canvas-raised);
    color: var(--mj-color-text-primary);
    font: var(--mj-font-body-sm-regular);
    padding: var(--mj-space-1x) var(--mj-space-4x);
    cursor: pointer;
}

.mj_MediaViewer_retry:hover {
    background: var(--mj-color-bg-subtle-primary);
}

/* Floating zoom controls, bottom-centre over the stage. */
.mj_MediaViewer_zoom {
    position: absolute;
    bottom: var(--mj-space-4x);
    left: 50%;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: var(--mj-space-1x);
    transform: translateX(-50%);
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-bg-canvas-default);
    box-shadow: var(--mj-shadow-lg);
    padding: var(--mj-space-1x) var(--mj-space-2x);
}

.mj_MediaViewer_zoomBtn {
    display: inline-flex;
    width: 28px;
    height: var(--mj-control-h-sm);
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--mj-radius-md);
    background: transparent;
    color: var(--mj-color-icon-secondary);
    cursor: pointer;
    transition: background var(--mj-dur-fast) var(--mj-ease);
}

.mj_MediaViewer_zoomBtn:hover {
    background: var(--mj-color-bg-subtle-primary);
    color: var(--mj-color-text-primary);
}

.mj_MediaViewer_zoomBtn svg {
    width: 15px;
    height: 15px;
}

.mj_MediaViewer_zoomPct {
    min-width: 46px;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-xs-regular);
    font-family: var(--mj-font-family-mono);
    font-variant-numeric: tabular-nums;
    text-align: center;
}

.mj_MediaViewer_zoomSep {
    width: 1px;
    height: 18px;
    background: var(--mj-color-border-subtle);
}

/* PDF body: vertical page rail + stage. */
.mj_MediaViewer_pdf {
    flex-direction: row;
}

.mj_MediaViewer_pageRail {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: var(--mj-space-1x);
    width: 56px;
    box-sizing: border-box;
    overflow-y: auto;
    border-right: 1px solid var(--mj-color-border-subtle);
    background: var(--mj-color-bg-canvas-default);
    padding: var(--mj-space-2x);
    scrollbar-width: thin;
    scrollbar-color: var(--mj-scrollbar) transparent;
}

.mj_MediaViewer_pageThumb {
    flex: 0 0 auto;
    height: 34px;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-canvas-raised);
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-xs-regular);
    font-family: var(--mj-font-family-mono);
    cursor: pointer;
}

.mj_MediaViewer_pageThumb[aria-current="true"] {
    border: 2px solid var(--mj-color-text-action-accent);
    color: var(--mj-color-text-primary);
}

/* Download-only card (HTML / unknown types — never inline). */
.mj_MediaViewer_downloadCard {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--mj-space-2x);
    box-sizing: border-box;
    max-width: 420px;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-card);
    background: var(--mj-color-bg-canvas-raised);
    padding: var(--mj-space-8x) var(--mj-space-6x);
    text-align: center;
}

.mj_MediaViewer_downloadGlyph {
    width: 40px;
    height: 40px;
    color: var(--mj-color-icon-secondary);
}

.mj_MediaViewer_downloadName {
    max-width: 100%;
    overflow: hidden;
    color: var(--mj-color-text-primary);
    font: var(--mj-font-body-sm-regular);
    font-family: var(--mj-font-family-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_MediaViewer_downloadMeta {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-xs-regular);
    font-family: var(--mj-font-family-mono);
}

.mj_MediaViewer_audio {
    width: min(360px, 70vw);
    margin-top: var(--mj-space-2x);
}

.mj_MediaViewer_downloadNote {
    color: var(--mj-color-text-tertiary);
    font: var(--mj-font-body-sm-regular);
}

.mj_MediaViewer_downloadBtn {
    display: inline-flex;
    align-items: center;
    gap: var(--mj-space-1x);
    margin-top: var(--mj-space-2x);
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-canvas-default);
    color: var(--mj-color-text-primary);
    font: var(--mj-font-body-sm-regular);
    padding: var(--mj-space-2x) var(--mj-space-5x);
    text-decoration: none;
}

.mj_MediaViewer_downloadBtn svg {
    width: 15px;
    height: 15px;
}

.mj_MediaViewer_downloadBtn:hover {
    background: var(--mj-color-bg-subtle-primary);
}

.mj_MediaViewer_caption {
    flex: 0 0 auto;
    box-sizing: border-box;
    border-top: 1px solid var(--mj-color-border-subtle);
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
    padding: var(--mj-space-2x) var(--mj-space-4x);
}

/* Bottom ThumbStrip — scrolls, never wraps. Active = 2px accent border, not a fill. */
.mj_MediaViewer_thumbs {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--mj-space-2x);
    box-sizing: border-box;
    overflow-x: auto;
    flex-wrap: nowrap;
    border-top: 1px solid var(--mj-color-border-subtle);
    padding: var(--mj-space-2x) var(--mj-space-3x);
    scrollbar-width: thin;
    scrollbar-color: var(--mj-scrollbar) transparent;
}

.mj_MediaViewer_thumb {
    display: inline-flex;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-canvas-raised);
    color: var(--mj-color-icon-secondary);
    padding: 0;
    cursor: pointer;
    transition: border-color var(--mj-dur-fast) var(--mj-ease);
}

.mj_MediaViewer_thumb svg {
    width: 16px;
    height: 16px;
}

.mj_MediaViewer_thumb_active {
    border: 2px solid var(--mj-color-text-action-accent);
}

/* Sized wrapper so the lazily-mounted thumbImg still fills the 38px tile. */
.mj_MediaViewer_thumbHolder {
    display: inline-flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.mj_MediaViewer_thumbImg {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Visually-hidden live region for item/page announcements. */
.mj_MediaViewer_live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
}

@media (prefers-reduced-motion: reduce) {
    .mj_MediaViewer_img,
    .mj_MediaViewer_canvas,
    .mj_MediaViewer_download,
    .mj_MediaViewer_close,
    .mj_MediaViewer_nav,
    .mj_MediaViewer_zoomBtn,
    .mj_MediaViewer_thumb {
        transition: none;
    }
}

@media (max-width: 700px) {
    .mj_Sidebar_outerWrapper {
        flex: 1 1 auto;
        width: 100%;
        max-width: none;
    }

    .mj_Sidebar_mobileHidden,
    .mj_ResizeHandle,
    .mj_Chat_mobileHidden {
        display: none;
    }

    .mj_BackButton {
        display: inline-flex;
        position: absolute;
        z-index: 1;
        left: var(--mj-space-2x);
    }

    .mj_ChatHeader {
        gap: var(--mj-space-2x);
        padding-inline: 42px var(--mj-space-2x);
    }

    .mj_ChatView_body[data-layout="bubble"] {
        --mj-message-list-padding: 2px;
    }

    .mj_EventTile[data-layout="bubble"] {
        --mj-bubble-margin-inline-start: var(--mj-space-3x);
        --mj-bubble-margin-inline-end: var(--mj-space-3x);
    }

    .mj_PromptCard,
    .mj_ToolCard,
    .mj_ToolCard pre,
    .mj_LiveTool pre,
    .mj_CodeBlock,
    .mj_DiffCard,
    .mj_Unknown pre,
    .mj_Image {
        min-width: 0;
        max-width: 76vw;
    }
}

/* ── Markdown attachment preview ─────────────────────────────────────────────────────────
   A side panel to the right of the conversation or tracker item (it shares the row, so the
   view beside it stays visible and usable); full screen on a phone-width window. */
.mj_MdPreview {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    box-sizing: border-box;
    width: min(480px, 45vw);
    min-width: 320px;
    height: 100%;
    min-height: 0;
    border-left: 1px solid var(--mj-color-border-interactive-secondary);
    background: var(--mj-color-bg-canvas-default);
}

.mj_MdPreview_header {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--mj-space-2x);
    border-bottom: 1px solid var(--mj-color-border-interactive-secondary);
    padding: var(--mj-space-2x) var(--mj-space-3x);
}

.mj_MdPreview_name {
    flex: 1 1 120px;
    min-width: 0;
    overflow: hidden;
    color: var(--mj-color-text-primary);
    font: var(--mj-font-body-strong);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_MdPreview_actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--mj-space-1x);
}

.mj_MdPreview_action,
.mj_MdPreview_primary,
.mj_MdPreview_close {
    display: inline-flex;
    align-items: center;
    gap: var(--mj-space-1x);
    box-sizing: border-box;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-canvas-raised);
    color: var(--mj-color-text-primary);
    font: var(--mj-font-body-sm-regular);
    padding: var(--mj-space-1x) var(--mj-space-2x);
    cursor: pointer;
}

.mj_MdPreview_action svg,
.mj_MdPreview_primary svg,
.mj_MdPreview_close svg {
    width: 16px;
    height: 16px;
}

.mj_MdPreview_action[aria-pressed="true"] {
    border-color: var(--mj-color-border-accent);
    background: var(--mj-color-bg-accent-tint);
}

.mj_MdPreview_action:disabled,
.mj_MdPreview_primary:disabled {
    cursor: default;
    opacity: 0.5;
}

.mj_MdPreview_close {
    border-color: transparent;
    background: transparent;
    padding: var(--mj-space-1x);
}

.mj_MdPreview_body {
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    padding: var(--mj-space-4x) var(--mj-space-5x);
}

.mj_MdPreview_doc {
    color: var(--mj-color-text-primary);
    font: 400 16px/26px var(--mj-font-family-ui);
    overflow-wrap: anywhere;
}

.mj_MdPreview_doc h1 {
    font-size: 24px;
    line-height: 32px;
}

.mj_MdPreview_doc h2 {
    font-size: 20px;
    line-height: 28px;
}

.mj_MdPreview_doc h3 {
    font-size: 17px;
    line-height: 24px;
}

.mj_MdPreview_doc table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
}

.mj_MdPreview_source {
    margin: 0;
    color: var(--mj-color-text-primary);
    font: 13px/20px var(--mj-font-family-mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    user-select: text;
}

.mj_MdPreview_note {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
    margin-bottom: var(--mj-space-3x);
}

.mj_MdPreview_state {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--mj-space-3x);
}

.mj_MdPreview_stateActions {
    display: flex;
    gap: var(--mj-space-2x);
}

.mj_MdPreview_error {
    color: var(--mj-color-text-critical-primary);
}

/* An image in a previewed file never loads: it shows as its alt text. */
.mj_MdImageAlt {
    border-radius: var(--mj-radius-sm);
    background: var(--mj-color-bg-subtle-secondary);
    color: var(--mj-color-text-secondary);
    padding: 0 var(--mj-space-1x);
}

/* A relative or fragment link in a previewed file is plain text. */
.mj_MdLinkInert {
    color: inherit;
}

button.mj_TrackerAttachmentChip_preview,
button.mj_TrackerAttachmentChip_download {
    border: 1px solid var(--mj-color-border-interactive-secondary);
    cursor: pointer;
}

button.mj_TrackerAttachmentChip_download:disabled {
    cursor: progress;
}

.mj_TrackerAttachmentChip_icon {
    width: 14px;
    height: 14px;
    flex: none;
}

@media (max-width: 700px) {
    .mj_MdPreview {
        position: fixed;
        z-index: 40;
        inset: 0;
        width: 100%;
        min-width: 0;
        border-left: 0;
    }
}

/* Fork-only rules. */
.mj_EventSource_close:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

@media (max-width: 700px) {
    .mj_MediaViewer_scrim {
        padding: 0;
    }

    .mj_MediaViewer {
        width: 100vw;
        height: 100vh;
        border: 0;
        border-radius: 0;
    }

    .mj_MediaViewer_meta {
        display: none;
    }
}

/* ─── Files pane (Matron File Explorer, Phase 1b) ──────────────────────────────────────────────
   A new main-region pane in the established visual language. Left = breadcrumb + virtualized
   directory list; right = inline preview. Composes the existing --cpd tokens; no new palette. */
.mj_FilesPane {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    width: 100%;
    background: var(--mj-color-bg-chat-canvas, var(--mj-color-bg-canvas-default));
}

.mj_FilesPane_top {
    display: flex;
    align-items: center;
    gap: var(--mj-space-2x);
    box-sizing: border-box;
    height: 56px;
    padding: 0 var(--mj-space-4x);
    border-bottom: 1px solid var(--mj-color-border-subtle);
}

.mj_FilesPane_title {
    margin: 0;
    font: var(--mj-font-title);
    color: var(--mj-color-text-primary);
}

.mj_FilesPane_hidden {
    display: inline-flex;
    align-items: center;
    gap: var(--mj-space-1x);
    margin-left: auto;
    font: var(--mj-font-body-sm-regular);
    color: var(--mj-color-text-secondary);
    cursor: pointer;
    user-select: none;
}

.mj_FilesPane_hidden input {
    accent-color: var(--mj-color-bg-accent);
}

.mj_FilesPane_body {
    display: flex;
    flex: 1 1 0;
    min-height: 0;
}

.mj_FilesPane_nav {
    display: flex;
    flex-direction: column;
    min-height: 0;
    width: 340px;
    flex: 0 0 340px;
    border-right: 1px solid var(--mj-color-border-subtle);
}

.mj_FilesBreadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px var(--mj-space-1x);
    box-sizing: border-box;
    padding: var(--mj-space-2x) var(--mj-space-3x);
    border-bottom: 1px solid var(--mj-color-border-subtle);
    font: var(--mj-font-body-sm-regular);
}

.mj_FilesBreadcrumb_seg {
    border: 0;
    background: transparent;
    padding: 2px 4px;
    border-radius: var(--mj-radius-sm);
    color: var(--mj-color-text-action-accent);
    cursor: pointer;
    font: inherit;
}

.mj_FilesBreadcrumb_seg:hover:not(:disabled) {
    background: var(--mj-state-hover);
}

.mj_FilesBreadcrumb_seg:disabled {
    color: var(--mj-color-text-primary);
    cursor: default;
    font-weight: 600;
}

.mj_FilesBreadcrumb_seg:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset-field);
}

.mj_FilesBreadcrumb_sep {
    color: var(--mj-color-text-tertiary);
}

.mj_FilesPane_list {
    flex: 1 1 0;
    min-height: 0;
}

.mj_FilesList {
    height: 100%;
    scrollbar-color: var(--mj-scrollbar) transparent;
}

.mj_FilesList::-webkit-scrollbar {
    width: 10px;
}

.mj_FilesList::-webkit-scrollbar-thumb {
    background: var(--mj-scrollbar);
    border-radius: var(--mj-radius-pill);
    border: 3px solid transparent;
    background-clip: padding-box;
}

.mj_FilesRow {
    display: flex;
    /* Flexes inside .mj_FilesRow_shell; the shell carries react-window's absolute row box. */
    height: 100%;
    min-width: 0;
    flex: 1 1 auto;
    align-items: center;
    gap: var(--mj-space-2x);
    box-sizing: border-box;
    padding: 0 var(--mj-space-3x);
    border: 0;
    background: transparent;
    color: var(--mj-color-text-primary);
    text-align: left;
    cursor: pointer;
    font: var(--mj-font-body-sm-regular);
}

.mj_FilesRow:hover {
    background: var(--mj-state-hover);
}

.mj_FilesRow_selected {
    background: var(--mj-state-selected, var(--mj-color-bg-subtle-primary));
}

.mj_FilesRow:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset-inset);
}

.mj_FilesRow_icon {
    display: inline-flex;
    flex: 0 0 auto;
    color: var(--mj-color-icon-secondary);
}

.mj_FilesRow_dir .mj_FilesRow_icon {
    color: var(--mj-color-icon-accent-primary);
}

.mj_FilesRow_icon svg {
    width: var(--mj-icon-md, 18px);
    height: var(--mj-icon-md, 18px);
}

.mj_FilesRow_name {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_FilesRow_dir .mj_FilesRow_name {
    font-weight: 600;
}

.mj_FilesRow_size,
.mj_FilesRow_mtime {
    flex: 0 0 auto;
    color: var(--mj-color-text-tertiary);
    font: var(--mj-font-body-xs-regular);
    text-align: right;
}

.mj_FilesRow_size {
    min-width: 56px;
}

.mj_FilesRow_mtime {
    min-width: 68px;
}

.mj_FilesRow_chevron {
    flex: 0 0 auto;
    width: var(--mj-icon-sm, 16px);
    height: var(--mj-icon-sm, 16px);
    color: var(--mj-color-text-tertiary);
}

.mj_FilesPane_truncated {
    margin: 0;
    padding: var(--mj-space-2x) var(--mj-space-3x);
    border-top: 1px solid var(--mj-color-border-subtle);
    color: var(--mj-color-text-tertiary);
    font: var(--mj-font-body-xs-regular);
}

.mj_FilesPane_preview {
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    overflow: auto;
    padding: var(--mj-space-4x);
    scrollbar-color: var(--mj-scrollbar) transparent;
}

/* Preview status placeholders (loading / error / empty) */
.mj_FilesPreview_status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--mj-space-2x);
    height: 100%;
    min-height: 120px;
    padding: var(--mj-space-4x);
    text-align: center;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
}

.mj_FilesPreview_status_error {
    color: var(--mj-color-text-critical-primary);
}

.mj_FilesPreview_spinner {
    width: 16px;
    height: 16px;
    border: 2px solid var(--mj-color-border-interactive-secondary);
    border-top-color: var(--mj-color-icon-accent-primary);
    border-radius: 50%;
    animation: mj_FilesSpin 0.7s linear infinite;
}

@keyframes mj_FilesSpin {
    to {
        transform: rotate(360deg);
    }
}

/* Markdown / image / media previews */
.mj_FilesMarkdown {
    max-width: 78ch;
    margin: 0 auto;
}

.mj_FilesImage {
    display: flex;
    justify-content: center;
}

.mj_FilesImage img {
    max-width: 100%;
    height: auto;
    border-radius: var(--mj-radius-md);
}

/* PDF preview: a scrollable column of pdf.js-painted canvases (never a document/plugin embed). */
.mj_FilesPdf {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--mj-space-3x);
}

.mj_FilesPdf_pages {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--mj-space-3x);
    width: 100%;
}

.mj_FilesPdf_page {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-md);
    box-shadow: var(--mj-shadow-sm);
}

.mj_FilesMedia {
    display: flex;
    justify-content: center;
}

.mj_FilesMedia audio,
.mj_FilesMedia video {
    max-width: 100%;
}

/* Code preview — mirrors mj_CodeBlock so a file looks like a fenced block */
.mj_FilesCode {
    display: flex;
    flex-direction: column;
    min-height: 0;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-lg);
    background: var(--mj-color-bg-canvas-default);
    overflow: hidden;
}

.mj_FilesCode_header {
    display: flex;
    align-items: center;
    gap: var(--mj-space-2x);
    box-sizing: border-box;
    padding: 6px var(--mj-space-3x);
    border-bottom: 1px solid var(--mj-color-border-subtle);
    background: var(--mj-color-bg-canvas-raised);
}

.mj_FilesCode_lang {
    color: var(--mj-color-text-secondary);
    font: 400 11px/16px var(--mj-font-family-mono);
}

.mj_FilesCode_pre {
    margin: 0;
    overflow: auto;
    padding: var(--mj-space-3x);
    font: 400 13px/20px var(--mj-font-family-mono);
    scrollbar-color: var(--mj-scrollbar) transparent;
}

.mj_FilesCode_pre code {
    white-space: pre;
}

/* Generic (unpreviewable) file card + download affordance */
.mj_FilesGeneric {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--mj-space-2x);
    height: 100%;
    min-height: 160px;
    padding: var(--mj-space-5x);
    text-align: center;
}

.mj_FilesGeneric_icon {
    width: 48px;
    height: 48px;
    color: var(--mj-color-icon-secondary);
}

.mj_FilesGeneric_name {
    margin: 0;
    color: var(--mj-color-text-primary);
    font: var(--mj-font-body-sm-semibold);
    word-break: break-all;
}

.mj_FilesGeneric_note {
    margin: 0;
    color: var(--mj-color-text-tertiary);
    font: var(--mj-font-body-sm-regular);
}

.mj_FilesDownload {
    margin-top: 0;
}

.mj_FilesDownload {
    display: inline-flex;
    align-items: center;
    gap: var(--mj-space-1x);
    margin-top: var(--mj-space-2x);
    padding: var(--mj-space-2x) var(--mj-space-4x);
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-bg-accent);
    color: var(--mj-color-text-on-accent);
    cursor: pointer;
    font: var(--mj-font-body-sm-semibold);
}

.mj_FilesDownload:hover:not(:disabled) {
    background: var(--mj-color-bg-accent-emphasis);
}

.mj_FilesDownload:disabled {
    opacity: 0.6;
    cursor: default;
}

.mj_FilesDownload svg {
    width: var(--mj-icon-sm, 16px);
    height: var(--mj-icon-sm, 16px);
}

.mj_FilesDownload_error {
    margin: var(--mj-space-2x) 0 0;
    color: var(--mj-color-text-critical-primary);
    font: var(--mj-font-body-sm-regular);
}

/* Retry affordance on transient preview/list errors (timeout, network). */
.mj_FilesRetry {
    margin-top: var(--mj-space-2x);
    padding: var(--mj-space-1x) var(--mj-space-3x);
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-pill);
    background: transparent;
    color: var(--mj-color-text-action-accent);
    cursor: pointer;
    font: var(--mj-font-body-sm-semibold);
}

.mj_FilesRetry:hover {
    background: var(--mj-state-hover);
}

.mj_FilesRetry:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset-field);
}

/* ─── Files pane writes (Phase 2) ──────────────────────────────────────────────────────────────
   Every selector below only ever renders when the server reported the directory `writable`, so a
   dormant (writes-off) or dry-run deploy paints the unchanged Phase-1 pane. Same --cpd tokens, plus
   the authored --mj-critical-* destructive surface from shell.pcss. */

/* Row shell: the row button + its per-entry write actions as siblings. react-window's absolute
   row style lands on the shell, so the button stretches inside it. */
.mj_FilesRow_shell {
    display: flex;
    align-items: center;
    min-width: 0;
}

.mj_FilesRow_actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 2px;
    padding-right: var(--mj-space-2x);
}

/* Always visible (not hover-revealed): the primary client is a phone, which has no hover. */
.mj_FilesRow_action {
    display: inline-flex;
    width: 28px;
    height: var(--mj-control-h-sm);
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--mj-radius-sm);
    background: transparent;
    color: var(--mj-color-icon-tertiary);
    cursor: pointer;
}

.mj_FilesRow_action svg {
    width: var(--mj-icon-sm, 16px);
    height: var(--mj-icon-sm, 16px);
}

.mj_FilesRow_action:hover {
    background: var(--mj-state-hover);
    color: var(--mj-color-text-primary);
}

.mj_FilesRow_action_danger:hover {
    background: var(--mj-critical-tint);
    color: var(--mj-color-text-critical-primary);
}

.mj_FilesRow_action:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset-inset);
}

/* Directory-level actions, directly under the breadcrumb. */
.mj_FilesToolbar {
    display: flex;
    align-items: center;
    gap: var(--mj-space-2x);
    box-sizing: border-box;
    padding: var(--mj-space-2x) var(--mj-space-3x);
    border-bottom: 1px solid var(--mj-color-border-subtle);
}

.mj_FilesToolbar_button svg {
    color: var(--mj-color-icon-secondary);
}

/* The file picker is driven by the Upload button; it is never itself a visible control. */
.mj_FilesToolbar_file {
    display: none;
}

/* Outcome line for the last write (trash destination / already-gone / dry-run). */
.mj_FilesPane_notice {
    display: flex;
    align-items: flex-start;
    gap: var(--mj-space-2x);
    margin: 0;
    padding: var(--mj-space-2x) var(--mj-space-3x);
    border-top: 1px solid var(--mj-color-border-subtle);
    background: var(--mj-color-bg-subtle-primary);
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-xs-regular);
    overflow-wrap: anywhere;
}

.mj_FilesPane_noticeClose {
    display: inline-flex;
    flex: 0 0 auto;
    margin-left: auto;
    border: 0;
    background: transparent;
    color: var(--mj-color-icon-tertiary);
    cursor: pointer;
}

.mj_FilesPane_noticeClose svg {
    width: 14px;
    height: 14px;
}

/* ─── Preview header: file name + meta, and ONE action cluster (Edit · Copy · Download) ─────────
   Sticky to the top of the scrolling preview so Copy / Download stay reachable in a long file.
   The preview drops its top padding while a header is present, so the header's natural position
   IS the scrollport's top edge and `top: 0` holds in every engine (whether or not it deflates the
   sticky rectangle by the scroll container's padding). The side margins cancel the preview's
   horizontal padding so the bar spans edge to edge. */
.mj_FilesPane_preview:has(> .mj_FilesPreview_header) {
    padding-top: 0;
}

.mj_FilesPreview_header {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--mj-space-3x);
    margin: 0 calc(-1 * var(--mj-space-4x)) var(--mj-space-3x);
    padding: var(--mj-space-2x) var(--mj-space-4x);
    border-bottom: 1px solid var(--mj-color-border-subtle);
    background: var(--mj-color-bg-chat-canvas, var(--mj-color-bg-canvas-default));
}

.mj_FilesPreview_heading {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-width: 0;
}

.mj_FilesPreview_name {
    overflow: hidden;
    color: var(--mj-color-text-primary);
    font: var(--mj-font-body-sm-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_FilesPreview_meta {
    overflow: hidden;
    color: var(--mj-color-text-tertiary);
    font: var(--mj-font-body-xs-regular);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_FilesPreview_actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--mj-space-1x);
}

/* Equal-size icon buttons. Secondary = quiet outline; primary (Download) = filled accent. */
.mj_FilesAction {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--mj-control-h);
    height: var(--mj-control-h);
    padding: 0;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-md);
    background: transparent;
    color: var(--mj-color-icon-secondary);
    cursor: pointer;
    transition:
        background var(--mj-dur-fast) var(--mj-ease),
        color var(--mj-dur-fast) var(--mj-ease),
        border-color var(--mj-dur-fast) var(--mj-ease);
}

.mj_FilesAction svg {
    width: var(--mj-icon-md, 16px);
    height: var(--mj-icon-md, 16px);
}

.mj_FilesAction:hover:not(:disabled, [aria-disabled="true"]) {
    background: var(--mj-state-hover);
    color: var(--mj-color-text-primary);
}

.mj_FilesAction:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset-field);
}

.mj_FilesAction:disabled,
.mj_FilesAction[aria-disabled="true"] {
    opacity: 0.45;
    cursor: default;
}

.mj_FilesAction_done {
    border-color: var(--mj-color-text-action-accent);
    color: var(--mj-color-text-action-accent);
}

.mj_FilesAction_primary {
    border-color: var(--mj-color-bg-accent);
    background: var(--mj-color-bg-accent);
    color: var(--mj-color-text-on-accent);
}

.mj_FilesAction_primary:hover:not(:disabled) {
    border-color: var(--mj-color-bg-accent-emphasis);
    background: var(--mj-color-bg-accent-emphasis);
    color: var(--mj-color-text-on-accent);
}

/* Screen-reader-only live region for the "Copied" announcement. */
.mj_FilesPreview_live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
}

.mj_FilesPreview_actionError {
    margin: 0 0 var(--mj-space-3x);
    color: var(--mj-color-text-critical-primary);
    font: var(--mj-font-body-sm-regular);
    text-align: right;
}

/* ─── Write confirm dialog ─────────────────────────────────────────────────────────────────────
   Shares the shipped upload-confirm shell (.mj_UploadConfirm*); only the form fields, the target
   line, and the destructive treatment are new. */
.mj_FileWrite_body {
    display: flex;
    flex-direction: column;
    gap: var(--mj-space-3x);
    padding: 0 16px 14px;
}

.mj_FileWrite_field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.mj_FileWrite_label {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
}

.mj_FileWrite_textarea {
    min-height: 220px;
    max-height: 46vh;
    resize: vertical;
    font: var(--mj-font-mono);
}

/* Resolved absolute destination / character count — quiet, monospaced, never truncated silently. */
.mj_FileWrite_dest {
    color: var(--mj-color-text-tertiary);
    font: 400 12px/16px var(--mj-font-family-mono);
    overflow-wrap: anywhere;
}

.mj_FileWrite_dest_bad {
    color: var(--mj-color-text-critical-primary);
}

/* Delete target: the name in ink, the absolute path underneath so the blast radius is explicit. */
.mj_FileWrite_target {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
}

.mj_FileWrite_targetName {
    color: var(--mj-color-text-primary);
    font: var(--mj-font-title);
    overflow-wrap: anywhere;
}

.mj_FileWrite_targetPath {
    color: var(--mj-color-text-tertiary);
    font: 400 12px/16px var(--mj-font-family-mono);
    overflow-wrap: anywhere;
}

/* Recovery note — the ".matron-trash/ keeps it" reassurance on destructive confirms. Deliberately
   NEUTRAL, not critical-tinted: red is reserved for the act (title, target, button), and a red
   panel whose text says "it can still be recovered" sends two opposite signals at once. */
.mj_FileWrite_note {
    margin: 0;
    padding: var(--mj-space-2x) var(--mj-space-3x);
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-subtle-primary);
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
}

/* The payload-pinned retry explainer: why the fields went read-only after an attempt whose outcome
   we could not confirm. Reads as guidance, not as a second error. */
.mj_FileWrite_bound {
    margin: 0;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
}

.mj_FileWrite_actions {
    padding: 0 14px 14px;
}

/* Side by side, the list's breadcrumb bar and the preview's name bar share one height, so the two
   hairlines under them run as a single line across the split (they sat 12px apart). */
@media (min-width: 761px) {
    .mj_FilesBreadcrumb,
    .mj_FilesPreview_header {
        min-height: var(--mj-subbar-h);
        box-sizing: border-box;
    }
    .mj_FilesPreview_header {
        padding-top: 0;
        padding-bottom: 0;
    }
}

/* The back button only exists for the phone's pushed preview. */
.mj_FilesPane_back {
    display: none;
}

/* Phone (operator call T4): one screen at a time. The list is full height; tapping a file pushes
   its preview as its own screen, and the header's back button returns to the list. No empty
   "Select a file" half. */
@media (max-width: 760px) {
    .mj_FilesPane_body {
        flex-direction: column;
    }

    .mj_FilesPane_nav {
        width: 100%;
        flex: 1 1 0;
        border-right: 0;
    }

    .mj_FilesPane_body:not(.mj_FilesPane_body_previewing) > .mj_FilesPane_preview,
    .mj_FilesPane_body_previewing > .mj_FilesPane_nav {
        display: none;
    }

    .mj_FilesPane_back {
        display: inline-flex;
    }

    /* While previewing, back takes the leading slot; close stays reachable after the title. */
    .mj_FilesPane_top:has(.mj_FilesPane_back) .mj_FilesPane_close {
        order: 1;
    }
}

/* ===========================================================================================
   Redesign v6 — the turn card (docs/design/redesign-v6; was "Under the hood"). Show the work OFF renders one
   agent tile per operator turn: the card, then break-throughs, then a turn-ending error, then
   the answer prose. No height animation anywhere; the collapsed card is one row in every state.
   =========================================================================================== */

.mj_V6Icon {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
}

/* The agent tile's blocks share one constant gap (v5 §10). */
.mj_AgentTurn_blocks {
    display: flex;
    flex-direction: column;
    gap: var(--mj-space-2x);
    min-width: 0;
}

.mj_TurnBlock {
    min-width: 0;
}

.mj_TurnCard {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-lg);
    background: var(--mj-color-bg-canvas-raised);
}

.mj_TurnCard_row {
    position: relative;
}

.mj_TurnCard_toggle {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr) auto 13px;
    align-items: center;
    column-gap: var(--mj-space-2x);
    width: 100%;
    min-height: 36px;
    padding: 9px 12px;
    border: 0;
    background: transparent;
    color: var(--mj-color-text-primary);
    text-align: left;
    transition: background var(--mj-dur-fast) var(--mj-ease);
}

.mj_TurnCard_toggle:hover {
    background: var(--mj-state-hover);
}

.mj_TurnCard_toggle:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset-inset);
    border-radius: var(--mj-radius-lg);
}

.mj_TurnCard.is-open .mj_TurnCard_row {
    border-bottom: 1px solid var(--mj-color-border-subtle);
}

.mj_TurnCard_glyph {
    display: grid;
    width: 16px;
    height: 16px;
    place-items: center;
    color: var(--mj-color-icon-secondary);
}

.mj_TurnCard_glyph > * {
    grid-area: 1 / 1;
}

.mj_TurnCard_glyph .mj_V6Icon {
    width: 14px;
    height: 14px;
}

/* The spinner is excluded: this animation would otherwise replace its rotation. */
.mj_TurnCard.is-resolved .mj_TurnCard_glyph > :not(.mj_TurnCard_spinner),
.mj_TurnCard.is-resolved .mj_TurnCard_meta {
    animation: mj-v6-fade-in var(--mj-resolve) var(--mj-ease);
}

.mj_TurnCard_dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
}

.mj_TurnCard_dot_warn {
    background: var(--mj-warn-dot);
}

.mj_TurnCard_dot_wait {
    background: var(--mj-color-icon-accent-primary);
}

/* Running: a small rotating ring in place of the old pulsing dot (operator decision
   2026-09-26, HANDOFF §7a). Muted track, accent arc; amber arc once the step runs slow. */
.mj_TurnCard_spinner {
    display: inline-block;
    width: 12px;
    height: 12px;
    box-sizing: border-box;
    border: 2px solid var(--mj-color-border-strong);
    border-top-color: var(--mj-color-icon-accent-primary);
    border-radius: 50%;
    animation: mj-spin 0.8s linear infinite;
}

.mj_TurnCard_slow .mj_TurnCard_row .mj_TurnCard_spinner {
    border-top-color: var(--mj-warn-dot);
}

.mj_TurnCard_meta,
.mj_TurnCard_statusRegion,
.mj_TurnCard_metaVisible,
.mj_TurnCard_elapsedWrap {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: var(--mj-space-1x);
}

.mj_TurnCard_meta {
    font: var(--mj-font-meta);
    color: var(--mj-color-text-secondary);
}

.mj_TurnCard_sep,
.mj_TurnCard_elapsedWrap,
.mj_TurnCard_count_meta,
.mj_TurnCard_countLabel,
.mj_TurnCard_elapsedTotal,
.mj_TurnCard_stoppedLabel {
    flex: 0 0 auto;
    white-space: nowrap;
}

/* Outgoing and incoming live lines share one grid cell: opacity only, the row never grows. */
.mj_TurnCard_live {
    display: grid;
    min-width: 0;
    flex: 0 1 auto;
}

.mj_TurnCard_liveText {
    grid-area: 1 / 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_TurnCard_liveText_entering {
    animation: mj-v6-fade-in var(--mj-live-xfade) var(--mj-ease);
}

.mj_TurnCard_liveText_leaving {
    animation: mj-v6-fade-out var(--mj-live-xfade) var(--mj-ease) forwards;
}

.mj_TurnCard_elapsed {
    font-variant-numeric: tabular-nums;
}

.mj_TurnCard_waiting .mj_TurnCard_meta {
    color: var(--mj-color-text-action-accent);
}

.mj_TurnCard_slow .mj_TurnCard_meta {
    color: var(--mj-warn-ink);
}

.mj_TurnCard_stopSpace {
    visibility: hidden;
    font: var(--mj-font-label);
}

.mj_TurnCard_stopSpace:not(:empty) {
    padding: 0 var(--mj-space-2x);
}

.mj_TurnCard_stop {
    position: absolute;
    top: 50%;
    right: 29px;
    z-index: 1;
    transform: translateY(-50%);
    padding: 4px 8px;
    border: 0;
    border-radius: var(--mj-radius-sm);
    background: transparent;
    color: var(--mj-warn-ink);
    font: var(--mj-font-label);
}

.mj_TurnCard_stop:hover {
    background: var(--mj-warn-tint);
}

.mj_TurnCard_chevron {
    width: 13px;
    height: 13px;
    color: var(--mj-color-text-tertiary);
    transform: rotate(-90deg);
    transition: transform var(--mj-card-expand) var(--mj-ease);
}

.mj_TurnCard.is-open .mj_TurnCard_row .mj_TurnCard_chevron,
.mj_TurnCard_group.is-open > .mj_TurnCard_groupRow .mj_TurnCard_chevron {
    transform: rotate(0deg);
}

.mj_TurnCard_body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 6px 6px 8px;
    background: var(--mj-color-bg-canvas-default);
    animation: mj-v6-fade-in var(--mj-card-expand) var(--mj-ease);
}

.mj_TurnCard_label {
    padding: 6px 6px 4px;
    font: var(--mj-font-label-sm);
    color: var(--mj-color-text-secondary);
}

.mj_TurnCard_changed {
    display: flex;
    flex-direction: column;
    margin-bottom: 6px;
    padding: 2px 0 4px;
    border-bottom: 1px solid var(--mj-color-border-subtle);
}

.mj_TurnCard_file,
.mj_TurnCard_groupRow,
.mj_TurnCard_step {
    display: grid;
    width: 100%;
    align-items: center;
    column-gap: var(--mj-space-2x);
    border: 0;
    border-radius: var(--mj-radius-md);
    background: transparent;
    color: var(--mj-color-text-primary);
    text-align: left;
    transition: background var(--mj-dur-fast) var(--mj-ease);
}

.mj_TurnCard_file {
    grid-template-columns: 16px minmax(0, 1fr) auto 12px;
    padding: 6px;
    font: var(--mj-font-body-sm-regular);
}

.mj_TurnCard_file:hover,
.mj_TurnCard_groupRow:hover,
.mj_TurnCard_step:hover:not(:disabled) {
    background: var(--mj-state-hover);
}

.mj_TurnCard_file:focus-visible,
.mj_TurnCard_groupRow:focus-visible,
.mj_TurnCard_step:focus-visible,
.mj_TurnCard_back:focus-visible,
.mj_TurnCard_more:focus-visible,
.mj_TurnCard_stop:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset-inset);
}

.mj_TurnCard_name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_TurnCard_counts {
    display: flex;
    gap: 6px;
    font: var(--mj-font-label-sm);
    font-variant-numeric: tabular-nums;
}

.mj_TurnCard_add {
    color: var(--mj-color-icon-accent-primary);
}

.mj_TurnCard_del {
    color: var(--mj-color-text-critical-primary);
}

.mj_TurnCard_icon {
    display: grid;
    width: 16px;
    height: 16px;
    place-items: center;
    color: var(--mj-color-icon-secondary);
}

.mj_TurnCard_go {
    width: 12px;
    height: 12px;
    color: var(--mj-color-icon-tertiary);
}

.mj_TurnCard_narration {
    margin: 0;
    padding: 8px 6px 4px 30px;
    font: var(--mj-font-body);
    color: var(--mj-color-text-secondary);
    overflow-wrap: anywhere;
}

.markdown-body .mj_TurnCard_narration,
.mj_TurnCard_narration p {
    margin: 0;
}

.mj_TurnCard_group {
    display: flex;
    flex-direction: column;
}

.mj_TurnCard_groupRow {
    grid-template-columns: 16px minmax(0, 1fr) auto auto 13px;
    padding: 6px;
    font: var(--mj-font-body);
}

.mj_TurnCard_groupRow .mj_TurnCard_chevron {
    transition-duration: var(--mj-group-expand);
}

/* Group sentences are prose: they wrap, never ellipsize. */
.mj_TurnCard_sentence {
    min-width: 0;
    overflow-wrap: anywhere;
}

.mj_TurnCard_outcome {
    color: var(--mj-color-text-secondary);
}

/* Recovered outcome text is amber and never red; red is only for a group whose last step failed. */
.mj_TurnCard_group_recovered .mj_TurnCard_outcome,
.mj_TurnCard_group_stopped .mj_TurnCard_outcome {
    color: var(--mj-warn-ink);
}

.mj_TurnCard_group_failed .mj_TurnCard_outcome {
    color: var(--mj-color-text-critical-primary);
}

.mj_TurnCard_group_running .mj_TurnCard_sentence {
    color: var(--mj-color-text-secondary);
}

.mj_TurnCard_status {
    display: grid;
    width: 16px;
    height: 16px;
    place-items: center;
}

.mj_TurnCard_status .mj_V6Icon {
    width: 14px;
    height: 14px;
}

.mj_TurnCard_status_ok {
    color: var(--mj-color-usage-low);
}

.mj_TurnCard_status_failed {
    color: var(--mj-color-text-critical-primary);
}

.mj_TurnCard_count {
    min-width: 48px;
    font: var(--mj-font-meta);
    color: var(--mj-color-text-secondary);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
}

.mj_TurnCard_steps {
    display: flex;
    flex-direction: column;
    margin: 0 0 4px;
    padding: 0 0 0 24px;
    list-style: none;
}

.markdown-body .mj_TurnCard_steps {
    margin: 0 0 4px;
    padding-left: 24px;
}

.mj_TurnCard_steps > li {
    margin: 0;
}

.mj_TurnCard_virtualList {
    margin: 0 0 4px 24px;
}

.mj_TurnCard_step {
    grid-template-columns: minmax(0, 1fr) auto 12px;
    padding: 4px 6px;
    font: var(--mj-font-body-sm-regular);
    color: var(--mj-color-text-secondary);
}

.mj_TurnCard_step:disabled {
    cursor: default;
}

.mj_TurnCard_step:hover:not(:disabled),
.mj_TurnCard_step[aria-expanded="true"] {
    color: var(--mj-color-text-primary);
}

.mj_TurnCard_step[aria-expanded="true"] .mj_TurnCard_go,
.mj_TurnCard_file[aria-expanded="true"] .mj_TurnCard_go {
    transform: rotate(90deg);
}

.mj_TurnCard_stepNote {
    font: var(--mj-font-meta);
    color: var(--mj-color-text-secondary);
    white-space: nowrap;
}

.mj_TurnCard_stepNote_failed {
    color: var(--mj-warn-ink);
}

.mj_TurnCard_more {
    align-self: flex-start;
    margin: 2px 0;
    padding: 4px 6px;
    border: 0;
    border-radius: var(--mj-radius-sm);
    background: transparent;
    color: var(--mj-color-text-action-accent);
    font: var(--mj-font-label);
}

.mj_TurnCard_more:hover {
    background: var(--mj-state-hover);
}

.mj_TurnCard_now {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    align-items: center;
    column-gap: var(--mj-space-2x);
    padding: 6px;
    font: var(--mj-font-body);
    color: var(--mj-color-text-secondary);
}

.mj_TurnCard_now .mj_TurnCard_glyph {
    height: 21px;
}

/* Deep detail — the only level with monospace and exit codes. Opens in place, fades in. */
.mj_TurnCard_deep {
    overflow: hidden;
    margin: 4px 0 8px;
    border: 1px solid var(--mj-color-border-subtle);
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-canvas-default);
    animation: mj-v6-fade-in var(--mj-deep-open) var(--mj-ease);
}

.mj_TurnCard_changed .mj_TurnCard_deep {
    margin: 4px 0 6px 24px;
}

.mj_TurnCard_deepHead {
    display: flex;
    align-items: center;
    gap: var(--mj-space-2x);
    padding: 4px 6px 4px 4px;
    border-bottom: 1px solid var(--mj-color-border-subtle);
    background: var(--mj-color-bg-canvas-raised);
}

.mj_TurnCard_back {
    display: inline-flex;
    align-items: center;
    gap: var(--mj-space-1x);
    padding: 4px 8px 4px 4px;
    border: 0;
    border-radius: var(--mj-radius-sm);
    background: transparent;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-label);
}

.mj_TurnCard_back:hover {
    background: var(--mj-state-hover);
    color: var(--mj-color-text-primary);
}

.mj_TurnCard_back .mj_V6Icon {
    width: 14px;
    height: 14px;
}

.mj_TurnCard_deepMeta {
    margin-left: auto;
    font: var(--mj-font-meta);
    color: var(--mj-color-text-secondary);
    white-space: nowrap;
}

/* The panel owns the chrome; the reused cards drop their own border + radius (v5 §10.10). */
.mj_TurnCard_deep .mj_DiffCard,
.mj_TurnCard_deep .mj_ToolCard {
    border: 0;
    border-radius: 0;
}

/* The summary row already names the command; the deep panel shows its output directly. */
.mj_TurnCard_deep .mj_ToolCommand {
    display: none;
}

.mj_TurnCard_deep .mj_ToolCard + .mj_ToolCard {
    border-top: 1px solid var(--mj-color-border-subtle);
}

.mj_TurnCard_detailText {
    padding: var(--mj-space-3x);
}

/* Turn-ending error — breaks out of the card. */
.mj_TurnError {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    align-items: start;
    column-gap: var(--mj-space-2x);
    padding: 8px 12px;
    border: 1px solid var(--mj-critical-border);
    border-radius: var(--mj-radius-md);
    background: linear-gradient(var(--mj-critical-tint), var(--mj-critical-tint)), var(--mj-color-bg-canvas-default);
    color: var(--mj-color-text-critical-primary);
    font: var(--mj-font-body-sm-regular);
}

.mj_TurnError .mj_V6Icon {
    margin-top: 2px;
}

/* — Subtask line: a bridge "Subtask" message drawn as a card that opens its subagent — */
.mj_SubtaskCard {
    display: flex;
    width: 100%;
    max-width: 520px;
    align-items: center;
    gap: var(--mj-space-2x);
    box-sizing: border-box;
    border: 1px solid color-mix(in srgb, var(--mj-color-text-action-accent) 20%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--mj-color-text-action-accent) 8%, transparent);
    color: var(--mj-color-text-primary);
    cursor: pointer;
    padding: var(--mj-space-2x) var(--mj-space-3x);
    text-align: left;
}
.mj_SubtaskCard:hover {
    background: color-mix(in srgb, var(--mj-color-text-action-accent) 14%, transparent);
}
.mj_SubtaskCard_icon {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    color: var(--mj-color-text-action-accent);
}
.mj_SubtaskCard_text {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 2px;
}
.mj_SubtaskCard_title {
    display: -webkit-box;
    overflow: hidden;
    font: var(--mj-font-body-strong);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}
.mj_SubtaskCard_state {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-xs-regular);
}
.mj_SubtaskCard_done {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    color: var(--mj-color-text-success);
}
.mj_SubtaskCard_chevron {
    width: 14px;
    height: 14px;
    flex: 0 0 auto;
    color: var(--mj-color-icon-tertiary);
}

/* — The subagent pane beside its parent chat — */
.mj_SubChatPane {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    box-sizing: border-box;
    min-width: 0;
    height: 100%;
    min-height: 0;
    background: var(--mj-color-bg-chat-canvas, var(--mj-color-bg-canvas-default));
}
.mj_SubChatPane_resizer {
    border-left: 1px solid var(--mj-color-border-interactive-secondary);
}
/* The chat area is too narrow for both: the pane covers the chat (the chat stays mounted under it). */
.mj_SubChatPane_covering {
    position: fixed;
    z-index: 40;
    right: 0;
    width: auto;
}
.mj_SubChatPane_header {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--mj-space-2x);
    border-bottom: 1px solid var(--mj-color-border-subtle);
    padding: var(--mj-space-2x) var(--mj-space-3x);
}
.mj_SubChatPane_heading {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    flex-direction: column;
}
.mj_SubChatPane_title {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: var(--mj-space-2x);
    margin: 0;
    color: var(--mj-color-text-primary);
    font: var(--mj-font-body-strong);
}
.mj_SubChatPane_titleText {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.mj_SubChatPane_state {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-xs-regular);
}
.mj_SubChatPane_switch {
    max-width: 160px;
    flex: 0 1 auto;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-canvas-raised);
    color: var(--mj-color-text-primary);
    font: var(--mj-font-body-xs-regular);
    padding: 2px var(--mj-space-1x);
}
.mj_SubChatPane_close {
    flex: 0 0 auto;
}
.mj_SubChatPane_body {
    flex: 1 1 0;
    min-height: 0;
    overflow-y: auto;
    padding: var(--mj-space-3x) var(--mj-space-4x);
    scrollbar-color: var(--mj-scrollbar) transparent;
}
.mj_SubChatPane_list {
    display: flex;
    flex-direction: column;
    gap: var(--mj-space-3x);
    margin: 0;
    padding: 0;
    list-style: none;
}
.mj_SubChatPane_row {
    min-width: 0;
    overflow-wrap: anywhere;
}
.mj_SubChatPane_row[data-self="true"] {
    align-self: flex-end;
    max-width: 85%;
    border-radius: var(--mj-radius-bubble);
    background: var(--mj-color-bg-subtle-primary);
    padding: var(--mj-space-2x) var(--mj-space-3x);
}
.mj_SubChatPane_empty {
    margin: var(--mj-space-6x) 0;
    color: var(--mj-color-text-secondary);
    text-align: center;
}

/* — The conversation's Media / Files / Links browser — */
.mj_MediaBrowser_scrim {
    position: fixed;
    z-index: 50;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--mj-scrim-modal);
}
.mj_MediaBrowser {
    display: flex;
    width: min(640px, calc(100vw - 32px));
    height: min(520px, calc(100dvh - 32px));
    box-sizing: border-box;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--mj-radius-popover);
    background: var(--mj-color-bg-canvas-raised);
    box-shadow: var(--mj-shadow-lg);
    color: var(--mj-color-text-primary);
}
.mj_MediaBrowser_head {
    position: relative;
    display: flex;
    height: 52px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 0 var(--mj-space-4x);
}
.mj_MediaBrowser_tabs {
    display: inline-flex;
    gap: 2px;
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-subtle-primary);
    padding: 2px;
}
.mj_MediaBrowser_tab {
    min-width: 72px;
    border: 0;
    border-radius: calc(var(--mj-radius-md) - 2px);
    background: transparent;
    color: var(--mj-color-text-secondary);
    cursor: pointer;
    font: var(--mj-font-body-sm-regular);
    padding: 3px var(--mj-space-3x);
}
.mj_MediaBrowser_tab[aria-selected="true"] {
    background: var(--mj-color-bg-canvas-raised);
    box-shadow: 0 1px 2px rgb(0 0 0 / 12%);
    color: var(--mj-color-text-primary);
}
.mj_MediaBrowser_done {
    position: absolute;
    right: var(--mj-space-4x);
    border: 0;
    background: transparent;
    color: var(--mj-color-text-action-accent);
    cursor: pointer;
    font: 600 13px/17px var(--mj-font-family-ui);
}
.mj_MediaBrowser_body {
    flex: 1 1 0;
    min-height: 0;
    overflow-y: auto;
    border-top: 1px solid var(--mj-color-border-subtle);
}
.mj_MediaBrowser_grid {
    display: grid;
    gap: 2px;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
}
.mj_MediaBrowser_thumb {
    display: flex;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    border: 0;
    background: var(--mj-color-bg-subtle-secondary);
    color: var(--mj-color-icon-tertiary);
    cursor: pointer;
    padding: 0;
}
.mj_MediaBrowser_thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.mj_MediaBrowser_thumb svg {
    width: 24px;
    height: 24px;
}
.mj_MediaBrowser_thumb_expired {
    cursor: default;
}
.mj_MediaBrowser_list {
    margin: 0;
    padding: 0;
    list-style: none;
}
.mj_MediaBrowser_file {
    display: flex;
    align-items: center;
    gap: var(--mj-space-2x);
    border-bottom: 1px solid var(--mj-color-border-subtle);
    padding: var(--mj-space-2x) var(--mj-space-4x);
}
.mj_MediaBrowser_link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-bottom: 1px solid var(--mj-color-border-subtle);
    color: inherit;
    padding: var(--mj-space-2x) var(--mj-space-4x);
    text-decoration: none;
}
.mj_MediaBrowser_link:hover {
    background: var(--mj-state-hover);
}
.mj_MediaBrowser_linkUrl,
.mj_MediaBrowser_linkContext {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.mj_MediaBrowser_linkUrl {
    color: var(--mj-color-text-action-accent);
    font: var(--mj-font-body-sm-regular);
}
.mj_MediaBrowser_linkContext {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-xs-regular);
}
.mj_MediaBrowser_linkTime {
    color: var(--mj-color-text-tertiary);
    font: var(--mj-font-body-xs-regular);
}
.mj_MediaBrowser_empty,
.mj_MediaBrowser_loading {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--mj-space-2x);
    margin: 0;
    color: var(--mj-color-text-secondary);
}
.mj_MediaBrowser_empty svg {
    width: 32px;
    height: 32px;
    color: var(--mj-color-icon-tertiary);
}
.mj_MediaBrowser_empty p {
    margin: 0;
    font: var(--mj-font-body-strong);
}
.mj_SubChatPane_resizer:focus-visible {
    outline: none;
}
.mj_SubChatPane_resizer:focus-visible::after {
    background: var(--mj-color-text-action-accent);
}

/* Bridge notice about an injected turn (payload.notice): one secondary-text line — chevron,
   icon, summary, time — like the Coordinator notices; opening it shows the full text. */
.mj_SystemNotice {
    min-width: 0;
    max-width: 100%;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-body-sm-regular);
}

@keyframes mj-v6-fade-in {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

@keyframes mj-v6-fade-out {
    from {
        opacity: 1;
    }

    to {
        opacity: 0;
    }
}

@media (prefers-reduced-motion: reduce) {
    .mj_TurnCard_body,
    .mj_TurnCard_deep,
    .mj_TurnCard_liveText_entering,
    .mj_TurnCard_liveText_leaving,
    .mj_TurnCard.is-resolved .mj_TurnCard_glyph > :not(.mj_TurnCard_spinner),
    .mj_TurnCard.is-resolved .mj_TurnCard_meta {
        animation: none;
    }

    /* Reduced motion: the ring still turns, but slowly, so "working" stays legible. */
    .mj_TurnCard_spinner {
        animation-duration: 3s;
    }

    .mj_TurnCard_chevron {
        transition: none;
    }
}

/* ---- v6 + round 2: Settings menu (identity · connection · Theme · Developer view · Sign out) ---- */
.mj_HeaderMenu.mj_AccountMenu {
    width: min(272px, calc(100vw - var(--mj-space-4x)));
}

.mj_AccountMenu_who {
    display: grid;
    grid-template-columns: var(--mj-menu-icon) minmax(0, 1fr);
    gap: var(--mj-menu-icon-gap);
    margin-bottom: 4px;
    padding: 8px 8px 10px;
    border-bottom: 1px solid var(--mj-color-border-subtle);
}

.mj_AccountMenu_who > .mj_V6Icon {
    margin-top: 1px;
    color: var(--mj-color-icon-secondary);
}

.mj_AccountMenu_who b {
    display: block;
    overflow: hidden;
    color: var(--mj-color-text-primary);
    font: var(--mj-font-label);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_AccountMenu_who span {
    display: block;
    font: var(--mj-font-meta);
    white-space: nowrap;
}

.mj_AccountMenu .mj_AccountStatus {
    padding: 4px 8px;
    font: var(--mj-font-meta);
}

.mj_HeaderMenu .mj_MenuLabel {
    min-width: 0;
    overflow: hidden;
    color: inherit;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_ConversationMenu_item_switch,
.mj_ConversationMenu_item_value {
    grid-template-columns: var(--mj-menu-icon) minmax(0, 1fr) auto;
}

.mj_HeaderMenu .mj_MenuValue {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-meta);
}

.mj_ConversationMenu_item[aria-disabled="true"] {
    cursor: default;
}

.mj_ConversationMenu_item[aria-disabled="true"] .mj_MenuLabel {
    color: var(--mj-color-text-secondary);
}

.mj_MenuText {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
}

.mj_HeaderMenu .mj_MenuHint {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-micro);
    overflow-wrap: anywhere;
    white-space: normal;
}

/* Switch (.mj_Switch): 30×18 pill, thumb slides 12px. */
.mj_Switch {
    position: relative;
    display: inline-block;
    width: 30px;
    height: 18px;
    flex: none;
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-border-strong);
    transition: background var(--mj-dur-fast) var(--mj-ease);
}

.mj_Switch::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #fff;
    box-shadow: var(--mj-shadow-sm);
    transition: transform var(--mj-dur-fast) var(--mj-ease);
}

.mj_Switch.is-on {
    background: var(--mj-color-bg-accent);
}

.mj_Switch.is-on::after {
    transform: translateX(12px);
}

.mj_Switch.is-disabled {
    background: var(--mj-color-bg-subtle-secondary);
}

.mj_Switch.is-disabled::after {
    background: var(--mj-color-border-strong);
    box-shadow: none;
}

.mj_AccountMenu_scrim {
    display: none;
}

/* Phone: the same Settings content as a bottom sheet. */
@media (max-width: 700px) {
    .mj_AccountMenu_scrim {
        position: fixed;
        z-index: 999;
        inset: 0;
        display: block;
        background: var(--mj-scrim-modal);
    }

    .mj_HeaderMenu.mj_AccountMenu {
        position: fixed;
        top: auto;
        right: 0;
        bottom: 0;
        left: 0;
        width: 100%;
        max-height: 80vh;
        border-radius: var(--mj-radius-xl) var(--mj-radius-xl) 0 0;
        padding: 8px 8px calc(8px + env(safe-area-inset-bottom, 0px));
        box-shadow: var(--mj-shadow-lg);
    }

    .mj_AccountMenu .mj_MenuSeparator {
        margin-inline: -8px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .mj_Switch,
    .mj_Switch::after {
        transition: none;
    }
}

/* ---- v6 surface B: browser tools (session menu row, confirm dialog, header chip) ---- */
/* Only a row that actually shows a second (hint) line tops-aligns its icon to the first line; a
   one-line row centres like every other row, so the menu keeps one rhythm. */
.mj_ConversationMenu_item_hinted {
    align-items: start;
}

.mj_ConversationMenu_item_hinted > .mj_V6Icon {
    margin-top: 0;
}

.mj_HeaderChip {
    display: inline-flex;
    height: 24px;
    min-width: 0;
    flex: 0 1 auto;
    align-items: center;
    gap: 6px;
    overflow: hidden;
    padding: 0 10px;
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-bg-subtle-primary);
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-meta);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_ConfirmList {
    display: flex;
    flex-direction: column;
    gap: var(--mj-space-2x);
    margin: 0;
    padding: 0;
    list-style: none;
}

.mj_ConfirmList li {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    gap: var(--mj-space-2x);
    font: var(--mj-font-body);
}

.mj_ConfirmList .mj_V6Icon {
    margin-top: 2px;
    color: var(--mj-color-icon-secondary);
}

.mj_ConfirmBusy {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    gap: var(--mj-space-2x);
    padding: 10px 12px;
    border-radius: var(--mj-radius-md);
    background: var(--mj-color-bg-subtle-primary);
    font: var(--mj-font-body);
}

.mj_ConfirmBusy .mj_LiveDot {
    margin: 7px 0 0 4px;
}

.mj_ConfirmBusy b {
    font-weight: 600;
}

.mj_BrowserToolsConfirm .mj_UploadConfirm_body p {
    margin: 0;
    font: var(--mj-font-body);
}

/* ---- v6 surface C: one-tap New session — split button + options sheet ---- */
.mj_NewSessionSplit {
    display: flex;
    height: var(--mj-control-h);
    box-sizing: border-box;
    border: 1px solid var(--mj-accent-border);
    border-radius: var(--mj-radius-md);
    background: var(--mj-state-selected);
    color: var(--mj-color-text-action-accent);
    container-type: inline-size;
}

/* The v5 button becomes the main segment: the container owns border + fill. */
.mj_NewSessionSplit .mj_NewSessionButton.mj_NewSessionSplit_main {
    width: auto;
    height: auto;
    min-width: 0;
    flex: 1 1 auto;
    padding: 0 10px;
    border: 0;
    border-radius: calc(var(--mj-radius-md) - 1px) 0 0 calc(var(--mj-radius-md) - 1px);
    background: transparent;
    color: inherit;
}

.mj_NewSessionSplit_more {
    display: flex;
    width: var(--mj-control-h);
    flex: 0 0 var(--mj-control-h);
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 0 calc(var(--mj-radius-md) - 1px) calc(var(--mj-radius-md) - 1px) 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: background var(--mj-dur-fast) var(--mj-ease);
}

.mj_NewSessionSplit_main:hover:not(:disabled),
.mj_NewSessionSplit_more:hover:not(:disabled) {
    background: var(--mj-state-active);
}

.mj_NewSessionSplit_main:focus-visible,
.mj_NewSessionSplit_more:focus-visible {
    position: relative;
    z-index: 1;
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

.mj_NewSessionSplit button:disabled {
    cursor: default;
}

.mj_NewSessionSplit_sep {
    width: 1px;
    flex: none;
    margin: 7px 0;
    background: var(--mj-accent-border);
}

.mj_NewSessionSplit .mj_V6Icon {
    width: 15px;
    height: 15px;
}

.mj_NewSessionSplit_label {
    flex: none;
    white-space: nowrap;
}

/* The defaults hint is hidden below a 240px split, never truncated to "Opus · wo…"; between
   240 and 300px the pencil yields to it. */
.mj_NewSessionSplit_hint {
    display: none;
    min-width: 0;
    overflow: hidden;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-meta);
    text-overflow: ellipsis;
    white-space: nowrap;
}

@container (min-width: 240px) {
    .mj_NewSessionSplit_hint {
        display: block;
    }

    .mj_NewSessionSplit_main:has(.mj_NewSessionSplit_hint) > .mj_V6Icon {
        display: none;
    }
}

@container (min-width: 300px) {
    .mj_NewSessionSplit_main:has(.mj_NewSessionSplit_hint) > .mj_V6Icon {
        display: block;
    }
}

.mj_NewSessionSplit_disabled {
    border-color: var(--mj-color-border-subtle);
    background: var(--mj-color-bg-subtle-primary);
    color: var(--mj-color-text-secondary);
}

.mj_NewSessionSplit_disabled .mj_NewSessionSplit_sep {
    background: var(--mj-color-border-subtle);
}

.mj_NewSessionSplit_note {
    margin: 6px 2px 0;
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-meta);
    overflow-wrap: anywhere;
}

.mj_NewSessionSplit_note_error {
    color: var(--mj-color-text-critical-primary);
}

.mj_NewSessionSplit_note button {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--mj-color-text-action-accent);
    cursor: pointer;
    font: inherit;
    font-weight: 500;
}

.mj_NewSessionSplit_note button:hover {
    text-decoration: underline;
}

.mj_NewSessionSheet .mj_UploadConfirm_body {
    gap: var(--mj-space-4x);
}

.mj_NewSessionSheet .mj_UploadConfirm_body > p {
    margin: 0;
}

.mj_Field {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 6px;
}

.mj_FieldLabel {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-label-sm);
}

.mj_FieldHint {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-meta);
}

.mj_FieldError {
    margin: 0;
    color: var(--mj-color-text-critical-primary);
    font: var(--mj-font-meta);
}

.mj_FolderList {
    display: flex;
    max-height: 196px;
    flex-direction: column;
    overflow-y: auto;
    padding: 4px;
    border: 1px solid var(--mj-color-border-interactive-secondary);
    border-radius: var(--mj-radius-md);
}

.mj_FolderOption {
    display: grid;
    width: 100%;
    grid-template-columns: 16px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--mj-space-2x);
    padding: 6px 8px;
    border: 0;
    border-radius: var(--mj-radius-sm);
    background: transparent;
    color: var(--mj-color-text-primary);
    cursor: pointer;
    font: var(--mj-font-body-sm-regular);
    text-align: left;
}

.mj_FolderOption:hover {
    background: var(--mj-state-hover);
}

.mj_FolderOption:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset-inset);
}

.mj_FolderOption[aria-checked="true"] {
    background: var(--mj-state-selected);
}

.mj_FolderOption_path {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_Radio {
    display: grid;
    width: 14px;
    height: 14px;
    box-sizing: border-box;
    place-items: center;
    border: 1.5px solid var(--mj-color-border-interactive-primary);
    border-radius: 50%;
}

[aria-checked="true"] > .mj_Radio {
    border-color: var(--mj-color-bg-accent);
}

[aria-checked="true"] > .mj_Radio::after {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mj-color-bg-accent);
}

.mj_Tag {
    padding: 1px 8px;
    border-radius: var(--mj-radius-pill);
    background: var(--mj-color-bg-subtle-secondary);
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-micro);
}

.mj_SwitchRow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 4px 12px;
}

.mj_SwitchRow .mj_FieldHint {
    grid-column: 1 / -1;
}

.mj_SwitchLabel {
    color: var(--mj-color-text-primary);
    font: var(--mj-font-label);
}

button.mj_SwitchButton {
    display: inline-flex;
    align-items: center;
    padding: 0;
    border: 0;
    border-radius: var(--mj-radius-pill);
    background: transparent;
    cursor: pointer;
}

button.mj_SwitchButton:disabled {
    cursor: default;
}

button.mj_SwitchButton:focus-visible {
    outline: var(--mj-focus-ring);
    outline-offset: var(--mj-focus-offset);
}

.mj_CheckRow {
    display: flex;
    align-items: center;
    gap: var(--mj-space-2x);
    color: var(--mj-color-text-primary);
    cursor: pointer;
    font: var(--mj-font-body-sm-regular);
}

.mj_CheckRow input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--mj-color-bg-accent);
}

.mj_BoxCaption {
    color: var(--mj-color-text-secondary);
    font: var(--mj-font-meta);
}

/* Box usage under the chosen box in the New session sheet: the box's last capacity report —
   limits with reset times, live sessions, disk — and an "as of" caption saying how old the
   numbers are (ported from upstream's sheet onto the v6 sheet). */
.mj_NewSessionSheet_usage {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 4px;
    color: var(--mj-color-text-secondary);
    font: 400 12px/16px var(--mj-font-family-ui);
}

.mj_NewSessionSheet_usageLine {
    display: block;
}

.mj_NewSessionSheet_usageAsOf {
    display: block;
    color: var(--mj-color-text-tertiary);
}

/* ---- v6 chat-pane breakpoints (data-pane on .mj_ChatView_body, set by a ResizeObserver).
   Order of sacrifice at narrow (GENERATIVE-SYSTEM §3): card row drops the total duration;
   group rows drop the count column, then the step indent shrinks 24 → 12; the deep panel
   pulls out to the card edge. Glyph, the live line / step summary, chevron and Stop are never
   dropped (there is no title since 2026-09-26). ---- */
[data-pane="narrow"] .mj_TurnCard_count,
[data-pane="narrow"] .mj_TurnCard_elapsedTotal {
    display: none;
}

[data-pane="narrow"] .mj_TurnCard_groupRow {
    grid-template-columns: 16px minmax(0, 1fr) auto 13px;
}

[data-pane="narrow"] .mj_TurnCard_steps,
[data-pane="narrow"] .markdown-body .mj_TurnCard_steps {
    padding-left: 12px;
}

[data-pane="narrow"] .mj_TurnCard_virtualList {
    margin-left: 12px;
}

[data-pane="narrow"] .mj_TurnCard_narration {
    padding-left: 18px;
}

[data-pane="narrow"] .mj_TurnCard_changed .mj_TurnCard_deep {
    margin-left: 0;
}

[data-pane="narrow"] .mj_TurnCard_steps .mj_TurnCard_deep {
    margin-left: -12px;
}

/* Very tight panes: the stopped-state count and the done duration go too; the live line keeps
   what is left. The done-state step count stays: it is the row's only label. */
@container (max-width: 340px) {
    .mj_TurnCard_count_meta,
    .mj_TurnCard_elapsedTotal {
        display: none;
    }
}

.mj_TurnCard {
    container-type: inline-size;
}

.mj_SystemNotice summary {
    display: flex;
    align-items: center;
    gap: var(--mj-space-1x);
    padding: 2px 0;
    cursor: pointer;
    list-style: none;
}

.mj_SystemNotice summary::-webkit-details-marker {
    display: none;
}

.mj_SystemNotice summary:hover .mj_SystemNotice_summary {
    color: var(--mj-color-text-primary);
}

.mj_SystemNotice_chevron {
    width: 12px;
    height: 12px;
    flex: 0 0 auto;
    color: var(--mj-color-text-tertiary);
    transform: rotate(-90deg);
    transition: transform var(--mj-dur-fast) var(--mj-ease);
}

.mj_SystemNotice[open] .mj_SystemNotice_chevron {
    transform: rotate(0deg);
}

.mj_SystemNotice_icon {
    flex: none;
    font-size: 14px;
}

.mj_SystemNotice_summary {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mj_SystemNotice_time {
    flex: none;
    margin-left: auto;
    padding-left: var(--mj-space-1x);
    color: var(--mj-color-text-tertiary);
    font: var(--mj-font-body-xs-regular);
}

.mj_SystemNotice_body {
    margin: var(--mj-space-1x) 0 var(--mj-space-1x) 18px;
    padding-left: var(--mj-space-1x);
    border-left: 2px solid var(--mj-color-border-subtle);
    color: var(--mj-color-text-primary);
}

/* The full text keeps the bridge's line breaks (each agent-facing line on its own). */
.mj_SystemNotice_body p {
    white-space: pre-line;
}

/* A notice row sits tight against its neighbours, so a run of them reads as a list. */
li.mj_EventTile[data-layout="bubble"].mj_EventTile_systemNotice {
    margin-top: 2px;
    margin-bottom: 2px;
}
.mj_EventTile_systemNotice[data-self="false"] .mj_EventTile_line {
    padding: 0;
}
