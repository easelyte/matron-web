{
    "name": "matron-web",
    "version": "1.12.11-rc.0",
    "description": "A lightweight browser client for chatting with agents",
    "author": "Matron Contributors",
    "repository": {
        "type": "git",
        "url": "https://github.com/Matronhq/matron-web"
    },
    "license": "AGPL-3.0-only OR GPL-3.0-only",
    "type": "module",
    "scripts": {
        "build": "rimraf webapp && webpack --config webpack.config.mjs --mode production",
        "start": "webpack serve --config webpack.config.mjs --mode development",
        "lint": "pnpm lint:types && prettier --check src test webpack.config.mjs jest.config.cjs babel.config.cjs",
        "lint:fix": "prettier --write src test webpack.config.mjs jest.config.cjs babel.config.cjs",
        "lint:types": "tsc --noEmit",
        "test": "jest --runInBand",
        "coverage": "jest --runInBand --coverage",
        "build:fixtures": "webpack --config webpack.fixtures.mjs --mode production"
    },
    "dependencies": {
        "@fontsource/fira-code": "^5.3.0",
        "@fontsource/inter": "^5.3.0",
        "hast-util-to-string": "^3.0.1",
        "highlight.js": "~11.11.2",
        "pdfjs-dist": "^6.2.108",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-markdown": "^9.1.0",
        "rehype-highlight": "^7.0.2",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "unified": "^11.0.5"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@babel/preset-typescript": "^7.29.7",
        "@playwright/test": "^1.62.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.20.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "babel-jest": "^30.4.1",
        "babel-loader": "^10.1.1",
        "copy-webpack-plugin": "^13.0.1",
        "css-loader": "^7.1.4",
        "dotenv": "^17.4.2",
        "fake-indexeddb": "^6.2.5",
        "html-webpack-plugin": "^5.6.8",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "mini-css-extract-plugin": "^2.10.2",
        "odiff-bin": "^4.5.0",
        "postcss": "^8.5.26",
        "postcss-loader": "^8.2.1",
        "postcss-preset-env": "^11.4.0",
        "prettier": "^3.9.6",
        "rimraf": "^6.1.3",
        "sharp": "^0.35.3",
        "typescript": "^5.9.3",
        "webpack": "^5.109.2",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.6"
    },
    "pnpm": {
        "overrides": {
            "serialize-javascript@<7.0.5": "^7.0.5",
            "uuid@<11.1.1": "^11.1.1"
        }
    },
    "engines": {
        "node": ">=22.18"
    },
    "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc",
    "private": true
}
