{
  "$schema": "matron-static-states/1",
  "generated": "2026-07-26T09:20Z",
  "source": "Matron Redesign.dc.html",
  "how": "Runtime-free flatten of the Design Component: conditionals resolved per state, holes substituted, handlers stripped. Inline styles only and self-hosted fonts — probe-faithful AND screenshot-faithful offline.",
  "granularity": "data-spec is tagged on the same element component-map.json's selector resolves to; multi-rung components (composer footer/shell/input, modal scrim/card, row/badge) each get their own pair.",
  "round2": "8 new states cover the four round-2 surfaces: light/dark-new-session(-filled), light/dark-actions-menu, light/dark-round2 (all four surfaces on one grid). The prompt card's un-answered and answered states and the upload single-file card live in *-round2; multi-file upload is light-upload-first / -last.",
  "conventions": {
    "data-spec": "canonical component/state name; component-map.json maps each to its src/journal selector plus status + visual alignment",
    "data-target": "the existing selector a state-matrix specimen implements",
    "data-style-hover|active|focus": "designed pseudo-state declarations as CSS text (not live in static files)",
    "meta[name=matron-state-note]": "what the file shows",
    "devtool.*": "handoff affordance only — do NOT implement"
  },
  "assets": {
    "fonts/": "InterVariable.woff2 (rsms/inter, OFL) + FiraCode[wght].ttf (google/fonts, OFL, licence alongside)",
    "res/matron-logo-simple.svg": "brand mark + agent avatar; referenced 3× per state file",
    "note": "static/ is self-contained — every referenced asset lives under static/. Keep it that way when regenerating."
  },
