    "--mj-live-xfade": {
      "value": "240ms",
      "status": "new",
      "intent": "live line: outgoing and incoming text cross-fade (opacity only)"
    },
    "--mj-live-min-interval": {
      "value": "1200ms",
      "status": "new",
      "intent": "live line changes at most once per interval; newer text replaces a queued one"
    },
    "--mj-live-elapsed-after": {
      "value": "10s",
      "status": "new",
      "intent": "elapsed \"· 42s\" appears once the current step passes this"
    },
    "--mj-slow-after": {
      "value": "300s",
      "status": "new",
      "intent": "a step at or past this turns the line amber and shows Stop"
    },
    "--mj-card-expand": {
      "value": "var(--cpd-dur-fast)",
      "status": "new",
      "intent": "chevron rotates; body fades in, height is NOT animated"
    },
    "--mj-group-expand": {
      "value": "var(--cpd-dur-fast)",
      "status": "new",
      "intent": "group chevron rotates; step list appears, no height animation"
    },
    "--mj-deep-open": {
      "value": "var(--cpd-dur-med)",
      "status": "new",
      "intent": "deep panel fades in place; closing is instant"
    },
    "--mj-resolve": {
      "value": "var(--cpd-dur-med)",
      "status": "new",
      "intent": "running→done: glyph and meta cross-fade in the same box, no size change"
    },
    "$choreography": {
      "liveLineCrossfade": {
        "property": "opacity",
        "duration": "var(--mj-live-xfade)",
        "easing": "var(--cpd-ease)",
        "minInterval": "var(--mj-live-min-interval)",
        "rule": "outgoing + incoming text stacked in one grid cell; a newer text replaces a queued one; height never changes"
      },
      "cardExpand": {
        "chevron": "rotate(-90deg → 0) over var(--mj-card-expand)",
        "body": "opacity 0→1 over var(--mj-card-expand)",
        "height": "not animated"
      },
      "groupExpand": {
        "chevron": "rotate over var(--mj-group-expand)",
        "list": "appears immediately",
        "height": "not animated"
      },
      "deepDetail": {
        "open": "opacity 0→1 over var(--mj-deep-open)",
        "close": "instant"
      },
      "runningToDone": {
        "glyph": "live dot → check or amber dot, fade over var(--mj-resolve)",
        "meta": "live line → 'N steps · duration' in the same box, fade over var(--mj-resolve)",
        "size": "unchanged — the summary is one row in every state"
      },
      "reducedMotion": "pulse/spin stop; every fade becomes instant"
    }
  },
